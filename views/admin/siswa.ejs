<!DOCTYPE html>
<html lang="id">
<head>
    <title>Data Siswa</title>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/admin-siswa.css">
    <style>
        .alert-isi { flex: 1; min-width: 0; }
        .rincian-pesan { margin-top: 8px; }
        .rincian-pesan summary {
            cursor: pointer;
            font-weight: 600;
            font-size: 13px;
            user-select: none;
        }
        .rincian-pesan ul {
            margin: 8px 0 0;
            padding-left: 20px;
            max-height: 240px;
            overflow-y: auto;
            font-size: 13px;
            line-height: 1.5;
        }
        .rincian-pesan li { margin-bottom: 4px; word-break: break-word; }

        /* Tutorial makin panjang: beri ruang agar tidak terpotong. */
        #tutorialSiswa.show { max-height: 1500px; }

        /* Tombol hapus massal (header) */
        .btn-hapus-massal {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #fdecea;
            color: #b3261e;
            border: 1px solid #f5c2bd;
            padding: 11px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            font-family: inherit;
        }
        .btn-hapus-massal:hover:not(:disabled) { background: #fbd9d5; }
        .btn-hapus-massal:disabled { opacity: .5; cursor: not-allowed; }

        /* Tombol hapus di bar aksi massal */
        .btn-massal-hapus {
            background: #b3261e;
            color: #fff;
            border: 1px solid #b3261e;
        }
        .btn-massal-hapus:hover { background: #8f1d17; }

        /* ===== Bar pemberitahuan di bagian bawah layar (footer) ===== */
        .notif-footer {
            position: fixed;
            left: 50%;
            bottom: 0;
            transform: translate(-50%, 110%);
            z-index: 3000;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            width: calc(100% - 32px);
            max-width: 720px;
            padding: 14px 16px;
            border-radius: 12px 12px 0 0;
            background: #fdf1de;
            color: #8a4b00;
            border: 1px solid #f3d9a4;
            border-bottom: none;
            box-shadow: 0 -6px 24px rgba(15, 23, 42, .18);
            font-size: 14px;
            line-height: 1.5;
            opacity: 0;
            pointer-events: none;
            transition: transform .3s ease, opacity .3s ease;
        }
        .notif-footer.tampil {
            transform: translate(-50%, 0);
            opacity: 1;
            pointer-events: auto;
        }
        .notif-footer.error {
            background: #fdecea;
            color: #b3261e;
            border-color: #f5c2bd;
        }
        .notif-footer .notif-ikon { font-size: 18px; flex-shrink: 0; margin-top: 1px; }
        .notif-footer .notif-teks { flex: 1; min-width: 0; word-break: break-word; }
        .notif-footer .notif-tutup {
            background: none;
            border: none;
            font-size: 22px;
            line-height: 1;
            color: inherit;
            opacity: .6;
            cursor: pointer;
            padding: 0 4px;
            flex-shrink: 0;
        }
        .notif-footer .notif-tutup:hover { opacity: 1; }
    </style>
</head>

<body>
<%
    const R = (typeof ringkasan !== 'undefined' && ringkasan)
        ? ringkasan
        : { total: Array.isArray(siswaList) ? siswaList.length : 0, tanpaAkun: 0, aktif: 0, nonaktif: 0, berminat: 0, tidakBerminat: 0, belumKonfirmasi: 0 };

    const filterAwalVal = (typeof filterAwal !== 'undefined' && filterAwal) ? filterAwal : '';
    const daftarSiswa = Array.isArray(siswaList) ? siswaList : [];
    const adaKartu = (Number(R.aktif) + Number(R.nonaktif)) > 0;
    const sudahTerkunci = typeof terkunci !== 'undefined' && Boolean(terkunci);

    // Bobot FUCOM final dan konsisten?
    const bobotOk = (typeof bobotFinal !== 'undefined') ? Boolean(bobotFinal) : false;

    // SELURUH tombol di halaman Data Siswa mati jika bobot FUCOM belum final.
    const blokirSiswa = !sudahTerkunci && !bobotOk;
    const alasanBlokirSiswa = 'Nonaktif: pembobotan FUCOM belum selesai atau belum konsisten';

    // Tombol input nilai TIDAK berhubungan dengan FUCOM.
    // Aktif jika sudah ada data siswa DAN tidak ada lagi siswa yang belum merespons.
    const jumlahSiswaTotal = Number(R.total || daftarSiswa.length || 0);
    const adaSiswa = jumlahSiswaTotal > 0 || daftarSiswa.length > 0;
    const adaBelumRespon = Number(R.belumKonfirmasi || 0) > 0;
    const blokirNilai = !sudahTerkunci && (!adaSiswa || adaBelumRespon);
    const alasanBlokirNilai = !adaSiswa
        ? 'Nonaktif: belum ada data siswa'
        : 'Nonaktif: masih ada siswa yang belum merespons';

    // Checkbox muncul untuk SEMUA siswa jika data belum final dan bobot FUCOM sudah final.
    // Dipakai untuk hapus massal dan (khusus yang memenuhi syarat) konfirmasi minat massal.
    const bisaCentang = !sudahTerkunci && !blokirSiswa && daftarSiswa.length > 0;

    // Ada minimal satu siswa yang bisa diubah status minatnya (punya akun + belum merespons)?
    // Tombol Konfirmasi Berminat/Tidak Berminat hanya ditampilkan jika ada.
    const adaYangBisaDicentang = !sudahTerkunci && !blokirSiswa && daftarSiswa.some(function(x) {
        return Boolean(x.punya_akun) && (x.status_minat || 'belum_respon') === 'belum_respon';
    });

    // Pesan panjang (hasil import) dipecah jadi ringkasan singkat + rincian yang bisa dibuka.
    const POLA_BARIS = /Baris (?:\d+|\?) [-(]/;

    function pecahPesan(pesan) {
        const teks = String(pesan || '').trim();
        const hasil = { teks: teks, ringkasan: teks, rincian: [] };

        if (!teks || !POLA_BARIS.test(teks)) return hasil;

        const bagianRingkasan = [];
        const bagianRincian = [];

        teks.split(' || ').forEach(function(item) {
            const idx = item.search(POLA_BARIS);

            if (idx === -1) {
                if (item.trim()) bagianRincian.push(item.trim());
                return;
            }

            let awal = item.slice(0, idx).trim();

            if (awal) {
                const sisa = awal.match(/^(dan \d+ baris lainnya)\s*/);
                if (sisa) {
                    bagianRincian.push(sisa[1]);
                    awal = awal.slice(sisa[0].length).trim();
                }
                awal = awal.replace(/[:\s]+$/, '').replace(/\.+$/, '');
                if (awal) bagianRingkasan.push(awal);
            }

            bagianRincian.push(item.slice(idx).trim());
        });

        if (bagianRincian.length === 0) return hasil;

        hasil.ringkasan = bagianRingkasan.map(function(b) { return b.replace(/\.+$/, ''); }).join('. ') + '.';
        hasil.rincian = bagianRincian;
        return hasil;
    }

    const pesanSukses = pecahPesan((typeof success !== 'undefined' && success) ? success : '');
    const pesanError = pecahPesan((typeof error !== 'undefined' && error) ? error : '');
%>

<div class="app-layout">
    <%- include('../partials/sidebar', { user: user, activePage: activePage }) %>

    <div class="main-content">
        <%- include('../partials/topbar', { user: user, pageTitle: pageTitle }) %>

        <div class="content-wrapper">

            <!-- Panduan -->
            <div class="panel" style="background:#f4f8ff;">
                <div class="panel-header-row" style="cursor:pointer;" onclick="document.getElementById('tutorialSiswa').classList.toggle('show')">
                    <div class="panel-header">
                        <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-question-circle-fill"></i></div>
                        <h3>Cara Mengelola Data Siswa &amp; Akun</h3>
                    </div>
                    <i class="bi bi-chevron-down"></i>
                </div>

                <div id="tutorialSiswa" class="tutorial-content">
                    <ol class="info-alur" style="padding-left:20px;">
                        <li><strong>Selesaikan pembobotan FUCOM</strong> (hasil konsisten) lebih dulu. Selama belum selesai, <strong>seluruh tombol</strong> di halaman Data Siswa nonaktif.</li>
                        <li>Unduh template, isi data siswa, lalu <strong>Import Excel</strong> atau gunakan <strong>Tambah Siswa</strong>.</li>
                        <li>
                            Aturan data: <strong>NISN</strong> harus 10 digit angka dan tidak boleh sama dengan siswa lain.
                            <strong>Sekolah asal</strong> hanya boleh SMP, MTs, SMPLB, atau Paket B (data SMA/SMK/MA ditolak).
                            <strong>Pekerjaan ayah/ibu</strong> boleh dikosongkan, otomatis tersimpan sebagai "Tidak bekerja".
                        </li>
                        <li>Klik <strong>Buat Akun Siswa</strong> satu kali, akun dibuat untuk semua siswa yang belum punya akun.</li>
                        <li>Cetak kartu (semua atau per siswa) lalu bagikan kepada siswa melalui saluran yang aman. <strong>Kartu hanya bisa dicetak sebelum hasil difinalisasi.</strong></li>
                        <li>Siswa login, mengganti password awal, lalu menjawab minat dan 3 pertanyaan sendiri.</li>
                        <li>
                            Siswa yang masih <strong>Belum merespons</strong> dapat diubah statusnya oleh operator
                            menjadi <strong>Berminat</strong> atau <strong>Tidak berminat</strong> lewat tombol di kolom Status Minat.
                            Status yang sudah Berminat atau Tidak berminat tidak dapat diubah lagi.
                        </li>
                        <li>
                            Untuk banyak siswa sekaligus, <strong>centang</strong> siswa yang "Belum merespons"
                            (atau centang kotak di header tabel untuk memilih semua yang tampil), lalu klik
                            <strong>Konfirmasi Berminat</strong> atau <strong>Konfirmasi Tidak Berminat</strong>.
                            Siswa yang dikonfirmasi "Tidak berminat" tidak ikut perankingan dan akunnya dinonaktifkan.
                            Gunakan filter "Belum merespons" agar pilihan lebih mudah.
                        </li>
                        <li>
                            Untuk <strong>menghapus banyak siswa sekaligus</strong>, centang siswa yang dimaksud
                            (atau centang kotak di header tabel untuk memilih semua yang tampil), lalu klik <strong>Hapus Terpilih</strong>.
                            Akan muncul konfirmasi. Penghapusan bersifat <strong>permanen</strong> (data siswa, akun, dan nilainya ikut terhapus)
                            dan <strong>tidak bisa dilakukan lagi setelah hasil difinalisasi</strong>.
                        </li>
                        <li>
                            Pengisian nilai oleh operator (Input/Edit Nilai dan Import Nilai) <strong>tidak berkaitan dengan FUCOM</strong>.
                            Tombolnya baru aktif setelah <strong>data siswa sudah ada</strong> dan <strong>tidak ada lagi siswa yang Belum merespons</strong>.
                        </li>
                        <li>Nilai dapat diubah selama hasil belum difinalisasi. Setiap perubahan mengosongkan hasil ranking dan perlu dihitung ulang.</li>
                        <li>Setelah finalisasi, seluruh data terkunci, kartu tidak bisa dicetak lagi, dan siswa hanya melihat pengumuman hasil seleksi.</li>
                        <li>Akun siswa dinonaktifkan otomatis ketika periode seleksinya ditutup (misalnya saat periode baru dibuat).</li>
                    </ol>
                </div>
            </div>

            <% if (pesanSukses.teks) { %>
                <div class="alert alert-success">
                    <i class="bi bi-check-circle-fill"></i>
                    <div class="alert-isi">
                        <%= pesanSukses.ringkasan %>
                        <% if (pesanSukses.rincian.length > 0) { %>
                            <details class="rincian-pesan">
                                <summary>Lihat rincian</summary>
                                <ul>
                                    <% pesanSukses.rincian.forEach(function(r) { %>
                                        <li><%= r %></li>
                                    <% }) %>
                                </ul>
                            </details>
                        <% } %>
                    </div>
                </div>
            <% } %>

            <% if (pesanError.teks) { %>
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <div class="alert-isi">
                        <%= pesanError.ringkasan %>
                        <% if (pesanError.rincian.length > 0) { %>
                            <details class="rincian-pesan">
                                <summary>Lihat rincian</summary>
                                <ul>
                                    <% pesanError.rincian.forEach(function(r) { %>
                                        <li><%= r %></li>
                                    <% }) %>
                                </ul>
                            </details>
                        <% } %>
                    </div>
                </div>
            <% } %>

            <!-- Flash pembuatan akun -->
            <% if (typeof akunSiswaFlash !== 'undefined' && akunSiswaFlash) { %>
                <div class="alert <%= akunSiswaFlash.tipe === 'error' ? 'alert-danger' : 'alert-success' %>">
                    <% if (akunSiswaFlash.tipe === 'error') { %>
                        <i class="bi bi-exclamation-circle-fill"></i> <%= akunSiswaFlash.pesan %>
                    <% } else { %>
                        <i class="bi bi-check-circle-fill"></i>
                        Akun dibuat: <strong><%= akunSiswaFlash.dibuat || 0 %></strong> |
                        Sudah memiliki akun: <strong><%= akunSiswaFlash.dilewati || 0 %></strong> |
                        Gagal: <strong><%= akunSiswaFlash.jumlahGagal || 0 %></strong>
                        <% if (akunSiswaFlash.otomatisBerminat > 0) { %>
                            | Otomatis berminat (nilai sudah ada): <strong><%= akunSiswaFlash.otomatisBerminat %></strong>
                        <% } %>
                        <% if (akunSiswaFlash.jumlahGagal > 0 && Array.isArray(akunSiswaFlash.gagal)) { %>
                            <ul style="margin-top:6px;">
                                <% akunSiswaFlash.gagal.forEach(function(g) { %>
                                    <li><%= g.nama %> (NISN: <%= g.nisn || '-' %>): <%= g.alasan %></li>
                                <% }) %>
                            </ul>
                        <% } %>

                        <% if (akunSiswaFlash.dibuat > 0 && !sudahTerkunci && !blokirSiswa) { %>
                            <div style="margin-top:6px;">
                                <a href="/akun-siswa/kartu" target="_blank" rel="noopener" class="btn-kecil btn-kartu">
                                    <i class="bi bi-printer-fill"></i> Cetak Semua Kartu
                                </a>
                            </div>
                        <% } %>
                    <% } %>
                </div>
            <% } %>

            <% if (sudahTerkunci) { %>
                <div class="alert alert-peringatan">
                    <i class="bi bi-lock-fill"></i>
                    Hasil seleksi sudah difinalisasi. Seluruh data siswa, akun, nilai, dan pencetakan kartu terkunci.
                </div>
            <% } else { %>
                <% if (blokirSiswa) { %>
                    <div class="alert alert-peringatan">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Seluruh tombol di halaman Data Siswa <strong>dinonaktifkan</strong> karena pembobotan FUCOM belum selesai atau belum konsisten.
                        Selesaikan di menu <a href="/admin/fucom" style="font-weight:600;">Pembobotan Kriteria</a>.
                    </div>
                <% } %>
                <% if (blokirNilai) { %>
                    <div class="alert alert-peringatan">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <% if (!adaSiswa) { %>
                            Input nilai <strong>dinonaktifkan</strong> karena belum ada data siswa.
                        <% } else { %>
                            Input nilai <strong>dinonaktifkan</strong> karena masih ada <strong><%= R.belumKonfirmasi %> siswa</strong> yang belum merespons.
                            Ubah statusnya di tabel di bawah atau tunggu siswa menjawab.
                        <% } %>
                    </div>
                <% } %>
            <% } %>

            <!-- Tabel -->
            <div class="panel">
                <div class="panel-header-row">
                    <div class="panel-header">
                        <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-person-fill"></i></div>
                        <h3>Daftar Siswa Calon Kelas Digital</h3>
                    </div>

                    <div style="display:flex;gap:10px;flex-wrap:wrap;">
                        <% if (blokirSiswa) { %>
                            <span class="btn-secondary btn-mati link-template"
                                  title="<%= alasanBlokirSiswa %>">
                                <i class="bi bi-download"></i> Unduh Template
                            </span>
                        <% } else { %>
                            <a href="/admin/siswa/template" class="btn-secondary link-template">
                                <i class="bi bi-download"></i> Unduh Template
                            </a>
                        <% } %>

                        <% if (!sudahTerkunci) { %>
                            <% if (blokirSiswa) { %>
                                <button type="button" class="btn-secondary btn-off" disabled
                                        title="<%= alasanBlokirSiswa %>">
                                    <i class="bi bi-file-earmark-excel-fill"></i> Import Excel
                                </button>
                                <button type="button" class="btn-primary btn-off" disabled
                                        title="<%= alasanBlokirSiswa %>">
                                    <i class="bi bi-plus-lg"></i> Tambah Siswa
                                </button>
                                <button type="button" class="btn-hapus-massal btn-off" disabled
                                        title="<%= alasanBlokirSiswa %>">
                                    <i class="bi bi-trash-fill"></i> Hapus Terpilih
                                </button>
                            <% } else { %>
                                <button type="button" class="btn-secondary" onclick="bukaModal('modalImport')">
                                    <i class="bi bi-file-earmark-excel-fill"></i> Import Excel
                                </button>
                                <button type="button" class="btn-primary" onclick="bukaModal('modalTambah')">
                                    <i class="bi bi-plus-lg"></i> Tambah Siswa
                                </button>
                                <% if (daftarSiswa.length === 0) { %>
                                    <button type="button" class="btn-hapus-massal" disabled title="Nonaktif: belum ada data siswa">
                                        <i class="bi bi-trash-fill"></i> Hapus Terpilih
                                    </button>
                                <% } else { %>
                                    <button type="button" class="btn-hapus-massal" onclick="hapusTerpilih()"
                                            title="Hapus siswa yang dicentang di tabel">
                                        <i class="bi bi-trash-fill"></i> Hapus Terpilih <span id="jumlahHapusHeader"></span>
                                    </button>
                                <% } %>
                            <% } %>
                        <% } %>
                    </div>
                </div>

                <div class="toolbar">
                    <input type="text" id="searchSiswa" class="search-input" placeholder="Cari nama atau NISN..." autocomplete="off">

                    <select id="filterStatus">
                        <option value="">Semua status akun</option>
                        <option value="tanpa_akun">Belum punya akun</option>
                        <option value="aktif">Aktif</option>
                        <option value="nonaktif">Nonaktif</option>
                    </select>

                    <select id="filterMinat">
                        <option value="">Semua status minat</option>
                        <option value="berminat">Berminat</option>
                        <option value="belum_respon">Belum merespons</option>
                        <option value="tidak_berminat">Tidak berminat</option>
                    </select>

                    <span id="hitungTampil" class="info-hitung"></span>
                    <span class="spacer"></span>

                    <% if (adaKartu) { %>
                        <% if (sudahTerkunci) { %>
                            <span class="btn-kecil btn-kartu btn-lebar btn-mati" title="Kartu tidak dapat dicetak setelah finalisasi">
                                <i class="bi bi-lock-fill"></i> Cetak Semua Kartu
                            </span>
                        <% } else if (blokirSiswa) { %>
                            <span class="btn-kecil btn-kartu btn-lebar btn-mati" title="<%= alasanBlokirSiswa %>">
                                <i class="bi bi-printer-fill"></i> Cetak Semua Kartu
                            </span>
                        <% } else { %>
                            <a href="/akun-siswa/kartu" target="_blank" rel="noopener" class="btn-kecil btn-kartu btn-lebar">
                                <i class="bi bi-printer-fill"></i> Cetak Semua Kartu
                            </a>
                        <% } %>
                    <% } %>

                    <% if (R.tanpaAkun > 0 && !sudahTerkunci) { %>
                        <% if (blokirSiswa) { %>
                            <button type="button" class="btn-primary btn-off" disabled title="<%= alasanBlokirSiswa %>">
                                <i class="bi bi-person-plus-fill"></i> Buat Akun Siswa (<%= R.tanpaAkun %>)
                            </button>
                        <% } else { %>
                            <form action="/akun-siswa/generate" method="POST" style="margin:0;" onsubmit="return prosesGenerate(this)">
                                <button type="submit" class="btn-primary">
                                    <i class="bi bi-person-plus-fill"></i> Buat Akun Siswa (<%= R.tanpaAkun %>)
                                </button>
                            </form>
                        <% } %>
                    <% } else if (R.total > 0) { %>
                        <span class="badge-akun aktif"><i class="bi bi-check-circle-fill"></i> Semua siswa sudah punya akun</span>
                    <% } %>
                </div>

                <% if (bisaCentang) { %>
                    <!-- Bar aksi checklist massal (muncul otomatis saat ada yang dicentang) -->
                    <form id="formMassal" class="bulk-bar" action="/admin/siswa/minat-massal" method="POST" onsubmit="return kirimMassal(this)">
                        <span class="bulk-info">
                            <i class="bi bi-check2-square"></i>
                            <strong id="jumlahDipilih">0</strong> siswa dipilih
                        </span>

                        <button type="button" class="btn-kecil" onclick="pilihSemuaTampil()">
                            <i class="bi bi-check-all"></i> Pilih semua yang tampil
                        </button>

                        <button type="button" class="btn-kecil" onclick="batalPilih()">
                            <i class="bi bi-x-circle"></i> Batal pilih
                        </button>

                        <span class="spacer"></span>

                        <div class="bulk-aksi">
                            <% if (adaYangBisaDicentang) { %>
                                <button type="submit" class="btn-massal btn-massal-ya" onclick="setStatusMassal('berminat')">
                                    <i class="bi bi-check-lg"></i> Konfirmasi Berminat
                                </button>
                                <button type="submit" class="btn-massal btn-massal-tidak" onclick="setStatusMassal('tidak_berminat')">
                                    <i class="bi bi-x-lg"></i> Konfirmasi Tidak Berminat
                                </button>
                            <% } %>
                            <!-- Tombol ini milik form hapus di bawah (atribut form), bukan form bar ini -->
                            <button type="submit" form="formHapusMassal" class="btn-massal btn-massal-hapus">
                                <i class="bi bi-trash-fill"></i> Hapus Terpilih
                            </button>
                        </div>
                    </form>

                    <!-- Form hapus massal (tersembunyi). Id siswa diisi lewat JS saat submit. -->
                    <form id="formHapusMassal" action="/admin/siswa/hapus-massal" method="POST"
                          onsubmit="return kirimHapusMassal(this)" style="display:none;"></form>
                <% } %>

                <div class="table-scroll">
                    <table class="data-table" id="tabelSiswa">
                        <thead>
                            <tr>
                                <th class="col-cek">
                                    <% if (bisaCentang) { %>
                                        <input type="checkbox" id="cekSemua" title="Pilih semua siswa yang tampil" aria-label="Pilih semua">
                                    <% } %>
                                </th>
                                <th>No</th>
                                <th>NISN</th>
                                <th>Nama</th>
                                <th>JK</th>
                                <th>Sekolah Asal</th>
                                <th>PIP/PKH</th>
                                <th>Status Akun</th>
                                <th>Status Minat</th>
                                <th>Nilai</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (daftarSiswa.length === 0) { %>
                                <tr>
                                    <td colspan="11" class="empty-state">Belum ada data siswa. Tambahkan manual atau import dari Excel.</td>
                                </tr>
                            <% } %>

                            <% daftarSiswa.forEach(function(s, index) {
                                const punyaAkun = Boolean(s.punya_akun);
                                const st = !punyaAkun ? 'tanpa_akun' : (s.status_akun || 'aktif');
                                const minat = punyaAkun ? (s.status_minat || 'belum_respon') : 'belum_respon';

                                const labelAkun = { tanpa_akun: 'Belum Ada Akun', aktif: 'Aktif', nonaktif: 'Nonaktif' }[st] || 'Tidak Dikenal';
                                const labelMinat = { berminat: 'Berminat', belum_respon: 'Belum merespons', tidak_berminat: 'Tidak berminat' }[minat] || 'Belum merespons';
                                const kelasMinat = { berminat: 'berminat', belum_respon: 'belum_aktif', tidak_berminat: 'tidak_berminat' }[minat] || 'tanpa_akun';
                                const bisaNilai = minat !== 'tidak_berminat';
                                const bisaUbahMinat = punyaAkun && minat === 'belum_respon' && !sudahTerkunci;
                            %>
                                <tr class="baris-siswa <%= minat === 'belum_respon' ? 'perlu-dihubungi' : '' %> <%= minat === 'tidak_berminat' ? 'tidak-ikut' : '' %>"
                                    data-nama="<%= (s.nama || '').toLowerCase() %>"
                                    data-nisn="<%= s.nisn || '' %>"
                                    data-status="<%= st %>"
                                    data-minat="<%= minat %>">

                                    <td class="col-cek">
                                        <% if (bisaCentang) { %>
                                            <input type="checkbox" class="cek-siswa" value="<%= s.id_siswa %>"
                                                   data-minat-ok="<%= (bisaUbahMinat && !blokirSiswa) ? '1' : '0' %>"
                                                   data-nama-siswa="<%= s.nama || '' %>"
                                                   aria-label="Pilih <%= s.nama %>">
                                        <% } %>
                                    </td>

                                    <td class="no-urut"><%= index + 1 %></td>
                                    <td><%= s.nisn || '-' %></td>
                                    <td><%= s.nama || '-' %></td>
                                    <td><%= s.jenis_kelamin === 'L' ? 'Laki-laki' : (s.jenis_kelamin === 'P' ? 'Perempuan' : '-') %></td>
                                    <td><%= s.sekolah_asal || '-' %></td>

                                    <td>
                                        <span class="badge badge-<%= s.status_pip_pkh ? 'green' : 'red' %>">
                                            <%= s.status_pip_pkh ? 'Ya' : 'Tidak' %>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge-akun <%= st %>"><%= labelAkun %></span>
                                        <% if (punyaAkun && s.wajib_ganti_password) { %>
                                            <span class="sub-info">Belum ganti password awal</span>
                                        <% } else if (punyaAkun && s.last_login) { %>
                                            <span class="sub-info">Login terakhir: <%= new Date(s.last_login).toLocaleDateString('id-ID') %></span>
                                        <% } %>
                                    </td>

                                    <td>
                                        <span class="badge-akun <%= kelasMinat %>"><%= labelMinat %></span>

                                        <% if (bisaUbahMinat) { %>
                                            <% if (blokirSiswa) { %>
                                                <div class="minat-aksi">
                                                    <button type="button" class="btn-kecil btn-minat-ya btn-off" disabled title="<%= alasanBlokirSiswa %>">
                                                        <i class="bi bi-check-lg"></i> Berminat
                                                    </button>
                                                    <button type="button" class="btn-kecil btn-minat-tidak btn-off" disabled title="<%= alasanBlokirSiswa %>">
                                                        <i class="bi bi-x-lg"></i> Tidak
                                                    </button>
                                                </div>
                                            <% } else { %>
                                                <div class="minat-aksi">
                                                    <form action="/admin/siswa/minat" method="POST"
                                                          onsubmit="return confirmDelete(this, 'Ubah status minat siswa ini menjadi Berminat? Siswa akan ikut perankingan dan status ini tidak dapat diubah lagi.')">
                                                        <input type="hidden" name="id_siswa" value="<%= s.id_siswa %>">
                                                        <input type="hidden" name="status_minat" value="berminat">
                                                        <button type="submit" class="btn-kecil btn-minat-ya" title="Tandai siswa berminat">
                                                            <i class="bi bi-check-lg"></i> Berminat
                                                        </button>
                                                    </form>

                                                    <form action="/admin/siswa/minat" method="POST"
                                                          onsubmit="return confirmDelete(this, 'Ubah status minat siswa ini menjadi Tidak berminat? Akun siswa akan dinonaktifkan dan status ini tidak dapat diubah lagi.')">
                                                        <input type="hidden" name="id_siswa" value="<%= s.id_siswa %>">
                                                        <input type="hidden" name="status_minat" value="tidak_berminat">
                                                        <button type="submit" class="btn-kecil btn-minat-tidak" title="Tandai siswa tidak berminat">
                                                            <i class="bi bi-x-lg"></i> Tidak
                                                        </button>
                                                    </form>
                                                </div>
                                            <% } %>
                                        <% } else if (!punyaAkun && !sudahTerkunci) { %>
                                            <span class="sub-info">Buat akun dulu untuk mengubah status</span>
                                        <% } %>
                                    </td>

                                    <td>
                                        <% if (!bisaNilai) { %>
                                            <span class="teks-tidak-ikut">Tidak ikut</span>
                                        <% } else if (sudahTerkunci) { %>
                                            <span class="teks-kunci"><i class="bi bi-lock-fill"></i> Terkunci</span>
                                        <% } else if (blokirNilai) { %>
                                            <span class="btn-kecil btn-nilai btn-mati" title="<%= alasanBlokirNilai %>">
                                                <i class="bi bi-pencil-square"></i> Input/Edit
                                            </span>
                                        <% } else { %>
                                            <a class="btn-kecil btn-nilai" href="/admin/nilai/<%= s.id_siswa %>" title="Input atau edit nilai siswa">
                                                <i class="bi bi-pencil-square"></i> Input/Edit
                                            </a>
                                        <% } %>
                                    </td>

                                    <td class="action-cell">
                                        <% if (punyaAkun) { %>
                                            <% if (sudahTerkunci) { %>
                                                <span class="btn-kecil btn-kartu btn-mati" title="Kartu tidak dapat dicetak setelah finalisasi">
                                                    <i class="bi bi-lock-fill"></i> Kartu
                                                </span>
                                            <% } else if (blokirSiswa) { %>
                                                <span class="btn-kecil btn-kartu btn-mati" title="<%= alasanBlokirSiswa %>">
                                                    <i class="bi bi-printer-fill"></i> Kartu
                                                </span>
                                            <% } else { %>
                                                <a class="btn-kecil btn-kartu" href="/akun-siswa/<%= s.id_siswa %>/kartu" target="_blank" rel="noopener" title="Cetak kartu akun">
                                                    <i class="bi bi-printer-fill"></i> Kartu
                                                </a>
                                            <% } %>
                                        <% } %>

                                        <% if (punyaAkun && st === 'aktif' && !sudahTerkunci) { %>
                                            <% if (blokirSiswa) { %>
                                                <button type="button" class="btn-kecil btn-off" disabled title="<%= alasanBlokirSiswa %>">
                                                    <i class="bi bi-key-fill"></i> Reset
                                                </button>
                                            <% } else { %>
                                                <form action="/akun-siswa/<%= s.id_siswa %>/reset-password" method="POST"
                                                      onsubmit="return confirmDelete(this, 'Reset password akun siswa ini? Password lama tidak akan berlaku lagi.')">
                                                    <button type="submit" class="btn-kecil"><i class="bi bi-key-fill"></i> Reset</button>
                                                </form>
                                            <% } %>
                                        <% } %>

                                        <% if (!sudahTerkunci) { %>
                                            <% if (blokirSiswa) { %>
                                                <button type="button" class="btn-icon btn-off" disabled title="<%= alasanBlokirSiswa %>">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>

                                                <button type="button" class="btn-icon btn-icon-danger btn-off" disabled title="<%= alasanBlokirSiswa %>">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            <% } else { %>
                                                <button type="button" class="btn-icon" title="Edit data siswa"
                                                        onclick="bukaModalEdit(this)"
                                                        data-siswa="<%= encodeURIComponent(JSON.stringify(s)) %>">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>

                                                <form action="/admin/siswa/delete/<%= s.id_siswa %>" method="POST"
                                                      onsubmit="return confirmDelete(this, 'Hapus data siswa ini beserta akun dan nilainya?')">
                                                    <button type="submit" class="btn-icon btn-icon-danger" title="Hapus data siswa">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </button>
                                                </form>
                                            <% } %>
                                        <% } else { %>
                                            <span class="teks-kunci"><i class="bi bi-lock-fill"></i> Terkunci</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>

                            <tr id="barisKosongCari" style="display:none;">
                                <td colspan="11" class="empty-state">Tidak ada siswa yang cocok dengan pencarian atau filter.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <%- include('../partials/footer') %>
        </div>
    </div>
</div>

