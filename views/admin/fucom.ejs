<!DOCTYPE html>
<html lang="id">
<head>
    <title>Perhitungan FUCOM</title>
    <%- include('../partials/head') %>
</head>
<body>
    <div class="app-layout">
        <%- include('../partials/sidebar', { user: user, activePage: activePage }) %>
        <div class="main-content">
            <%- include('../partials/topbar', { user: user, pageTitle: pageTitle }) %>

            <div class="content-wrapper">
                <% if (success) { %>
                    <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
                <% } %>

                <!-- Panel Input Data Responden -->
                <div class="panel">
                    <div class="panel-header-row">
                        <div class="panel-header">
                            <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-clipboard-data"></i></div>
                            <h3>Input Hasil Kuesioner Perbandingan Kriteria</h3>
                        </div>
                        <button class="btn-primary" onclick="document.getElementById('modalInput').style.display='flex'">
                            <i class="bi bi-plus-lg"></i> Input Data Responden
                        </button>
                    </div>

                    <% if (respondenList.length === 0) { %>
                        <p class="empty-state">Belum ada data responden. Klik "Input Data Responden" untuk memasukkan hasil kuesioner dari guru.</p>
                    <% } else { %>
                        <table class="data-table">
                            <thead><tr><th>No</th><th>Nama Responden</th></tr></thead>
                            <tbody>
                                <% respondenList.forEach(function(nama, idx) { %>
                                    <tr><td><%= idx + 1 %></td><td><%= nama %></td></tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } %>
                </div>

                <!-- Panel Hitung Bobot -->
                <div class="panel">
                    <div class="panel-header-row">
                        <div class="panel-header">
                            <div class="stat-icon icon-orange" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-sliders"></i></div>
                            <h3>Hasil Perhitungan Bobot Kriteria</h3>
                        </div>
                        <form action="/admin/fucom/hitung" method="POST">
                            <button type="submit" class="btn-primary" <%= respondenList.length === 0 ? 'disabled' : '' %>>
                                <i class="bi bi-calculator-fill"></i> Hitung Bobot FUCOM
                            </button>
                        </form>
                    </div>

                    <% if (bobotFinal.length === 0) { %>
                        <p class="empty-state">Bobot belum dihitung. Pastikan minimal 1 responden sudah input data, lalu klik "Hitung Bobot FUCOM".</p>
                    <% } else { %>
                        <table class="data-table">
                            <thead><tr><th>Kriteria</th><th>Bobot</th><th>Nilai DFC</th></tr></thead>
                            <tbody>
                                <% bobotFinal.forEach(function(b) { %>
                                    <tr>
                                        <td><%= b.nama_kriteria %></td>
                                        <td><strong><%= (b.nilai_bobot * 100).toFixed(2) %>%</strong></td>
                                        <td>
                                            <span class="badge badge-<%= b.nilai_dfc < 0.1 ? 'green' : 'red' %>">
                                                <%= parseFloat(b.nilai_dfc).toFixed(4) %>
                                                <%= b.nilai_dfc < 0.1 ? '(Konsisten)' : '(Perlu Ditinjau)' %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } %>
                </div>

                <%- include('../partials/footer') %>
            </div>
        </div>
    </div>

    <!-- Modal Input Data Responden -->
    <div class="modal-overlay" id="modalInput">
        <div class="modal-box" style="max-width:550px;">
            <div class="modal-header">
                <h3><i class="bi bi-clipboard-data"></i> Input Data Kuesioner Responden</h3>
                <button class="modal-close" onclick="document.getElementById('modalInput').style.display='none'">&times;</button>
            </div>
            <form action="/admin/fucom/input-responden" method="POST">
                <label>Nama Responden</label>
                <input type="text" name="nama_responden" required placeholder="Contoh: Desi Wahyuni, S.Pd">

                <p style="font-size:13px; color:#777; margin-top:15px; margin-bottom:10px;">
                    Urutkan kriteria dari yang <strong>paling penting</strong> ke yang <strong>paling kurang penting</strong> sesuai Tahap 1 kuesioner, lalu isi nilai perbandingan sesuai Tahap 2.
                </p>

                <div id="urutanKriteriaWrapper">
                    <% kriteriaList.forEach(function(k, idx) { %>
                        <label>Peringkat <%= idx + 1 %></label>
                        <select name="id_kriteria_urutan" required style="margin-bottom:8px;">
                            <% kriteriaList.forEach(function(k2) { %>
                                <option value="<%= k2.id_kriteria %>"><%= k2.nama_kriteria %></option>
                            <% }); %>
                        </select>
                    <% }); %>
                </div>

                <p style="font-size:13px; color:#777; margin-top:15px; margin-bottom:10px;">
                    Nilai perbandingan antar peringkat berurutan (skala 1-9):
                </p>

                <% for (let i = 0; i < kriteriaList.length - 1; i++) { %>
                    <label>Peringkat <%= i + 1 %> dibanding Peringkat <%= i + 2 %></label>
                    <input type="number" name="nilai_perbandingan" min="1" max="9" step="0.5" required style="margin-bottom:8px;">
                <% } %>

                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="document.getElementById('modalInput').style.display='none'">Batal</button>
                    <button type="submit" class="btn-primary">Simpan Data</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>