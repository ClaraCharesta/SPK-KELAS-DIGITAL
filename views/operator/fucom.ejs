<!DOCTYPE html>
<html lang="id">
<head>
    <title>Perhitungan FUCOM</title>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/fucom.css">
    <%# Semua style halaman ini ada di /css/layout.css. Jika partials/head belum memuat layout.css, aktifkan baris di bawah. %>
    <%# <link rel="stylesheet" href="/css/layout.css"> %>
    <style>
        /* Nama responden otomatis dari profil (hanya baca) */
        .nama-otomatis-box {
            display: flex; align-items: center; gap: 10px; background: #f4f7fb; border: 1.5px solid #dcdfe6;
            border-radius: 10px; padding: 10px 14px; color: #0b2545; font-weight: 600; font-size: 15px;
        }
        .nama-otomatis-box i { color: #1d4ed8; }
        .nama-otomatis-box .kunci { margin-left: auto; color: #9aa5b8; font-size: 13px; }
        .nama-otomatis-catatan { font-size: 12px; color: #6b7685; margin-top: 6px; }

        /* Responsif tambahan */
        .tabel-scroll { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
        @media (max-width: 640px) {
            .panel-header-row { flex-wrap: wrap; gap: 10px; }
            .panel-header-row .btn-primary { width: 100%; justify-content: center; }
            .banner-inkonsisten { flex-direction: column; align-items: stretch; gap: 10px; }
            .banner-inkonsisten .aksi { display: flex; gap: 8px; flex-wrap: wrap; }
            .banner-inkonsisten .aksi button { flex: 1; }
            .modal-footer { flex-wrap: wrap; gap: 8px; }
        }
    </style>
</head>
<body>
<%
    const aman = function (obj) { return JSON.stringify(obj).replace(/</g, '\\u003c'); };

    // Nama responden otomatis = nama profil akun yang sedang login (dikirim controller)
    const namaResp = (typeof namaResponden !== 'undefined' && namaResponden)
        ? namaResponden
        : ((user && user.nama) ? user.nama : '');

    // Data untuk prefill modal edit (hanya 1 responden yang diizinkan).
    let dataEdit = null;
    if (respondenList.length === 1) {
        const rows = dataResponden[respondenList[0]] || [];
        const urutan = [];
        rows.forEach(function (r) {
            if (!urutan.includes(r.id_kriteria_asal)) urutan.push(r.id_kriteria_asal);
        });
        if (rows.length > 0) {
            const last = rows[rows.length - 1];
            if (!urutan.includes(last.id_kriteria_pembanding)) urutan.push(last.id_kriteria_pembanding);
        }
        dataEdit = {
            urutan: urutan.map(String),
            nilai: rows.map(function (r) { return String(parseFloat(r.nilai_perbandingan)).replace('.', ','); })
        };
    }

    // Modal mana saja yang perlu dirender.
    const bolehEdit = !terkunci && respondenList.length === 1 && (bobotFinal.length === 0 || !dfcKonsisten);
    const bolehInput = !terkunci && respondenList.length === 0;
    const daftarModal = [];
    if (bolehInput) {
        daftarModal.push({
            id: 'modalInput', mode: 'input', icon: 'bi-clipboard-data',
            judul: 'Input Data Perbandingan Kriteria',
            action: '/operator/fucom/input', tombol: 'Simpan Data'
        });
    }
    if (bolehEdit) {
        daftarModal.push({
            id: 'modalEdit', mode: 'edit', icon: 'bi-pencil-fill',
            judul: 'Edit Data Perbandingan Kriteria',
            action: '/operator/fucom/edit', tombol: 'Simpan Perubahan'
        });
    }

    // Untuk stepper: langkah 2 baru terbuka kalau data responden sudah ada
    const adaData = respondenList.length >= 1;
    const tipTerkunci = 'Isi data responden dulu untuk membuka langkah ini';

    // ===== Bantuan tampilan saat hasil inkonsisten (hanya tampilan, tidak mengubah logika) =====
    const inkonsisten = bobotFinal.length > 0 && !dfcKonsisten;
    const AMBANG_BESAR_VIEW = 4;
    const nilaiDfcTampil = bobotFinal.length > 0 ? parseFloat(bobotFinal[0].nilai_dfc).toFixed(3).replace('.', ',') : '';

    // Daftar perbandingan bernilai besar (di atas 4), kandidat penyebab inkonsistensi.
    const daftarBesar = [];
    if (respondenList.length >= 1) {
        (dataResponden[respondenList[0]] || []).forEach(function (p) {
            const v = parseFloat(p.nilai_perbandingan);
            if (v > AMBANG_BESAR_VIEW) {
                daftarBesar.push({
                    label: p.nama_kriteria_asal + ' vs ' + p.nama_kriteria_pembanding,
                    nilai: String(v).replace('.', ',')
                });
            }
        });
    }
%>
    <div class="app-layout">
        <%- include('../partials/sidebar', { user: user, activePage: activePage }) %>
        <div class="main-content">
            <%- include('../partials/topbar', { user: user, pageTitle: pageTitle }) %>
            <div class="content-wrapper">
                <% if (success) { %>
                    <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
                <% } %>
                <% if (terkunci) { %>
                    <div class="alert" style="background:#fdf1de; color:#b35c00;">
                        <i class="bi bi-lock-fill"></i>
                        Pembobotan terkunci karena status siswa telah final.
                    </div>
                <% } %>

                <!-- Panel Tutorial -->
                <div class="panel" style="background:#f4f8ff;">
                    <div class="panel-header-row" style="cursor:pointer;" onclick="document.getElementById('isiTutorial').classList.toggle('show')">
                        <div class="panel-header">
                            <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-question-circle-fill"></i></div>
                            <h3>Cara Pengisian Data Perbandingan Kriteria</h3>
                        </div>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                    <div id="isiTutorial" class="tutorial-content">
                        <ol style="padding-left:20px; font-size:14px; color:#333; line-height:1.8;">
                            <li>Klik <strong>"Input Data Responden"</strong>. Nama responden <strong>otomatis diambil dari nama pada menu Profil</strong> akun yang sedang login (tidak perlu diketik). Pastikan nama di Profil sudah benar dan login memakai akun pengambil keputusan resmi (misalnya Waka Kurikulum).</li>
                            <li>Urutkan 6 kriteria dari yang <strong>paling penting</strong> ke yang <strong>paling kurang penting</strong>. Urutan dan nilai yang diinput merupakan hasil kesepakatan/musyawarah bersama guru-guru terkait, bukan opini pribadi satu orang saja.</li>
                            <li>Isi nilai perbandingan antar kriteria yang bersebelahan dengan <strong>mengetik angka</strong>, memakai tombol <strong>+ / −</strong> (tahan untuk menaik/menurunkan cepat), tombol panah atas/bawah di keyboard, atau tombol <strong>nilai cepat</strong>. Aturan pengisian:</li>
                        </ol>

                        <div class="tabel-scroll">
                        <table class="data-table" style="margin: 10px 0 15px 20px; max-width: 620px;">
                            <thead>
                                <tr><th style="width:190px;">Contoh Nilai</th><th>Keterangan</th></tr>
                            </thead>
                            <tbody>
                                <tr><td><strong>1</strong></td><td>Kedua kriteria sama penting</td></tr>
                                <tr><td><strong>1,5 &nbsp;/&nbsp; 2,25</strong></td><td>Desimal diperbolehkan, maksimal 2 angka di belakang koma (titik otomatis menjadi koma)</td></tr>
                                <tr><td><strong>2 - 4</strong></td><td>Kriteria sebelumnya lebih penting (disarankan untuk sebagian besar perbandingan)</td></tr>
                                <tr><td><strong>9</strong></td><td>Batas maksimum</td></tr>
                                <tr><td><strong style="color:#b3261e;">0, 0,0, 0,00, 10, huruf, minus</strong></td><td>Tidak diperbolehkan. Nilai harus lebih dari 0 dan paling besar 9</td></tr>
                            </tbody>
                        </table>
                        </div>

                        <ol start="4" style="padding-left:20px; font-size:14px; color:#333; line-height:1.8;">
                            <li>Gunakan nilai yang <strong>moderat</strong> (misalnya 1 sampai 4, boleh desimal). Semakin besar lompatan nilai antar kriteria, semakin besar risiko hasil pembobotan menjadi tidak konsisten. Sistem akan memberi peringatan jika nilai melebihi 4.</li>
                            <li>Data hanya diinput <strong>satu kali</strong> (1 responden). Jika dua orang menekan simpan di waktu yang hampir sama, hanya yang masuk lebih dulu yang tersimpan. Selama bobot belum final, data masih bisa diedit lewat tombol <strong>"Edit"</strong> pada kartu responden. Setelah data yakin benar, klik <strong>"Hitung Bobot FUCOM"</strong>.</li>
                            <li>
                                Setelah dihitung, sistem akan menampilkan nilai <strong>DFC (Deviation from Full Consistency)</strong> — semacam skor yang menunjukkan seberapa konsisten urutan dan nilai yang diinput tadi secara matematis.
                                <ul style="margin-top:6px;">
                                    <li><strong>DFC di bawah 0,1</strong> → hasil dianggap <strong>konsisten</strong>. Bobot otomatis menjadi final dan terkunci, Admin dapat melanjutkan ke pengelolaan data siswa.</li>
                                    <li><strong>DFC di atas atau sama dengan 0,1</strong> → hasil dianggap <strong>belum konsisten</strong>. Ini bukan berarti sistem error — artinya urutan atau nilai perbandingan yang diinput tadi kurang logis secara matematis (misalnya lompatan nilai terlalu ekstrem). Bobot <strong>tidak</strong> dikunci. Halaman otomatis menampilkan panduan perbaikan, lalu klik <strong>"Perbaiki Data Perbandingan"</strong> untuk mengubah nilai yang bermasalah.</li>
                                    <li><strong>Distribusi bobot terlalu timpang</strong> (ada kriteria dengan bobot di bawah 3%) → bobot <strong>tidak disimpan dan tidak dikunci</strong>, walaupun DFC sudah di bawah 0,1. Sistem menyebutkan kriteria mana yang bobotnya terlalu kecil. Ubah nilai perbandingan agar lebih seimbang, lalu hitung ulang.</li>
                                </ul>
                            </li>
                        </ol>
                    </div>
                </div>

                <!-- ============================================================ -->
                <!-- STEPPER STICKY: klik langkah untuk berpindah                 -->
                <!-- ============================================================ -->
                <div class="stepper" id="stepper">
                    <button type="button" class="stepper-item active" data-step="1" onclick="goStep(1)">
                        <span class="stepper-num">1</span>
                        <span class="stepper-label"><small>Langkah 1</small><strong>Data Perbandingan</strong></span>
                    </button>
                    <div class="stepper-line" data-line="1"></div>
                    <button type="button" class="stepper-item" data-step="2" onclick="goStep(2)"
                            <%= adaData ? '' : 'disabled' %> title="<%= adaData ? '' : tipTerkunci %>">
                        <span class="stepper-num">2</span>
                        <span class="stepper-label"><small>Langkah 2</small><strong>Hasil Bobot Kriteria</strong></span>
                    </button>
                </div>

                <!-- ============================================================ -->
                <!-- LANGKAH 1: Data Responden                                    -->
                <!-- ============================================================ -->
                <div class="step-pane active" data-step="1">
                    <% if (!adaData) { %>
                        <div class="step-hint">
                            <i class="bi bi-info-circle-fill"></i>
                            Klik <strong>"Input Data Responden"</strong> dulu untuk membuka langkah 2 (perhitungan bobot).
                        </div>
                    <% } %>

                    <% if (inkonsisten && bolehEdit) { %>
                        <div class="banner-inkonsisten">
                            <span>
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                Hasil perhitungan terakhir <strong>belum konsisten</strong> (DFC <%= nilaiDfcTampil %>, batas 0,1).
                                Perbaiki nilai perbandingan di bawah ini, terutama yang bertanda kuning.
                            </span>
                            <span class="aksi">
                                <button type="button" class="btn-primary" onclick="bukaModalEdit()">
                                    <i class="bi bi-pencil-fill"></i> Perbaiki Data
                                </button>
                                <button type="button" class="btn-secondary" onclick="goStep(2)">
                                    Lihat penjelasan
                                </button>
                            </span>
                        </div>
                    <% } %>

                    <!-- Panel Data Responden -->
                    <div class="panel">
                        <div class="panel-header-row">
                            <div class="panel-header">
                                <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-clipboard-data"></i></div>
                                <h3>Data Perbandingan Kriteria (1 Responden)</h3>
                            </div>
                            <% if (bolehInput) { %>
                                <button type="button" class="btn-primary" onclick="bukaModalInput()">
                                    <i class="bi bi-plus-lg"></i> Input Data Responden
                                </button>
                            <% } %>
                        </div>
                        <% if (respondenList.length === 0) { %>
                            <p class="empty-state">Belum ada data responden. Klik "Input Data Responden" untuk memasukkan hasil kuesioner (hasil musyawarah, diinput oleh 1 responden resmi: <strong><%= namaResp %></strong>).</p>
                        <% } else { %>
                            <% respondenList.forEach(function(nama) { %>
                                <div style="margin-bottom:20px; padding:15px; background:#fafbfd; border-radius:10px;">
                                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; gap:10px; flex-wrap:wrap;">
                                        <strong style="font-size:14px; color:#0b2545;"><i class="bi bi-person-fill"></i> <%= nama %></strong>
                                        <% if (!terkunci && (bobotFinal.length === 0 || !dfcKonsisten)) { %>
                                            <div style="display:flex; gap:6px;">
                                                <button type="button" class="btn-icon" title="Edit" onclick="bukaModalEdit()">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </button>
                                                <form action="/operator/fucom/hapus" method="POST" onsubmit="return confirmDelete(this,'Hapus data responden ini?');">
                                                    <button type="submit" class="btn-icon btn-icon-danger" title="Hapus">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        <% } else { %>
                                            <span style="color:#999; font-size:12px;">Terkunci</span>
                                        <% } %>
                                    </div>
                                    <div class="tabel-scroll">
                                    <table class="data-table">
                                        <thead><tr><th>Perbandingan</th><th>Nilai</th></tr></thead>
                                        <tbody>
                                            <% dataResponden[nama].forEach(function(p) {
                                                const nilaiBaris = parseFloat(p.nilai_perbandingan);
                                                const besar = nilaiBaris > AMBANG_BESAR_VIEW;
                                            %>
                                                <tr class="<%= besar ? 'baris-besar' : '' %>">
                                                    <td><%= p.nama_kriteria_asal %> vs <%= p.nama_kriteria_pembanding %></td>
                                                    <td>
                                                        <strong><%= String(nilaiBaris).replace('.', ',') %></strong>
                                                        <% if (besar) { %>
                                                            <span class="tag-besar" title="Nilai di atas 4 berisiko membuat hasil tidak konsisten">
                                                                <i class="bi bi-exclamation-triangle-fill"></i> Cukup besar
                                                            </span>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                    </div>
                                </div>
                            <% }); %>
                        <% } %>
                    </div>
                </div>

                <!-- ============================================================ -->
                <!-- LANGKAH 2: Hitung Bobot & Hasil                              -->
                <!-- ============================================================ -->
                <div class="step-pane" data-step="2">
                    <!-- Panel Hitung Bobot -->
                    <div class="panel">
                        <div class="panel-header-row">
                            <div class="panel-header">
                                <div class="stat-icon icon-orange" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-sliders"></i></div>
                                <h3>Hasil Perhitungan Bobot Kriteria</h3>
                            </div>
                            <% if (respondenList.length >= 1 && !terkunci && (bobotFinal.length === 0 || !dfcKonsisten)) { %>
                                <form action="/operator/fucom/hitung" method="POST" onsubmit="return confirmDelete(this, 'PERHATIAN: Setelah bobot dihitung dan hasilnya konsisten, data responden TIDAK bisa lagi diedit atau dihapus. Pastikan seluruh data responden sudah benar sebelum melanjutkan. Lanjutkan menghitung bobot?');">
                                    <button type="submit" class="btn-primary">
                                        <i class="bi bi-calculator-fill"></i> Hitung Bobot FUCOM
                                    </button>
                                </form>
                            <% } %>
                        </div>

                        <% if (respondenList.length < 1) { %>
                            <p class="empty-state">Tombol perhitungan akan muncul setelah data responden diisi. Saat ini: <strong><%= respondenList.length %>/1</strong> responden.</p>
                        <% } else if (bobotFinal.length === 0) { %>
                            <p class="empty-state">
                                <% if (terkunci) { %>
                                    Data terkunci, perhitungan tidak dapat dijalankan lagi.
                                <% } else { %>
                                    Data sudah lengkap. Klik "Hitung Bobot FUCOM" untuk memulai perhitungan.
                                <% } %>
                            </p>
                        <% } else { %>

                            <% if (!dfcKonsisten) { %>
                                <!-- ===== PANDUAN PERBAIKAN (tampilan saja) ===== -->
                                <div class="panduan-inkonsisten">
                                    <h4><i class="bi bi-compass-fill"></i> Hasil belum konsisten. Apa yang perlu dilakukan sekarang?</h4>
                                    <p>
                                        Tenang, ini bukan error sistem. Nilai yang diinput belum cukup selaras secara matematis,
                                        jadi bobot yang keluar belum boleh dipakai. Data lama Anda <strong>tidak hilang</strong>:
                                        form edit akan terisi otomatis, tinggal ubah bagian yang bermasalah.
                                    </p>

                                    <div class="skor-dfc">
                                        <div class="kotak">
                                            <small>Skor DFC Anda</small>
                                            <strong><%= nilaiDfcTampil %></strong>
                                        </div>
                                        <div class="kotak target">
                                            <small>Syarat konsisten</small>
                                            <strong>&lt; 0,1</strong>
                                        </div>
                                    </div>

                                    <% if (daftarBesar.length > 0) { %>
                                        <div class="daftar-besar">
                                            <strong><i class="bi bi-search"></i> Kemungkinan penyebab: nilai perbandingan terlalu besar (di atas 4)</strong>
                                            <ul>
                                                <% daftarBesar.forEach(function(d) { %>
                                                    <li><%= d.label %> bernilai <strong><%= d.nilai %></strong></li>
                                                <% }); %>
                                            </ul>
                                        </div>
                                    <% } else { %>
                                        <div class="daftar-besar">
                                            <strong><i class="bi bi-search"></i> Tidak ada nilai di atas 4.</strong>
                                            Coba periksa <strong>urutan kriteria</strong> dan pastikan lompatan nilai antar pasangan tidak terlalu berbeda jauh.
                                        </div>
                                    <% } %>

                                    <ol class="langkah-perbaikan">
                                        <li>Klik tombol <strong>"Perbaiki Data Perbandingan"</strong> di bawah.</li>
                                        <li>Periksa lagi <strong>urutan kriteria</strong> hasil musyawarah (dari paling penting ke paling kurang penting).</li>
                                        <li>Turunkan nilai yang besar ke kisaran <strong>1 sampai 3</strong>, dan usahakan lompatan antar pasangan tidak terlalu jauh.</li>
                                        <li>Klik <strong>"Simpan Perubahan"</strong>, lalu klik <strong>"Hitung Bobot FUCOM"</strong> lagi.</li>
                                    </ol>

                                    <% if (bolehEdit) { %>
                                        <div class="aksi-perbaikan">
                                            <button type="button" class="btn-primary" onclick="bukaModalEdit()">
                                                <i class="bi bi-pencil-fill"></i> Perbaiki Data Perbandingan
                                            </button>
                                            <button type="button" class="btn-secondary" onclick="goStep(1)">
                                                <i class="bi bi-arrow-left"></i> Lihat data saat ini
                                            </button>
                                        </div>
                                    <% } %>

                                    <div class="alasan-tidak-dipakai">
                                        <i class="bi bi-info-circle-fill"></i>
                                        Kenapa bobot ini tidak bisa dipakai? Bobot yang tidak konsisten membuat hasil ranking WASPAS
                                        tidak dapat dipertanggungjawabkan, sehingga menu Data Siswa dan Input Nilai tetap tertutup sampai bobot konsisten.
                                    </div>
                                </div>
                            <% } %>

                            <div class="tabel-scroll">
                            <table class="data-table">
                                <thead><tr><th>Kriteria</th><th>Bobot</th><th>Nilai DFC (Tingkat Konsistensi)</th></tr></thead>
                                <tbody>
                                    <% bobotFinal.forEach(function(b) { %>
                                        <tr>
                                            <td><%= b.nama_kriteria %></td>
                                            <td><strong><%= b.nilai_bobot < 0.01 ? (b.nilai_bobot * 100).toFixed(3) : (b.nilai_bobot * 100).toFixed(2) %>%</strong></td>
                                            <td>
                                                <span class="badge badge-<%= dfcKonsisten ? 'lulus' : 'mengundurkan_diri' %>">
                                                    <%= parseFloat(b.nilai_dfc).toFixed(3) %>
                                                    <%= dfcKonsisten ? '(Konsisten)' : '(Perlu Ditinjau)' %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                            </div>
                        <% } %>
                    </div>
                </div>

                <%- include('../partials/footer') %>
            </div>
        </div>
    </div>

    <!-- ===== Modal Input & Edit (satu markup, dipakai dua kali) ===== -->
    <% daftarModal.forEach(function(m) { %>
    <div class="modal-overlay" id="<%= m.id %>">
        <div class="modal-box" style="max-width:600px; max-height:92vh; overflow-y:auto;">
            <div class="modal-header">
                <h3><i class="bi <%= m.icon %>"></i> <%= m.judul %></h3>
                <button type="button" class="modal-close" onclick="tutupModalFucom('<%= m.id %>')">&times;</button>
            </div>

            <form class="form-fucom" data-mode="<%= m.mode %>" action="<%= m.action %>" method="POST" novalidate>

                <label>Nama Responden (otomatis dari Profil akun Anda)</label>
                <div class="nama-otomatis-box">
                    <i class="bi bi-person-badge-fill"></i>
                    <span><%= namaResp %></span>
                    <i class="bi bi-lock-fill kunci" title="Tidak dapat diubah di sini"></i>
                </div>
                <p class="nama-otomatis-catatan">Ingin mengganti nama? Ubah lewat menu Profil, lalu simpan ulang data ini.</p>

                <p style="font-size:13px; color:#777; margin-top:15px; margin-bottom:6px;">
                    Urutkan kriteria dari yang <strong>paling penting</strong> ke yang <strong>paling kurang penting</strong>.
                    Kriteria yang sudah dipilih akan otomatis hilang dari pilihan urutan lain.
                </p>

                <div class="urutan-preview"></div>

                <% kriteriaList.forEach(function(k, idx) { %>
                    <label>Kriteria <%= idx + 1 %></label>
                    <select name="id_kriteria_urutan" class="urutan-select" data-index="<%= idx %>" required>
                        <option value="">-- Pilih Kriteria --</option>
                        <% kriteriaList.forEach(function(k2) { %>
                            <option value="<%= k2.id_kriteria %>"><%= k2.nama_kriteria %></option>
                        <% }); %>
                    </select>
                <% }); %>

                <p style="font-size:13px; color:#777; margin-top:15px; margin-bottom:8px;">
                    Nilai perbandingan antar peringkat berurutan: <strong>lebih dari 0 sampai 9</strong>,
                    boleh desimal maksimal 2 angka di belakang koma. <strong>Disarankan nilai moderat</strong>
                    kecuali benar-benar yakin ada kesenjangan sangat besar.
                </p>

                <% for (let i = 0; i < kriteriaList.length - 1; i++) { %>
                    <div class="skala-group" data-index="<%= i %>">
                        <div class="pair-label">Kriteria <%= i + 1 %> dibanding Kriteria <%= i + 2 %></div>

                        <div class="skala-stepper">
                            <button type="button" class="btn-skala" data-aksi="kurang" aria-label="Kurangi nilai"><i class="bi bi-dash-lg"></i></button>
                            <input type="text"
                                   name="nilai_perbandingan_<%= i %>"
                                   class="input-skala"
                                   inputmode="decimal"
                                   maxlength="4"
                                   placeholder="1,5"
                                   autocomplete="off">
                            <button type="button" class="btn-skala" data-aksi="tambah" aria-label="Tambah nilai"><i class="bi bi-plus-lg"></i></button>
                        </div>

                        <div class="skala-chips">
                            <button type="button" class="chip-nilai" data-nilai="1">1</button>
                            <button type="button" class="chip-nilai" data-nilai="1,5">1,5</button>
                            <button type="button" class="chip-nilai" data-nilai="2">2</button>
                            <button type="button" class="chip-nilai" data-nilai="3">3</button>
                            <button type="button" class="chip-nilai" data-nilai="4">4</button>
                        </div>

                        <div class="skala-hint">Lebih dari 0 sampai 9, maksimal 2 angka desimal. Panah atas/bawah juga bisa dipakai.</div>
                        <div class="skala-warn">Nilai di atas 4 tergolong besar dan berisiko membuat hasil pembobotan tidak konsisten.</div>
                        <div class="skala-error"></div>
                    </div>
                <% } %>

                <div class="progres-wrap">
                    <div class="progres-track"><div class="progres-bar"></div></div>
                    <div class="progres-teks">Terisi 0 isian</div>
                </div>

                <div class="peringatan-form"></div>

                <div class="modal-footer" style="justify-content:space-between; align-items:center;">
                    <button type="button" class="btn-teks btn-kosongkan">Kosongkan isian</button>
                    <div style="display:flex; gap:8px;">
                        <button type="button" class="btn-secondary" onclick="tutupModalFucom('<%= m.id %>')">Batal</button>
                        <button type="submit" class="btn-primary"><%= m.tombol %></button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <% }); %>

    <script>
    (function () {
        // ==== DATA DARI SERVER ====
        var kriteriaMap = <%- aman(Object.fromEntries(kriteriaList.map(function (k) { return [String(k.id_kriteria), k.nama_kriteria]; }))) %>;
        var dataEditFucom = <%- aman(dataEdit) %>;

        // ==== ATURAN VALIDASI ====
        var REGEX_SKALA = /^[0-9](,[0-9]{1,2})?$/;
        var LANGKAH = 0.5;
        var AMBANG_BESAR = 4;
        var PESAN_SKALA = 'Isi angka lebih dari 0 sampai 9 (maksimal 2 desimal). Nilai 0, 0,0, 0,00, dan angka 10 ke atas tidak diperbolehkan.';

        function skalaValid(teks) {
            if (!REGEX_SKALA.test(teks)) return false;
            var angka = Number(teks.replace(',', '.'));
            return isFinite(angka) && angka > 0 && angka <= 9;
        }

        // Hanya angka dan satu koma, 1 digit di depan koma, maksimal 2 digit di belakang koma.
        function bersihkanSkala(v) {
            v = v.replace(/[^0-9.,]/g, '').replace(/\./g, ',');
            var idx = v.indexOf(',');
            if (idx === -1) return v.slice(0, 1);
            var depan = v.slice(0, idx).slice(0, 1) || '0';
            var belakang = v.slice(idx + 1).replace(/,/g, '').slice(0, 2);
            return depan + ',' + belakang;
        }

        function formatAngka(n) { return String(n).replace('.', ','); }

        // ==== INISIALISASI SATU FORM (dipakai modal input & edit) ====
        function initForm(form) {
            var selects = Array.prototype.slice.call(form.querySelectorAll('.urutan-select'));
            var groups = Array.prototype.slice.call(form.querySelectorAll('.skala-group'));
            var formWarn = form.querySelector('.peringatan-form');
            var preview = form.querySelector('.urutan-preview');
            var progresTeks = form.querySelector('.progres-teks');
            var progresBar = form.querySelector('.progres-bar');
            var submitBtn = form.querySelector('button[type="submit"]');
            // Nama responden otomatis dari profil, jadi tidak dihitung sebagai isian.
            var totalIsian = selects.length + groups.length;

            // Daftar lengkap kriteria (master), diambil sekali dari dropdown pertama saat halaman dimuat.
            var semuaOpsi = Array.prototype.slice.call(selects[0].options)
                .filter(function (o) { return o.value; })
                .map(function (o) { return { value: o.value, text: o.textContent }; });

            function inputDari(g) { return g.querySelector('.input-skala'); }
            function namaKriteria(sel) { return sel.value ? kriteriaMap[sel.value] : null; }

            // Bangun ulang isi satu dropdown.
            // Kriteria yang sudah dipilih di dropdown lain (daftar "dikecualikan") DIHAPUS dari pilihan.
            function bangunOpsi(sel, dikecualikan) {
                var nilaiSekarang = sel.value;
                sel.innerHTML = '';

                var placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = '-- Pilih Kriteria --';
                sel.appendChild(placeholder);

                semuaOpsi.forEach(function (o) {
                    if (dikecualikan.indexOf(o.value) !== -1) return;
                    var el = document.createElement('option');
                    el.value = o.value;
                    el.textContent = o.text;
                    sel.appendChild(el);
                });

                sel.value = nilaiSekarang;
            }

            // Kembalikan semua dropdown ke daftar lengkap (dipakai saat kosongkan / prefill).
            function bukaSemuaOpsi() {
                selects.forEach(function (s) { bangunOpsi(s, []); });
            }

            // Sinkronkan: tiap dropdown hanya menampilkan kriteria yang belum dipakai dropdown lain.
            function sinkronOpsi() {
                selects.forEach(function (s) {
                    var dipakaiLain = selects
                        .filter(function (x) { return x !== s && x.value; })
                        .map(function (x) { return x.value; });
                    bangunOpsi(s, dipakaiLain);
                });
            }

            function sinkronLabel() {
                groups.forEach(function (g, i) {
                    var a = namaKriteria(selects[i]);
                    var b = namaKriteria(selects[i + 1]);
                    g.querySelector('.pair-label').textContent =
                        (a && b) ? (a + ' dibanding ' + b)
                                 : ('Kriteria ' + (i + 1) + ' dibanding Kriteria ' + (i + 2));
                });
            }

            function sinkronPreview() {
                preview.innerHTML = '';
                selects.forEach(function (s, i) {
                    var chip = document.createElement('span');
                    chip.className = 'chip-urutan' + (s.value ? ' terisi' : '');
                    chip.textContent = (i + 1) + '. ' + (namaKriteria(s) || '—');
                    preview.appendChild(chip);
                });
            }

            // paksa = true: tampilkan error walau kosong (saat submit).
            function periksaGroup(g, paksa) {
                var input = inputDari(g);
                var stepper = g.querySelector('.skala-stepper');
                var err = g.querySelector('.skala-error');
                var warn = g.querySelector('.skala-warn');
                var teks = input.value.trim();
                var valid = skalaValid(teks);
                var tampilError = !valid && (paksa || (teks !== '' && input.dataset.disentuh === '1'));

                stepper.classList.toggle('valid', valid);
                stepper.classList.toggle('tidak-valid', tampilError);
                err.style.display = tampilError ? 'block' : 'none';
                if (tampilError) err.textContent = PESAN_SKALA;

                var besar = valid && Number(teks.replace(',', '.')) > AMBANG_BESAR;
                warn.style.display = besar ? 'block' : 'none';

                Array.prototype.forEach.call(g.querySelectorAll('.chip-nilai'), function (c) {
                    c.classList.toggle('aktif', valid && c.dataset.nilai === teks);
                });

                return valid;
            }

            function hitungProgres() {
                var terisi = 0;
                selects.forEach(function (s) { if (s.value) terisi++; });
                groups.forEach(function (g) { if (skalaValid(inputDari(g).value.trim())) terisi++; });
                progresTeks.textContent = 'Terisi ' + terisi + ' dari ' + totalIsian + ' isian';
                progresBar.style.width = ((terisi / totalIsian) * 100) + '%';
                progresBar.classList.toggle('penuh', terisi === totalIsian);
            }

            function segarkan() {
                sinkronOpsi();
                sinkronLabel();
                sinkronPreview();
                groups.forEach(function (g) { periksaGroup(g, false); });
                hitungProgres();
            }

            function sembunyikanPeringatan() {
                formWarn.style.display = 'none';
            }

            function tampilkanPeringatanForm(pesan) {
                formWarn.textContent = pesan;
                formWarn.style.display = 'block';
            }

            // ---- Ubah nilai lewat stepper ----
            function ubah(input, arah) {
                var teks = input.value.trim().replace(',', '.');
                var angka = Number(teks);
                if (teks === '' || !isFinite(angka)) {
                    angka = 1;
                } else {
                    angka = angka + (arah * LANGKAH);
                }
                angka = Math.round(angka * 100) / 100;
                if (angka > 9) angka = 9;
                if (angka <= 0) return false;

                input.value = formatAngka(angka);
                input.dataset.disentuh = '1';
                periksaGroup(input.closest('.skala-group'), false);
                hitungProgres();
                return true;
            }

            // ---- Event: dropdown urutan ----
            selects.forEach(function (s) {
                s.addEventListener('change', function () {
                    formWarn.style.display = 'none';
                    segarkan();
                });
            });

            // ---- Event: kolom skala ----
            groups.forEach(function (g) {
                var input = inputDari(g);

                input.addEventListener('input', function () {
                    this.value = bersihkanSkala(this.value);
                    periksaGroup(g, false);
                    hitungProgres();
                });

                input.addEventListener('blur', function () {
                    this.dataset.disentuh = '1';
                    periksaGroup(g, false);
                });

                input.addEventListener('keydown', function (e) {
                    if (e.key === 'ArrowUp') { e.preventDefault(); ubah(this, 1); }
                    if (e.key === 'ArrowDown') { e.preventDefault(); ubah(this, -1); }
                });

                Array.prototype.forEach.call(g.querySelectorAll('.chip-nilai'), function (chip) {
                    chip.addEventListener('click', function () {
                        input.value = chip.dataset.nilai;
                        input.dataset.disentuh = '1';
                        periksaGroup(g, false);
                        hitungProgres();
                        input.focus();
                    });
                });
            });

            // ---- Event: tombol +/− (klik, tahan = ulang cepat) ----
            var timerTunda = null;
            var timerUlang = null;

            function berhenti() {
                clearTimeout(timerTunda);
                clearInterval(timerUlang);
                timerTunda = null;
                timerUlang = null;
            }

            form.addEventListener('pointerdown', function (e) {
                var btn = e.target.closest('.btn-skala');
                if (!btn) return;
                e.preventDefault();

                var input = btn.parentElement.querySelector('.input-skala');
                var arah = btn.dataset.aksi === 'tambah' ? 1 : -1;

                berhenti();
                ubah(input, arah);

                timerTunda = setTimeout(function () {
                    timerUlang = setInterval(function () {
                        if (!ubah(input, arah)) berhenti();
                    }, 90);
                }, 400);
            });

            document.addEventListener('pointerup', berhenti);
            document.addEventListener('pointercancel', berhenti);
            form.addEventListener('pointerleave', berhenti);

            // Aktivasi lewat keyboard (Enter/Spasi pada tombol) tidak punya pointerdown.
            form.addEventListener('click', function (e) {
                var btn = e.target.closest('.btn-skala');
                if (!btn || e.detail !== 0) return;
                var input = btn.parentElement.querySelector('.input-skala');
                ubah(input, btn.dataset.aksi === 'tambah' ? 1 : -1);
            });

            // ---- Kosongkan & isi ----
            function kosongkan() {
                bukaSemuaOpsi();
                selects.forEach(function (s) { s.value = ''; });
                groups.forEach(function (g) {
                    var input = inputDari(g);
                    input.value = '';
                    delete input.dataset.disentuh;
                });
                sembunyikanPeringatan();
                segarkan();
            }

            function isi(data) {
                // Penting: kembalikan daftar lengkap dulu, baru set nilai,
                // supaya semua kriteria bisa dipilih sebelum disaring ulang.
                bukaSemuaOpsi();
                selects.forEach(function (s, i) { s.value = data.urutan[i] || ''; });
                groups.forEach(function (g, i) {
                    var input = inputDari(g);
                    input.value = data.nilai[i] !== undefined ? data.nilai[i] : '';
                    delete input.dataset.disentuh;
                });
                sembunyikanPeringatan();
                segarkan();
            }

            form.querySelector('.btn-kosongkan').addEventListener('click', kosongkan);

            // ---- Submit ----
            form.addEventListener('submit', function (e) {
                var pesanForm = null;
                var fokus = null;

                var kosong = selects.filter(function (s) { return !s.value; })[0];
                if (kosong) {
                    pesanForm = 'Semua urutan kriteria harus dipilih terlebih dahulu.';
                    fokus = kosong;
                }

                var semuaSkalaValid = true;
                groups.forEach(function (g) {
                    if (!periksaGroup(g, true)) {
                        semuaSkalaValid = false;
                        if (!fokus) fokus = inputDari(g);
                    }
                });

                if (!semuaSkalaValid && !pesanForm) {
                    pesanForm = 'Masih ada nilai perbandingan yang belum valid. Periksa kolom yang bertanda merah.';
                }

                if (fokus) {
                    e.preventDefault();
                    if (pesanForm) tampilkanPeringatanForm(pesanForm);
                    fokus.focus();
                    return;
                }

                // Cegah klik ganda: tombol dinonaktifkan begitu form dikirim.
                if (submitBtn) submitBtn.disabled = true;
            });

            form._fucom = { kosongkan: kosongkan, isi: isi };
            segarkan();
        }

        Array.prototype.forEach.call(document.querySelectorAll('.form-fucom'), function (form) {
            initForm(form);
        });

        // ==== MODAL ====
        function ambilModal(id) { return document.getElementById(id); }

        window.bukaModalInput = function () {
            var modal = ambilModal('modalInput');
            if (!modal) return;
            var form = modal.querySelector('form');
            form._fucom.kosongkan();
            var btn = form.querySelector('button[type="submit"]');
            if (btn) btn.disabled = false;
            modal.style.display = 'flex';
        };

        window.bukaModalEdit = function () {
            var modal = ambilModal('modalEdit');
            if (!modal || !dataEditFucom) return;
            var form = modal.querySelector('form');
            form._fucom.isi(dataEditFucom);
            var btn = form.querySelector('button[type="submit"]');
            if (btn) btn.disabled = false;
            modal.style.display = 'flex';
        };

        window.tutupModalFucom = function (id) {
            var modal = ambilModal(id);
            if (modal) modal.style.display = 'none';
        };

        Array.prototype.forEach.call(document.querySelectorAll('.modal-overlay'), function (modal) {
            modal.addEventListener('mousedown', function (e) {
                if (e.target === modal) modal.style.display = 'none';
            });
        });

        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape') return;
            Array.prototype.forEach.call(document.querySelectorAll('.modal-overlay'), function (modal) {
                modal.style.display = 'none';
            });
        });
    })();
    </script>

    <!-- ===================== STEPPER (navigasi langkah) ===================== -->
    <script>
        const ADA_DATA = <%- adaData ? 'true' : 'false' %>;
        const INKONSISTEN = <%- inkonsisten ? 'true' : 'false' %>;
        const JUMLAH_STEP = 2;
        const STEP_KEY = 'fucomStep';

        function goStep(n, opsi) {
            n = Number(n) || 1;
            if (n < 1) n = 1;
            if (n > JUMLAH_STEP) n = JUMLAH_STEP;
            if (!ADA_DATA && n > 1) n = 1;

            document.querySelectorAll('.step-pane').forEach(function(p) {
                p.classList.toggle('active', Number(p.dataset.step) === n);
            });

            document.querySelectorAll('.stepper-item').forEach(function(b) {
                const s = Number(b.dataset.step);
                b.classList.toggle('active', s === n);
                b.classList.toggle('selesai', s < n);
                const num = b.querySelector('.stepper-num');
                if (num) num.innerHTML = s < n ? '<i class="bi bi-check-lg"></i>' : String(s);
            });

            // Garis penghubung terisi untuk langkah yang sudah dilewati
            document.querySelectorAll('.stepper-line').forEach(function(l) {
                l.classList.toggle('terisi', Number(l.dataset.line) < n);
            });

            try { sessionStorage.setItem(STEP_KEY, String(n)); } catch (e) {}

            if (!opsi || !opsi.tanpaScroll) {
                window.scrollTo({ top: 0, behavior: 'smooth' });
                const mc = document.querySelector('.main-content');
                if (mc && mc.scrollTo) mc.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        // Pulihkan langkah terakhir saat halaman dimuat.
        // Jika hasil terakhir inkonsisten, langsung tampilkan Langkah 2 agar panduan perbaikan terlihat.
        (function() {
            let awal = 1;
            try { awal = parseInt(sessionStorage.getItem(STEP_KEY), 10) || 1; } catch (e) {}
            if (INKONSISTEN) awal = 2;
            goStep(awal, { tanpaScroll: true });
        })();
    </script>
</body>
</html>