<!DOCTYPE html>
<html lang="id">
<head>
    <title>Perhitungan FUCOM</title>
    <%- include('../partials/head') %>
</head>
<body>
    <div class="app-layout">
        <%- include('../partials/sidebar', { user: user, activePage: activePage }) %>
        <div class="main-content">
            <%- include('../partials/topbar', { user: user, pageTitle: pageTitle }) %>
            <div class="content-wrapper">
                <% if (success) { %>
                    <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
                <% } %>
                <% if (error) { %>
    <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
<% } %>
<% if (terkunci) { %>
    <div class="alert" style="background:#fdf1de; color:#b35c00;">
        <i class="bi bi-lock-fill"></i>
        Pembobotan terkunci karena status siswa telah final.
    </div>
<% } %>
                <!-- Panel Tutorial -->
                <div class="panel" style="background:#f4f8ff;">
                    <div class="panel-header-row" style="cursor:pointer;" onclick="document.getElementById('isiTutorial').classList.toggle('show')">
                        <div class="panel-header">
                            <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-question-circle-fill"></i></div>
                            <h3>Cara Pengisian Data Perbandingan Kriteria</h3>
                        </div>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                    <div id="isiTutorial" class="tutorial-content">
                        <ol style="padding-left:20px; font-size:14px; color:#333; line-height:1.8;">
                            <li>Klik <strong>"Input Data Responden"</strong> dan isi nama guru/pengambil keputusan yang mengisi kuesioner.</li>
                            <li>Urutkan 6 kriteria dari yang <strong>paling penting</strong> ke yang <strong>paling kurang penting</strong> menurut penilaian responden tersebut.</li>
                            <li>Isi nilai perbandingan antar kriteria yang bersebelahan, skala 1-9. Gunakan angka <strong>1-4</strong> untuk selisih yang wajar, dan angka besar (7-9) hanya jika benar-benar yakin ada kesenjangan sangat besar.</li>
                            <li>Ulangi untuk responden berikutnya (minimal 2 responden diperlukan, boleh lebih).</li>
                            <li>Setelah minimal 2 responden lengkap, klik <strong>"Hitung Bobot FUCOM"</strong>.</li>
                        </ol>
                    </div>
                </div>
                <!-- Panel Data Responden -->
                <div class="panel">
                    <div class="panel-header-row">
                        <div class="panel-header">
                            <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-clipboard-data"></i></div>
                            <h3>Data Perbandingan Kriteria (Minimal 2 Responden)</h3>
                        </div>
                        <% if (!terkunci && bobotFinal.length === 0) { %>
                            <button
                                class="btn-primary"
                                onclick="document.getElementById('modalInput').style.display='flex'">
                                <i class="bi bi-plus-lg"></i> Input Data Responden
                            </button>
                        <% } %>
                    </div>
                    <% if (respondenList.length === 0) { %>
                        <p class="empty-state">Belum ada data responden. Klik "Input Data Responden" untuk memasukkan hasil kuesioner dari guru (minimal 2 orang).</p>
                    <% } else { %>
                        <% respondenList.forEach(function(nama) { %>
                            <div style="margin-bottom:20px; padding:15px; background:#fafbfd; border-radius:10px;">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                                    <strong style="font-size:14px; color:#0b2545;"><i class="bi bi-person-fill"></i> <%= nama %></strong>
                                    <% if (!terkunci && bobotFinal.length === 0) { %>
                                        <form action="/admin/fucom/hapus" method="POST" onsubmit="return confirmDelete(this,'Hapus data responden ini?');">
                                            <input type="hidden" name="nama_responden" value="<%= nama %>">
                                            <button type="submit" class="btn-icon btn-icon-danger" title="Hapus">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <span style="color:#999; font-size:12px;">Terkunci</span>
                                    <% } %>
                                </div>
                                <table class="data-table">
                                    <thead><tr><th>Perbandingan</th><th>Nilai</th></tr></thead>
                                    <tbody>
                                        <% dataResponden[nama].forEach(function(p) { %>
                                            <tr>
                                                <td><%= p.nama_kriteria_asal %> vs <%= p.nama_kriteria_pembanding %></td>
                                                <td><strong><%= p.nilai_perbandingan %></strong></td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% }); %>
                        <% if (respondenList.length < 2) { %>
                            <p style="font-size:13px; color:#e67e22;"><i class="bi bi-info-circle-fill"></i> Masih perlu minimal <%= 2 - respondenList.length %> responden lagi sebelum bisa menghitung bobot.</p>
                        <% } %>
                    <% } %>
                </div>
                <!-- Panel Hitung Bobot -->
                <div class="panel">
                    <div class="panel-header-row">
                        <div class="panel-header">
                            <div class="stat-icon icon-orange" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-sliders"></i></div>
                            <h3>Hasil Perhitungan Bobot Kriteria (Agregasi)</h3>
                        </div>
                        <% if (respondenList.length >= 2 && !terkunci && bobotFinal.length === 0) { %>
    <form action="/admin/fucom/hitung" method="POST" onsubmit="return confirmDelete(this, 'PERHATIAN: Setelah bobot dihitung, data responden TIDAK bisa lagi ditambah atau dihapus. Pastikan seluruh data responden sudah benar sebelum melanjutkan. Lanjutkan menghitung bobot?');">
        <button type="submit" class="btn-primary">
            <i class="bi bi-calculator-fill"></i> Hitung Bobot FUCOM
        </button>
    </form>
<% } %>
                    </div>
                    <% if (respondenList.length < 2) { %>
                        <p class="empty-state">Tombol perhitungan akan muncul setelah data 2 responden lengkap. Saat ini: <strong><%= respondenList.length %>/2</strong> responden.</p>
                    <% } else if (bobotFinal.length === 0) { %>
                        <p class="empty-state">
                            <% if (terkunci) { %>
                                Data terkunci, perhitungan tidak dapat dijalankan lagi.
                            <% } else { %>
                                Data sudah lengkap. Klik "Hitung Bobot FUCOM" untuk memulai perhitungan.
                            <% } %>
                        </p>
                    <% } else { %>
                        <% 
                            const bobotTerkecil = Math.min(...bobotFinal.map(b => parseFloat(b.nilai_bobot)));
                        %>
                      <% if (bobotTerkecil < 0.03) { %>
    <div class="alert" style="background:#fdf1de; color:#b35c00;">
        <i class="bi bi-exclamation-triangle-fill"></i> Distribusi bobot sangat timpang, salah satu kriteria memiliki bobot sangat kecil. Pertimbangkan untuk meninjau ulang perbandingan.
    </div>
<% } %>
                        <table class="data-table">
                            <thead><tr><th>Kriteria</th><th>Bobot</th><th>Nilai DFC (rata-rata responden)</th></tr></thead>
                            <tbody>
                                <% bobotFinal.forEach(function(b) { %>
                                    <tr>
                                        <td><%= b.nama_kriteria %></td>
                                        <td><strong><%= b.nilai_bobot < 0.01 ? (b.nilai_bobot * 100).toFixed(3) : (b.nilai_bobot * 100).toFixed(2) %>%</strong></td>
                                        <td>
                                            <span class="badge badge-<%= b.nilai_dfc < 0.1 ? 'lulus' : 'mengundurkan_diri' %>">
                                                <%= parseFloat(b.nilai_dfc).toExponential(4) %>
                                                <%= b.nilai_dfc < 0.1 ? '(Konsisten)' : '(Perlu Ditinjau)' %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } %>
                </div>
                <%- include('../partials/footer') %>
            </div>
        </div>
    </div>
    <!-- Modal Input Data Responden -->
    <% if (!terkunci && bobotFinal.length === 0) { %>
    <div class="modal-overlay" id="modalInput">
        <div class="modal-box" style="max-width:550px;">
            <div class="modal-header">
                <h3><i class="bi bi-clipboard-data"></i> Input Data Kuesioner Responden</h3>
                <button class="modal-close" onclick="document.getElementById('modalInput').style.display='none'">&times;</button>
            </div>
            <form action="/admin/fucom/input" method="POST">
                <label>Nama Responden</label>
                <input type="text" name="nama_responden" required placeholder="Contoh: Desi Wahyuni, S.Pd">
                <p style="font-size:13px; color:#777; margin-top:15px; margin-bottom:10px;">
                    Urutkan kriteria dari yang <strong>paling penting</strong> ke yang <strong>paling kurang penting</strong>.
                </p>
                <% kriteriaList.forEach(function(k, idx) { %>
                    <label>Peringkat <%= idx + 1 %></label>
                    <select name="id_kriteria_urutan" required style="margin-bottom:8px;">
                        <% kriteriaList.forEach(function(k2) { %>
                            <option value="<%= k2.id_kriteria %>"><%= k2.nama_kriteria %></option>
                        <% }); %>
                    </select>
                <% }); %>
                <p style="font-size:13px; color:#777; margin-top:15px; margin-bottom:10px;">
                    Nilai perbandingan antar peringkat berurutan (skala 1-9). <strong>Gunakan nilai moderat (1-4)</strong> kecuali benar-benar yakin ada kesenjangan sangat besar.
                </p>
                <% for (let i = 0; i < kriteriaList.length - 1; i++) { %>
                    <label>Peringkat <%= i + 1 %> dibanding Peringkat <%= i + 2 %></label>
                    <input type="number" name="nilai_perbandingan" min="1" max="9" step="1" required style="margin-bottom:8px;">
                <% } %>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="document.getElementById('modalInput').style.display='none'">Batal</button>
                    <button type="submit" class="btn-primary">Simpan Data</button>
                </div>
            </form>
        </div>
    </div>
    <% } %>
</body>
</html>