<!-- Bar pemberitahuan di bagian bawah layar (menggantikan alert() bawaan browser) -->
<div id="notifFooter" class="notif-footer" role="alert" aria-live="assertive">
    <i id="notifIkon" class="bi bi-exclamation-triangle-fill notif-ikon"></i>
    <div id="notifTeks" class="notif-teks"></div>
    <button type="button" class="notif-tutup" onclick="tutupPemberitahuan()" aria-label="Tutup pemberitahuan">&times;</button>
</div>

<script>
    // ===== PEMBERITAHUAN DI FOOTER =====
    // Menggantikan alert(). tipe: 'peringatan' (kuning) atau 'error' (merah).
    let timerNotif = null;

    function tampilPemberitahuan(pesan, tipe) {
        const bar = document.getElementById('notifFooter');
        const teks = document.getElementById('notifTeks');
        const ikon = document.getElementById('notifIkon');

        // Jika elemen tidak ada (seharusnya tidak terjadi), jatuh kembali ke alert bawaan.
        if (!bar || !teks) {
            alert(pesan);
            return;
        }

        const adalahError = tipe === 'error';

        teks.textContent = pesan;
        bar.classList.toggle('error', adalahError);

        if (ikon) {
            ikon.className = 'bi notif-ikon ' + (adalahError ? 'bi-x-octagon-fill' : 'bi-exclamation-triangle-fill');
        }

        bar.classList.add('tampil');

        clearTimeout(timerNotif);
        timerNotif = setTimeout(tutupPemberitahuan, 7000);
    }

    function tutupPemberitahuan() {
        const bar = document.getElementById('notifFooter');
        if (bar) bar.classList.remove('tampil');
        clearTimeout(timerNotif);
    }

    // ===== MODAL =====
    function bukaModal(id) {
        const modal = document.getElementById(id);
        if (modal) modal.style.display = 'flex';
    }

    function tutupModal(id) {
        const modal = document.getElementById(id);
        if (modal) modal.style.display = 'none';
    }

    document.querySelectorAll('.modal-overlay').forEach(function(modal) {
        modal.addEventListener('click', function(event) {
            if (event.target === modal) modal.style.display = 'none';
        });
    });

    // Buat akun: satu klik, tombol dikunci agar tidak terkirim dua kali.
    function prosesGenerate(form) {
        const button = form.querySelector('button');
        if (button) {
            button.disabled = true;
            button.innerHTML = '<i class="bi bi-hourglass-split"></i> Membuat akun...';
        }
        return true;
    }

    // ===== CHECKLIST MASSAL =====
    function semuaCekboxSiswa() {
        return Array.prototype.slice.call(document.querySelectorAll('.cek-siswa'));
    }

    function cekboxTerlihat() {
        return semuaCekboxSiswa().filter(function(cb) {
            const tr = cb.closest('tr');
            return tr && tr.style.display !== 'none';
        });
    }

    function perbaruiPilihan() {
        const bar = document.getElementById('formMassal');
        const hitungEl = document.getElementById('jumlahDipilih');
        const hitungHeader = document.getElementById('jumlahHapusHeader');
        const cekSemua = document.getElementById('cekSemua');

        const terlihat = cekboxTerlihat();
        const dipilih = semuaCekboxSiswa().filter(function(cb) { return cb.checked; });

        semuaCekboxSiswa().forEach(function(cb) {
            const tr = cb.closest('tr');
            if (tr) tr.classList.toggle('terpilih', cb.checked);
        });

        if (hitungEl) hitungEl.textContent = dipilih.length;
        if (hitungHeader) hitungHeader.textContent = dipilih.length > 0 ? '(' + dipilih.length + ')' : '';
        if (bar) bar.classList.toggle('tampil', dipilih.length > 0);

        // Pemberitahuan "belum ada yang dicentang" tidak relevan lagi setelah ada yang dipilih.
        if (dipilih.length > 0) tutupPemberitahuan();

        if (cekSemua) {
            const terlihatDipilih = terlihat.filter(function(cb) { return cb.checked; }).length;
            cekSemua.checked = terlihat.length > 0 && terlihatDipilih === terlihat.length;
            cekSemua.indeterminate = terlihatDipilih > 0 && terlihatDipilih < terlihat.length;
        }
    }

    function pilihSemuaTampil() {
        cekboxTerlihat().forEach(function(cb) { cb.checked = true; });
        perbaruiPilihan();
    }

    function batalPilih() {
        semuaCekboxSiswa().forEach(function(cb) { cb.checked = false; });
        perbaruiPilihan();
    }

    // Tombol mana yang ditekan (Berminat / Tidak Berminat). Diisi saat tombol diklik,
    // sebelum event submit berjalan.
    let statusMassalDipilih = 'berminat';

    function setStatusMassal(status) {
        statusMassalDipilih = status === 'tidak_berminat' ? 'tidak_berminat' : 'berminat';
    }

    // Konfirmasi minat massal: hanya siswa yang punya akun dan masih "Belum merespons"
    // (data-minat-ok = 1) yang dikirim. Sisanya dilewati.
    function kirimMassal(form) {
        // Hapus input lama (jika sebelumnya batal), lalu isi ulang dari checkbox yang dicentang.
        form.querySelectorAll('input[name="id_siswa"], input[name="status_minat"]').forEach(function(el) { el.remove(); });

        const dipilihSemua = semuaCekboxSiswa().filter(function(cb) { return cb.checked; });

        if (dipilihSemua.length === 0) {
            tampilPemberitahuan('Centang minimal satu siswa terlebih dahulu.', 'peringatan');
            return false;
        }

        const dipilih = dipilihSemua.filter(function(cb) { return cb.getAttribute('data-minat-ok') === '1'; });
        const dilewati = dipilihSemua.length - dipilih.length;

        if (dipilih.length === 0) {
            tampilPemberitahuan('Tidak ada siswa terpilih yang bisa diubah status minatnya. Hanya siswa yang punya akun dan masih "Belum merespons" yang bisa diubah.', 'peringatan');
            return false;
        }

        dipilih.forEach(function(cb) {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'id_siswa';
            input.value = cb.value;
            form.appendChild(input);
        });

        // Status dikirim lewat input tersembunyi agar tetap terbawa
        // walaupun form dikirim ulang oleh dialog konfirmasi.
        const status = statusMassalDipilih;
        const inputStatus = document.createElement('input');
        inputStatus.type = 'hidden';
        inputStatus.name = 'status_minat';
        inputStatus.value = status;
        form.appendChild(inputStatus);

        let pesan = status === 'tidak_berminat'
            ? 'Yakin mengonfirmasi ' + dipilih.length + ' siswa ini sebagai TIDAK BERMINAT? ' +
              'Mereka tidak ikut perankingan, akun mereka dinonaktifkan, dan status ini tidak dapat diubah lagi.'
            : 'Yakin mengonfirmasi ' + dipilih.length + ' siswa ini sebagai BERMINAT? ' +
              'Mereka akan ikut perankingan dan status ini tidak dapat diubah lagi.';

        if (dilewati > 0) {
            pesan += ' (' + dilewati + ' siswa lain yang dicentang tidak memenuhi syarat dan akan dilewati.)';
        }

        return confirmDelete(form, pesan);
    }

    // ===== HAPUS MASSAL =====
    // Dipanggil dari onsubmit #formHapusMassal. Mengisi id siswa yang dicentang,
    // lalu meminta konfirmasi lewat dialog yang sama dengan tombol hapus per baris.
    function kirimHapusMassal(form) {
        form.querySelectorAll('input[name="id_siswa"]').forEach(function(el) { el.remove(); });

        const dipilih = semuaCekboxSiswa().filter(function(cb) { return cb.checked; });

        if (dipilih.length === 0) {
            tampilPemberitahuan('Centang minimal satu siswa yang ingin dihapus.', 'peringatan');
            return false;
        }

        dipilih.forEach(function(cb) {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'id_siswa';
            input.value = cb.value;
            form.appendChild(input);
        });

        const contoh = dipilih.slice(0, 3).map(function(cb) { return cb.getAttribute('data-nama-siswa'); }).join(', ');
        const sisa = dipilih.length - 3;
        const daftarNama = sisa > 0 ? contoh + ' dan ' + sisa + ' lainnya' : contoh;

        const pesan = 'PERHATIAN: ' + dipilih.length + ' siswa terpilih (' + daftarNama + ') akan dihapus PERMANEN ' +
            'beserta akun dan seluruh nilainya. Hasil ranking sebelumnya juga dikosongkan. ' +
            'Tindakan ini tidak dapat dibatalkan. Lanjutkan menghapus?';

        return confirmDelete(form, pesan);
    }

    // Tombol "Hapus Terpilih" di header: sama dengan tombol di bar aksi massal.
    function hapusTerpilih() {
        const form = document.getElementById('formHapusMassal');
        if (!form) return;

        const adaDipilih = semuaCekboxSiswa().some(function(cb) { return cb.checked; });

        if (!adaDipilih) {
            tampilPemberitahuan('Centang dulu siswa yang ingin dihapus pada tabel di bawah, atau gunakan kotak di header tabel untuk memilih semua yang tampil.', 'peringatan');
            const tabel = document.getElementById('tabelSiswa');
            if (tabel && tabel.scrollIntoView) tabel.scrollIntoView({ behavior: 'smooth', block: 'start' });
            return;
        }

        if (typeof form.requestSubmit === 'function') {
            form.requestSubmit();
        } else if (kirimHapusMassal(form) === true) {
            form.submit();
        }
    }

    (function() {
        const cekSemua = document.getElementById('cekSemua');

        if (cekSemua) {
            cekSemua.addEventListener('change', function() {
                cekboxTerlihat().forEach(function(cb) { cb.checked = cekSemua.checked; });
                perbaruiPilihan();
            });
        }

        semuaCekboxSiswa().forEach(function(cb) {
            cb.addEventListener('change', perbaruiPilihan);
        });
    })();

    // ===== PENCARIAN DAN FILTER =====
    (function() {
        const inputCari = document.getElementById('searchSiswa');
        const selectFilter = document.getElementById('filterStatus');
        const selectMinat = document.getElementById('filterMinat');
        const barisKosong = document.getElementById('barisKosongCari');
        const hitungEl = document.getElementById('hitungTampil');

        function terapkanFilter() {
            const kata = inputCari.value.trim().toLowerCase();
            const status = selectFilter.value;
            const minat = selectMinat.value;
            let tampil = 0;

            document.querySelectorAll('.baris-siswa').forEach(function(row) {
                const nama = row.dataset.nama || '';
                const nisn = row.dataset.nisn || '';

                const cocok =
                    (!kata || nama.includes(kata) || nisn.includes(kata)) &&
                    (!status || row.dataset.status === status) &&
                    (!minat || row.dataset.minat === minat);

                row.style.display = cocok ? '' : 'none';

                if (cocok) {
                    tampil++;
                    const nomor = row.querySelector('.no-urut');
                    if (nomor) nomor.textContent = tampil;
                } else {
                    // Baris yang tersembunyi tidak boleh ikut terkirim (minat maupun hapus).
                    const cb = row.querySelector('.cek-siswa');
                    if (cb) cb.checked = false;
                }
            });

            if (barisKosong) barisKosong.style.display = tampil === 0 ? '' : 'none';
            if (hitungEl) hitungEl.textContent = tampil + ' siswa ditampilkan';

            perbaruiPilihan();
        }

        inputCari.addEventListener('input', terapkanFilter);
        selectFilter.addEventListener('change', terapkanFilter);
        selectMinat.addEventListener('change', terapkanFilter);

        selectFilter.value = <%- JSON.stringify(filterAwalVal) %>;

        // Filter status minat dari tautan dashboard, contoh: /admin/siswa?minat=belum_respon
        try {
            const minatAwal = new URLSearchParams(window.location.search).get('minat');
            if (minatAwal && Array.prototype.some.call(selectMinat.options, function(o) { return o.value === minatAwal; })) {
                selectMinat.value = minatAwal;
            }
        } catch (e) { /* abaikan */ }

        terapkanFilter();
    })();

    // ===== MODAL EDIT =====
    function bukaModalEdit(button) {
        let s;

        try {
            s = JSON.parse(decodeURIComponent(button.dataset.siswa));
        } catch (error) {
            tampilPemberitahuan('Data siswa tidak dapat dibaca. Muat ulang halaman.', 'error');
            return;
        }

        document.getElementById('edit_id_siswa').value = s.id_siswa || '';
        document.getElementById('edit_nisn').value = s.nisn || '';
        document.getElementById('edit_nama').value = s.nama || '';
        document.getElementById('edit_jk').value = s.jenis_kelamin || 'L';
        document.getElementById('edit_sekolah').value = s.sekolah_asal || '';
        document.getElementById('edit_ayah').value = s.pekerjaan_ayah || '';
        document.getElementById('edit_ibu').value = s.pekerjaan_ibu || '';
        document.getElementById('edit_pip').value = Number(s.status_pip_pkh) === 1 ? 'ya' : 'tidak';

        const peringatan = document.getElementById('peringatan_siswa_edit');
        peringatan.textContent = '';
        peringatan.style.display = 'none';

        bukaModal('modalEdit');
    }

    // ===== VALIDASI INPUT =====
    const PANJANG_NISN = 10; // samakan dengan PANJANG_NISN di siswaController (null = tidak dibatasi)
    const REGEX_ANGKA_SAJA = /^[0-9]+$/;
    const REGEX_HURUF_SAJA_SISWA = /^[A-Za-zÀ-ÖØ-öø-ÿ]+(?: [A-Za-zÀ-ÖØ-öø-ÿ]+)*$/;
    const REGEX_SEKOLAH_SISWA = /^[A-Za-zÀ-ÖØ-öø-ÿ0-9]+(?: [A-Za-zÀ-ÖØ-öø-ÿ0-9]+)*$/;

    // Jenjang sekolah asal: hanya SMP / MTs / SMPLB / Paket B.
    // Kata jenjang PERTAMA yang ditemukan di teks menentukan hasilnya
    // (mis. "SMA Negeri 1" ditolak, "SMPN 3 Padang" diterima).
    const JENJANG_DIIZINKAN = ['SMP', 'SMPN', 'SMPS', 'SMPIT', 'SMPLB', 'MTS', 'MTSN', 'MTSS', 'PAKETB'];
    const JENJANG_DITOLAK = ['SMA', 'SMAN', 'SMAS', 'SMAIT', 'SMALB', 'SMK', 'SMKN', 'SMKS',
        'MA', 'MAN', 'MAS', 'MAK', 'SD', 'SDN', 'SDS', 'SDIT', 'SDLB', 'MI', 'MIN', 'MIS',
        'PAKETA', 'PAKETC', 'TK', 'PAUD'];

    function sekolahAsalValid(teks) {
        let s = String(teks || '').toUpperCase().replace(/\s+/g, ' ').trim();
        s = s.replace(/\bPAKET\s+([ABC])\b/g, 'PAKET$1')
             .replace(/\bSMP\s+LB\b/g, 'SMPLB')
             .replace(/\bSMA\s+LB\b/g, 'SMALB')
             .replace(/\bSD\s+LB\b/g, 'SDLB');

        const kata = s.split(' ');
        for (let i = 0; i < kata.length; i++) {
            const m = kata[i].match(/^([A-Z]+)\d*$/);
            if (!m) continue;
            if (JENJANG_DIIZINKAN.indexOf(m[1]) !== -1) return true;
            if (JENJANG_DITOLAK.indexOf(m[1]) !== -1) return false;
        }
        return false;
    }

    function sanitizeAngka(input) {
        input.value = input.value.replace(/[^0-9]/g, '');
    }

    function sanitizeHurufSiswa(input) {
        let val = input.value.replace(/[^A-Za-zÀ-ÖØ-öø-ÿ\s]/g, '');
        input.value = val.replace(/\s{2,}/g, ' ');
    }

    function sanitizeSekolahSiswa(input) {
        let val = input.value.replace(/[^A-Za-zÀ-ÖØ-öø-ÿ0-9\s]/g, '');
        input.value = val.replace(/\s{2,}/g, ' ');
    }

    ['nisn_tambah', 'edit_nisn'].forEach(function(id) {
        const el = document.getElementById(id);
        if (el) el.addEventListener('input', function() { sanitizeAngka(this); });
    });

    ['nama_tambah', 'ayah_tambah', 'ibu_tambah', 'edit_nama', 'edit_ayah', 'edit_ibu'].forEach(function(id) {
        const el = document.getElementById(id);
        if (el) el.addEventListener('input', function() { sanitizeHurufSiswa(this); });
    });

    ['sekolah_tambah', 'edit_sekolah'].forEach(function(id) {
        const el = document.getElementById(id);
        if (el) el.addEventListener('input', function() { sanitizeSekolahSiswa(this); });
    });

    function validasiFormSiswa(form) {
        const isEdit = form.querySelector('#edit_id_siswa') !== null;
        const peringatanEl = document.getElementById(isEdit ? 'peringatan_siswa_edit' : 'peringatan_siswa_tambah');

        const nisnVal = form.elements.nisn.value.trim();
        const namaVal = form.elements.nama.value.trim();
        const sekolahVal = form.elements.sekolah_asal.value.trim();
        const ayahVal = form.elements.pekerjaan_ayah.value.trim();
        const ibuVal = form.elements.pekerjaan_ibu.value.trim();

        function gagal(pesan, field) {
            peringatanEl.textContent = pesan;
            peringatanEl.style.display = 'block';
            if (field) field.focus();
            return false;
        }

        peringatanEl.textContent = '';
        peringatanEl.style.display = 'none';

        if (!nisnVal || !REGEX_ANGKA_SAJA.test(nisnVal)) return gagal('NISN wajib diisi dan hanya boleh berisi angka.', form.elements.nisn);
        if (PANJANG_NISN && nisnVal.length !== PANJANG_NISN) return gagal('NISN harus tepat ' + PANJANG_NISN + ' digit angka.', form.elements.nisn);
        if (!namaVal || !REGEX_HURUF_SAJA_SISWA.test(namaVal)) return gagal('Nama wajib diisi dan hanya boleh berisi huruf serta spasi.', form.elements.nama);
        if (!sekolahVal || !REGEX_SEKOLAH_SISWA.test(sekolahVal)) return gagal('Sekolah asal wajib diisi dengan huruf, angka, dan spasi.', form.elements.sekolah_asal);
        if (!sekolahAsalValid(sekolahVal)) return gagal('Sekolah asal hanya boleh SMP / MTs / SMPLB / Paket B (contoh: SMPN 1 Padang). Data SMA/SMK/MA tidak diterima.', form.elements.sekolah_asal);

        // Pekerjaan orang tua OPSIONAL: kosong = otomatis "Tidak bekerja" di server.
        if (ayahVal && !REGEX_HURUF_SAJA_SISWA.test(ayahVal)) return gagal('Pekerjaan ayah hanya boleh berisi huruf dan spasi (boleh dikosongkan).', form.elements.pekerjaan_ayah);
        if (ibuVal && !REGEX_HURUF_SAJA_SISWA.test(ibuVal)) return gagal('Pekerjaan ibu hanya boleh berisi huruf dan spasi (boleh dikosongkan).', form.elements.pekerjaan_ibu);

        form.elements.nisn.value = nisnVal;
        form.elements.nama.value = namaVal;
        form.elements.sekolah_asal.value = sekolahVal;
        form.elements.pekerjaan_ayah.value = ayahVal;
        form.elements.pekerjaan_ibu.value = ibuVal;

        return true;
    }
</script>
</body>
</html>