<!DOCTYPE html>
<html lang="id">
<head>
    <title>Input Nilai Siswa</title>
    <%- include('../partials/head') %>
    <style>
        .badge-st { display:inline-block; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:600; white-space:nowrap; }
        .badge-st.berminat { background:#e2f8ea; color:#1e8449; }
        .badge-st.belum_respon { background:#fdf1de; color:#b35c00; }
        .badge-st.tidak_berminat { background:#fde8e8; color:#b3261e; }
        .badge-st.tanpa_akun { background:#eceff3; color:#5b6573; }
        .btn-nonaktif { opacity:.45; cursor:not-allowed !important; pointer-events:none; }

        .table-scroll-x { overflow-x:auto; }
        .sel-nilai { text-align:center; font-weight:600; white-space:nowrap; }
        .sel-nilai.kosong { color:#aaa; font-weight:400; }
        .teks-kunci { color:#8a6d3b; font-size:12px; white-space:nowrap; }

        /* ===== Pencarian & filter ===== */
        .toolbar-nilai { display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:6px; }
        .cari-wrap { position:relative; flex:1; min-width:240px; max-width:400px; }
        .cari-wrap > i.bi-search { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#9aa5b8; font-size:14px; pointer-events:none; }
        .cari-wrap input {
            width:100%; padding:10px 34px 10px 36px; border:1px solid #ddd; border-radius:8px;
            font-size:14px; outline:none; font-family:inherit;
        }
        .cari-wrap input:focus { border-color:#1d5fd6; box-shadow:0 0 0 3px rgba(29,95,214,.12); }
        .btn-bersih-cari {
            position:absolute; right:6px; top:50%; transform:translateY(-50%);
            background:none; border:none; font-size:20px; line-height:1; color:#9aa5b8; cursor:pointer; padding:2px 8px;
        }
        .btn-bersih-cari:hover { color:#e74c3c; }
        .toolbar-nilai select {
            padding:10px 12px; border:1px solid #ddd; border-radius:8px; font-size:14px;
            background:#fff; outline:none; font-family:inherit;
        }
        .toolbar-nilai select:focus { border-color:#1d5fd6; }
        .info-hitung-nilai { font-size:13px; color:#667; }
        .hint-cari { font-size:12px; color:#9aa5b8; margin-bottom:14px; }
        .cari-kecil { margin-bottom:10px; max-width:340px; }
        .cari-kecil input { padding-top:8px; padding-bottom:8px; }
    </style>
</head>
<body>
<%
    const belumRespon = Number(typeof jumlahBelumRespon !== 'undefined' ? jumlahBelumRespon : 0);

    // Input nilai TIDAK berhubungan dengan FUCOM.
    // Aktif jika sudah ada data siswa DAN tidak ada lagi siswa yang belum merespons.
    const adaSiswa = Array.isArray(siswaList) && siswaList.length > 0;
    const terblokir = !terkunci && (!adaSiswa || belumRespon > 0);
    const alasanBlokir = !adaSiswa
        ? 'Nonaktif: belum ada data siswa'
        : 'Nonaktif: masih ada ' + belumRespon + ' siswa yang belum merespons';

    const daftarKriteria = (typeof kriteriaList !== 'undefined' && Array.isArray(kriteriaList)) ? kriteriaList : [];
    const petaNilai = (typeof nilaiMap !== 'undefined' && nilaiMap) ? nilaiMap : {};

    // Setelah finalisasi, nilai tiap kriteria ditampilkan di tabel (hanya baca).
    const tampilNilai = !!terkunci && daftarKriteria.length > 0;
    const jumlahKolom = 6 + (tampilNilai ? daftarKriteria.length : 0);

    const labelMinat = { berminat:'Berminat', belum_respon:'Belum merespons', tidak_berminat:'Tidak berminat', tanpa_akun:'Belum ada akun' };
    const kunciMinat = function(s) { return !s.punya_akun ? 'tanpa_akun' : (s.status_minat || 'belum_respon'); };

    const bisaIsi = function(s) {
        return !terkunci && !terblokir && s.status_minat !== 'tidak_berminat';
    };

    // Format angka nilai: bulat tampil bulat, desimal tampil 2 angka.
    const formatNilai = function(v) {
        if (v === null || v === undefined || v === '') return null;
        const n = Number(v);
        if (!Number.isFinite(n)) return null;
        return Number.isInteger(n) ? String(n) : n.toFixed(2);
    };

    const ambilNilai = function(s, k) {
        const baris = petaNilai[String(s.id_siswa)];
        if (!baris) return null;
        return formatNilai(baris[String(k.id_kriteria)]);
    };

    const belumLengkap = siswaList.filter(function(s) {
        return s.status_minat !== 'tidak_berminat' && s.jumlah_terisi < s.total_kriteria;
    });
%>
    <div class="app-layout">
        <%- include('../partials/sidebar', { user: user, activePage: activePage }) %>
        <div class="main-content">
            <%- include('../partials/topbar', { user: user, pageTitle: pageTitle }) %>
            <div class="content-wrapper">

                <div class="panel" style="background:#f4f8ff;">
                    <div class="panel-header-row" style="cursor:pointer;" onclick="document.getElementById('tutorialNilai').classList.toggle('show')">
                        <div class="panel-header">
                            <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-question-circle-fill"></i></div>
                            <h3>Cara Mengisi Nilai Siswa</h3>
                        </div>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                    <div id="tutorialNilai" class="tutorial-content">
                        <ol style="padding-left:20px; font-size:14px; color:#333; line-height:1.8;">
                            <li>Pastikan <strong>data siswa sudah ada</strong> di menu Data Siswa.</li>
                            <li>Pastikan <strong>tidak ada siswa yang Belum merespons</strong>. Selesaikan di menu Data Siswa (operator dapat mengubah statusnya menjadi Berminat atau Tidak berminat).</li>
                            <li>Klik <strong>Unduh Template</strong>, isi nilai sesuai NISN, lalu <strong>Import Nilai (Excel)</strong>. Atau klik ikon pensil untuk mengisi satu per satu.</li>
                            <li>Gunakan kotak <strong>cari NISN atau nama</strong> di atas tabel untuk menemukan siswa dengan cepat. Jika hasil tinggal satu siswa, tekan <strong>Enter</strong> untuk langsung membuka form nilainya.</li>
                            <li>Siswa yang berstatus <strong>tidak berminat</strong> tidak bisa dinilai dan tidak ikut perankingan.</li>
                            <li>Nilai masih bisa diubah sampai hasil seleksi difinalisasi. Setiap perubahan mengosongkan hasil ranking, jadi perlu dihitung ulang.</li>
                            <li>Setelah finalisasi, nilai setiap siswa tampil langsung di tabel di bawah, tetapi terkunci dan tidak bisa diubah lagi.</li>
                        </ol>
                    </div>
                </div>

                <% if (terkunci) { %>
                    <div class="alert" style="background:#fdf1de; color:#b35c00; margin-bottom:15px;">
                        <i class="bi bi-lock-fill"></i> Hasil seleksi sudah difinalisasi. Seluruh nilai terkunci dan hanya bisa dilihat di tabel.
                    </div>
                <% } else if (!adaSiswa) { %>
                    <div class="alert" style="background:#fdf1de; color:#b35c00; margin-bottom:15px;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Import nilai dan input nilai dinonaktifkan karena <strong>belum ada data siswa</strong>.
                        Tambahkan di menu <a href="/operator/siswa" style="font-weight:600;">Data Siswa</a>.
                    </div>
                <% } else if (belumRespon > 0) { %>
                    <div class="alert" style="background:#fdf1de; color:#b35c00; margin-bottom:15px;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Import nilai dan input nilai dinonaktifkan karena masih ada
                        <strong><%= belumRespon %> siswa</strong> yang belum merespons.
                        Selesaikan di menu <a href="/operator/siswa" style="font-weight:600;">Data Siswa</a>.
                    </div>
                <% } %>

                <% if (success) { %>
                    <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
                <% } %>

                <% if (belumLengkap.length > 0) { %>
                <div class="panel" style="border-left:4px solid #e67e22;">
                    <div class="panel-header-row" style="cursor:pointer;" onclick="toggleBelumLengkap()">
                        <div class="panel-header">
                            <div class="stat-icon icon-orange" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-exclamation-triangle-fill"></i></div>
                            <h3>Siswa Belum Lengkap Nilai (<%= belumLengkap.length %>)</h3>
                        </div>
                        <i class="bi bi-chevron-down" id="iconBelumLengkap"></i>
                    </div>
                    <div id="belumLengkapContent" style="display:none; max-height:420px; overflow-y:auto; margin-top:10px;">
                        <div class="cari-wrap cari-kecil">
                            <i class="bi bi-search"></i>
                            <input type="text" id="cariBelumLengkap" placeholder="Cari NISN atau nama..." autocomplete="off">
                        </div>
                        <table class="data-table">
                            <thead><tr><th>NISN</th><th>Nama</th><th>Kelengkapan</th><th>Aksi</th></tr></thead>
                            <tbody id="bodyBelumLengkap">
                                <% belumLengkap.forEach(function(s) { %>
                                    <tr class="baris-bl"
                                        data-nisn="<%= s.nisn %>"
                                        data-nama="<%= (s.nama || '').toLowerCase() %>">
                                        <td><%= s.nisn %></td>
                                        <td><%= s.nama %></td>
                                        <td><span class="badge badge-red"><%= s.jumlah_terisi %> / <%= s.total_kriteria %></span></td>
                                        <td>
                                            <% if (bisaIsi(s)) { %>
                                                <a href="/operator/nilai/<%= s.id_siswa %>" class="btn-icon" title="Lengkapi"><i class="bi bi-pencil-square"></i></a>
                                            <% } else if (terblokir) { %>
                                                <span class="btn-icon btn-nonaktif" title="<%= alasanBlokir %>"><i class="bi bi-pencil-square"></i></span>
                                            <% } else { %>
                                                <span class="teks-kunci"><i class="bi bi-lock-fill"></i> Terkunci</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                                <tr id="barisKosongBL" style="display:none;">
                                    <td colspan="4" class="empty-state">Tidak ada siswa yang cocok dengan pencarian.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <% } %>

                <div class="panel">
                    <div class="panel-header-row">
                        <div class="panel-header">
                            <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-pencil-square"></i></div>
                            <h3><%= terkunci ? 'Nilai Siswa per Kriteria (Terkunci)' : 'Input Nilai Siswa per Kriteria' %></h3>
                        </div>
                        <div style="display:flex; gap:10px;">
                            <a href="/operator/nilai/template" class="btn-secondary" style="text-decoration:none; display:flex; align-items:center; gap:6px;">
                                <i class="bi bi-download"></i> Unduh Template
                            </a>
                            <% if (!terkunci) { %>
                                <% if (terblokir) { %>
                                    <button type="button" class="btn-primary" disabled
                                            style="opacity:.5; cursor:not-allowed;"
                                            title="<%= alasanBlokir %>">
                                        <i class="bi bi-file-earmark-excel-fill"></i> Import Nilai (Excel)
                                    </button>
                                <% } else { %>
                                    <button type="button" class="btn-primary" onclick="document.getElementById('modalImportNilai').style.display='flex'">
                                        <i class="bi bi-file-earmark-excel-fill"></i> Import Nilai (Excel)
                                    </button>
                                <% } %>
                            <% } %>
                        </div>
                    </div>

                    <!-- Pencarian & filter -->
                    <div class="toolbar-nilai">
                        <div class="cari-wrap">
                            <i class="bi bi-search"></i>
                            <input type="text" id="cariNilai" placeholder="Cari NISN atau nama siswa..." autocomplete="off" inputmode="search" aria-label="Cari NISN atau nama siswa">
                            <button type="button" id="bersihCari" class="btn-bersih-cari" title="Bersihkan pencarian" aria-label="Bersihkan pencarian" style="display:none;">&times;</button>
                        </div>

                        <select id="filterKelengkapan" aria-label="Filter kelengkapan nilai">
                            <option value="">Semua kelengkapan</option>
                            <option value="lengkap">Nilai lengkap</option>
                            <option value="belum">Belum lengkap</option>
                        </select>

                        <select id="filterMinatNilai" aria-label="Filter status minat">
                            <option value="">Semua status minat</option>
                            <option value="berminat">Berminat</option>
                            <option value="belum_respon">Belum merespons</option>
                            <option value="tidak_berminat">Tidak berminat</option>
                            <option value="tanpa_akun">Belum ada akun</option>
                        </select>

                        <span id="hitungNilai" class="info-hitung-nilai"></span>
                    </div>
                    <p class="hint-cari"><i class="bi bi-lightbulb-fill"></i> Tekan <strong>Enter</strong> saat hasil tinggal satu siswa untuk langsung membuka form nilainya.</p>

                    <div class="table-scroll-x">
                        <table class="data-table" id="tabelNilai">
                            <thead>
                                <tr>
                                    <th>No</th>
                                    <th>NISN</th>
                                    <th>Nama</th>
                                    <th>Status Minat</th>
                                    <th>Kelengkapan Nilai</th>
                                    <% if (tampilNilai) { %>
                                        <% daftarKriteria.forEach(function(k) { %>
                                            <th style="text-align:center;"><%= k.nama_kriteria || k.id_kriteria %></th>
                                        <% }); %>
                                    <% } %>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="bodyNilai">
                                <% if (siswaList.length === 0) { %>
                                    <tr><td colspan="<%= jumlahKolom %>" class="empty-state">Belum ada data siswa. Tambahkan siswa terlebih dahulu di menu Data Siswa.</td></tr>
                                <% } %>

                                <% siswaList.forEach(function(s, index) {
                                    const k = kunciMinat(s);
                                    const lengkapSemua = s.total_kriteria > 0 && s.jumlah_terisi >= s.total_kriteria;
                                %>
                                    <tr class="baris-nilai"
                                        data-nisn="<%= s.nisn %>"
                                        data-nama="<%= (s.nama || '').toLowerCase() %>"
                                        data-minat="<%= k %>"
                                        data-lengkap="<%= lengkapSemua ? '1' : '0' %>">
                                        <td class="no-urut"><%= index + 1 %></td>
                                        <td><%= s.nisn %></td>
                                        <td><%= s.nama %></td>
                                        <td><span class="badge-st <%= k %>"><%= labelMinat[k] %></span></td>
                                        <td>
                                            <span class="badge badge-<%= lengkapSemua ? 'green' : 'red' %>">
                                                <%= s.jumlah_terisi %> / <%= s.total_kriteria %> kriteria
                                            </span>
                                        </td>

                                        <% if (tampilNilai) { %>
                                            <% daftarKriteria.forEach(function(kr) {
                                                const nilaiTampil = ambilNilai(s, kr);
                                            %>
                                                <% if (nilaiTampil !== null) { %>
                                                    <td class="sel-nilai"><%= nilaiTampil %></td>
                                                <% } else { %>
                                                    <td class="sel-nilai kosong">-</td>
                                                <% } %>
                                            <% }); %>
                                        <% } %>

                                        <td>
                                            <% if (terkunci) { %>
                                                <span class="teks-kunci"><i class="bi bi-lock-fill"></i> Terkunci</span>
                                            <% } else if (s.status_minat === 'tidak_berminat') { %>
                                                <span style="color:#999; font-size:12px;">Tidak ikut</span>
                                            <% } else if (terblokir) { %>
                                                <span class="btn-icon btn-nonaktif" title="<%= alasanBlokir %>">
                                                    <i class="bi bi-pencil-square"></i>
                                                </span>
                                            <% } else { %>
                                                <a href="/operator/nilai/<%= s.id_siswa %>" class="btn-icon" title="Isi Nilai"><i class="bi bi-pencil-square"></i></a>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>

                                <tr id="barisKosongNilai" style="display:none;">
                                    <td colspan="<%= jumlahKolom %>" class="empty-state">Tidak ada siswa yang cocok dengan pencarian atau filter.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <%- include('../partials/footer') %>
            </div>
        </div>
    </div>

    <% if (!terkunci && !terblokir) { %>
    <div class="modal-overlay" id="modalImportNilai">
        <div class="modal-box">
            <div class="modal-header">
                <h3><i class="bi bi-file-earmark-excel-fill"></i> Import Nilai dari Excel</h3>
                <button type="button" class="modal-close" onclick="document.getElementById('modalImportNilai').style.display='none'">&times;</button>
            </div>
            <form action="/operator/nilai/import" method="POST" enctype="multipart/form-data">
                <p style="font-size:13px; color:#777; margin-bottom:15px;">
                    Nilai dicocokkan berdasarkan kolom <strong>NISN</strong>.
                    Siswa yang tidak berminat dilewati.
                </p>
                <label>Pilih File Excel (.xlsx / .xls)</label>
                <input type="file" name="fileExcel" accept=".xlsx,.xls" required>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="document.getElementById('modalImportNilai').style.display='none'">Batal</button>
                    <button type="submit" class="btn-primary">Import Sekarang</button>
                </div>
            </form>
        </div>
    </div>
    <% } %>

    <script>
        function toggleBelumLengkap() {
            const el = document.getElementById('belumLengkapContent');
            const icon = document.getElementById('iconBelumLengkap');
            el.style.display = (el.style.display === 'none' || !el.style.display) ? 'block' : 'none';
            icon.classList.toggle('bi-chevron-up');
        }

        // ===== Pencarian & filter tabel utama =====
        (function () {
            const input = document.getElementById('cariNilai');
            if (!input) return;

            const tombolBersih = document.getElementById('bersihCari');
            const selLengkap = document.getElementById('filterKelengkapan');
            const selMinat = document.getElementById('filterMinatNilai');
            const hitungEl = document.getElementById('hitungNilai');
            const barisKosong = document.getElementById('barisKosongNilai');
            const rows = Array.prototype.slice.call(document.querySelectorAll('#bodyNilai tr.baris-nilai'));

            function terapkan() {
                const kata = input.value.trim().toLowerCase();
                const lengkap = selLengkap.value;
                const minat = selMinat.value;
                let tampil = 0;

                rows.forEach(function (row) {
                    const nisn = (row.dataset.nisn || '').toLowerCase();
                    const nama = row.dataset.nama || '';

                    const cocokKata = !kata || nisn.indexOf(kata) !== -1 || nama.indexOf(kata) !== -1;
                    const cocokLengkap =
                        !lengkap ||
                        (lengkap === 'lengkap' && row.dataset.lengkap === '1') ||
                        (lengkap === 'belum' && row.dataset.lengkap !== '1');
                    const cocokMinat = !minat || row.dataset.minat === minat;

                    const cocok = cocokKata && cocokLengkap && cocokMinat;
                    row.style.display = cocok ? '' : 'none';

                    if (cocok) {
                        tampil++;
                        const nomor = row.querySelector('.no-urut');
                        if (nomor) nomor.textContent = tampil;
                    }
                });

                if (barisKosong) barisKosong.style.display = (rows.length > 0 && tampil === 0) ? '' : 'none';
                if (hitungEl) hitungEl.textContent = rows.length > 0 ? tampil + ' dari ' + rows.length + ' siswa ditampilkan' : '';
                if (tombolBersih) tombolBersih.style.display = input.value ? '' : 'none';
            }

            input.addEventListener('input', terapkan);
            selLengkap.addEventListener('change', terapkan);
            selMinat.addEventListener('change', terapkan);

            if (tombolBersih) {
                tombolBersih.addEventListener('click', function () {
                    input.value = '';
                    terapkan();
                    input.focus();
                });
            }

            // Enter: jika hanya satu siswa yang tampil dan bisa diisi, langsung buka form nilainya.
            input.addEventListener('keydown', function (e) {
                if (e.key !== 'Enter') return;
                e.preventDefault();

                const terlihat = rows.filter(function (r) { return r.style.display !== 'none'; });
                if (terlihat.length !== 1) return;

                const link = terlihat[0].querySelector('a[href^="/operator/nilai/"]');
                if (link) window.location.href = link.getAttribute('href');
            });

            // Dukungan tautan, contoh: /operator/nilai?q=0095924661
            try {
                const q = new URLSearchParams(window.location.search).get('q');
                if (q) input.value = q;
            } catch (e) { /* abaikan */ }

            terapkan();
        })();

        // ===== Pencarian di panel "Siswa Belum Lengkap Nilai" =====
        (function () {
            const input = document.getElementById('cariBelumLengkap');
            if (!input) return;

            const rows = Array.prototype.slice.call(document.querySelectorAll('#bodyBelumLengkap tr.baris-bl'));
            const kosong = document.getElementById('barisKosongBL');

            input.addEventListener('input', function () {
                const kata = input.value.trim().toLowerCase();
                let tampil = 0;

                rows.forEach(function (row) {
                    const cocok = !kata ||
                        (row.dataset.nisn || '').toLowerCase().indexOf(kata) !== -1 ||
                        (row.dataset.nama || '').indexOf(kata) !== -1;
                    row.style.display = cocok ? '' : 'none';
                    if (cocok) tampil++;
                });

                if (kosong) kosong.style.display = tampil === 0 ? '' : 'none';
            });
        })();
    </script>
</body>
</html>