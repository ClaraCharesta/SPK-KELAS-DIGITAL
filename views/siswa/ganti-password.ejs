<!DOCTYPE html>
<html lang="id">
<head>
    <title>Ganti Password - Kelas Digital SMAN 12 Padang</title>
    <%- include('partials/siswa-head') %>
</head>
<body class="siswa-body">
    <%- include('partials/siswa-topbar', { siswa: siswa, aktif: 'profil', minimal: wajib }) %>

    <%
        const nisnSiswa = (typeof siswa !== 'undefined' && siswa && siswa.nisn) ? String(siswa.nisn) : '';
    %>

    <main class="siswa-shell">

        <section class="s-card s-narrow">

            <div class="s-panel-header">
                <div class="s-icon-sm s-icon-orange"><i class="bi bi-shield-lock-fill"></i></div>
                <h3>Ganti Password</h3>
            </div>

            <% if (wajib) { %>
                <div class="s-alert s-alert-warn">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Demi keamanan, Anda wajib mengganti password awal sebelum melanjutkan.
                </div>
            <% } %>

            <% if (success) { %>
                <div class="s-alert s-alert-ok"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
            <% } %>
            <% if (error) { %>
                <div class="s-alert s-alert-danger"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
            <% } %>

            <div class="s-reassure">
                <i class="bi bi-info-circle-fill"></i>
                <span>
                    Jika ada yang salah, <strong>password lama Anda tetap berlaku</strong>
                    sampai password baru berhasil disimpan. Anda bisa mencoba lagi.
                </span>
            </div>

            <form action="/siswa/ganti-password" method="POST" id="formGantiPw" autocomplete="off" novalidate>

                <label for="pwLama">Password Lama<% if (wajib) { %> (password awal pada kartu akun)<% } %></label>
                <input type="password" name="password_lama" id="pwLama" required autocomplete="current-password">

                <label for="pwBaru">Password Baru</label>
                <input type="password" name="password_baru" id="pwBaru" required minlength="8" autocomplete="new-password">

                <div class="pw-meter" id="pwMeter" aria-hidden="true">
                    <div class="pw-meter-track"><div class="pw-meter-bar" id="pwMeterBar"></div></div>
                    <span class="pw-meter-label" id="pwMeterLabel">Kekuatan password</span>
                </div>

                <label for="pwKonf">Konfirmasi Password Baru</label>
                <input type="password" name="konfirmasi_password" id="pwKonf" required minlength="8" autocomplete="new-password">
                <p class="pw-pesan-konf" id="pwPesanKonf" role="alert"></p>

                <div class="s-capslock" id="capsWarn" role="alert">
                    <i class="bi bi-capslock-fill"></i> Caps Lock sedang aktif. Huruf besar/kecil akan berpengaruh pada password.
                </div>

                <div class="pw-rules" id="pwRules">
                    <div class="pw-rules-title">
                        <i class="bi bi-list-check"></i> Syarat password baru
                        <span class="pw-rules-count" id="pwRulesCount">0 / 4 terpenuhi</span>
                    </div>

                    <ul>
                        <li class="pw-rule" data-rule="panjang">
                            <span class="pw-rule-ikon"><i class="bi bi-circle"></i></span>
                            <span>Minimal <strong>8 karakter</strong></span>
                        </li>
                        <li class="pw-rule" data-rule="beda">
                            <span class="pw-rule-ikon"><i class="bi bi-circle"></i></span>
                            <span><strong>Berbeda</strong> dari password lama</span>
                        </li>
                        <li class="pw-rule" data-rule="nisn">
                            <span class="pw-rule-ikon"><i class="bi bi-circle"></i></span>
                            <span><strong>Tidak boleh sama</strong> dengan NISN</span>
                        </li>
                        <li class="pw-rule" data-rule="cocok">
                            <span class="pw-rule-ikon"><i class="bi bi-circle"></i></span>
                            <span><strong>Konfirmasi</strong> sama persis dengan password baru</span>
                        </li>
                    </ul>

                    <p class="pw-tips">
                        <i class="bi bi-lightbulb-fill"></i>
                        Tips: gabungkan huruf besar, huruf kecil, dan angka agar lebih aman. Jangan bagikan password kepada siapa pun.
                    </p>
                </div>

                <div class="s-actions">
                    <% if (!wajib) { %>
                        <a href="/siswa/profil" class="s-btn s-btn-outline">Batal</a>
                    <% } %>
                    <button type="submit" class="s-btn s-btn-primary" id="btnSimpanPw" disabled>
                        <i class="bi bi-key-fill"></i> Simpan Password
                    </button>
                </div>

                <p class="s-muted s-small s-center" id="infoTombol">
                    Tombol Simpan aktif setelah semua syarat terpenuhi.
                </p>
            </form>

        </section>

    </main>

    <footer class="siswa-footer">&copy; SMAN 12 Padang &middot; Sistem Penempatan Siswa Kelas Digital</footer>

    <script src="/js/password-toggle.js"></script>
    <script>
        (function () {
            var NISN = <%- JSON.stringify(nisnSiswa) %>;

            var lama = document.getElementById('pwLama');
            var baru = document.getElementById('pwBaru');
            var konf = document.getElementById('pwKonf');
            var tombol = document.getElementById('btnSimpanPw');
            var form = document.getElementById('formGantiPw');
            var infoTombol = document.getElementById('infoTombol');
            var pesanKonf = document.getElementById('pwPesanKonf');
            var capsWarn = document.getElementById('capsWarn');
            var hitungEl = document.getElementById('pwRulesCount');
            var kotakRules = document.getElementById('pwRules');
            var meterBar = document.getElementById('pwMeterBar');
            var meterLabel = document.getElementById('pwMeterLabel');

            function aturRule(nama, status) {
                var li = document.querySelector('.pw-rule[data-rule="' + nama + '"]');
                if (!li) return;
                li.classList.remove('ok', 'gagal');
                var ikon = li.querySelector('.pw-rule-ikon i');

                if (status === 'ok') {
                    li.classList.add('ok');
                    ikon.className = 'bi bi-check-circle-fill';
                } else if (status === 'gagal') {
                    li.classList.add('gagal');
                    ikon.className = 'bi bi-x-circle-fill';
                } else {
                    ikon.className = 'bi bi-circle';
                }
            }

            function kekuatan(pw) {
                if (!pw) return { skor: 0, teks: 'Kekuatan password', kelas: '' };

                var skor = 0;
                if (pw.length >= 8) skor++;
                if (pw.length >= 12) skor++;
                if (/[a-z]/.test(pw) && /[A-Z]/.test(pw)) skor++;
                if (/\d/.test(pw)) skor++;
                if (/[^A-Za-z0-9]/.test(pw)) skor++;

                if (skor <= 2) return { skor: 1, teks: 'Lemah', kelas: 'lemah' };
                if (skor <= 3) return { skor: 2, teks: 'Sedang', kelas: 'sedang' };
                return { skor: 3, teks: 'Kuat', kelas: 'kuat' };
            }

            function periksa() {
                var vLama = lama.value;
                var vBaru = baru.value;
                var vKonf = konf.value;

                var statusPanjang, statusBeda, statusNisn, statusCocok;

                if (!vBaru) statusPanjang = 'netral';
                else statusPanjang = vBaru.length >= 8 ? 'ok' : 'gagal';

                if (!vBaru || !vLama) statusBeda = 'netral';
                else statusBeda = vBaru !== vLama ? 'ok' : 'gagal';

                if (!vBaru) statusNisn = 'netral';
                else statusNisn = (NISN && vBaru === NISN) ? 'gagal' : 'ok';

                if (!vKonf) statusCocok = 'netral';
                else statusCocok = (vBaru === vKonf) ? 'ok' : 'gagal';

                aturRule('panjang', statusPanjang);
                aturRule('beda', statusBeda);
                aturRule('nisn', statusNisn);
                aturRule('cocok', statusCocok);

                var jumlahOk = [statusPanjang, statusBeda, statusNisn, statusCocok]
                    .filter(function (s) { return s === 'ok'; }).length;

                hitungEl.textContent = jumlahOk + ' / 4 terpenuhi';

                var adaGagal = [statusPanjang, statusBeda, statusNisn, statusCocok]
                    .some(function (s) { return s === 'gagal'; });

                kotakRules.classList.toggle('ada-gagal', adaGagal);
                kotakRules.classList.toggle('semua-ok', jumlahOk === 4);

                if (vKonf && statusCocok === 'gagal') {
                    konf.classList.add('input-salah');
                    konf.classList.remove('input-benar');
                    pesanKonf.textContent = 'Konfirmasi belum sama dengan password baru.';
                    pesanKonf.classList.add('tampil');
                } else {
                    konf.classList.remove('input-salah');
                    konf.classList.toggle('input-benar', !!vKonf && statusCocok === 'ok');
                    pesanKonf.textContent = '';
                    pesanKonf.classList.remove('tampil');
                }

                baru.classList.toggle('input-salah', statusPanjang === 'gagal' || statusBeda === 'gagal' || statusNisn === 'gagal');

                var k = kekuatan(vBaru);
                meterBar.className = 'pw-meter-bar ' + k.kelas;
                meterBar.style.width = (k.skor * 33.34) + '%';
                meterLabel.textContent = vBaru ? ('Kekuatan: ' + k.teks) : 'Kekuatan password';

                var siap = vLama.length > 0 && jumlahOk === 4;
                tombol.disabled = !siap;

                if (!vLama) {
                    infoTombol.textContent = 'Isi password lama terlebih dahulu.';
                } else if (!siap) {
                    infoTombol.textContent = 'Tombol Simpan aktif setelah semua syarat terpenuhi.';
                } else {
                    infoTombol.textContent = 'Semua syarat terpenuhi. Anda bisa menyimpan password baru.';
                }

                infoTombol.classList.toggle('siap', siap);
            }

            function cekCaps(e) {
                if (e.getModifierState && e.getModifierState('CapsLock')) {
                    capsWarn.classList.add('tampil');
                } else {
                    capsWarn.classList.remove('tampil');
                }
            }

            [lama, baru, konf].forEach(function (el) {
                el.addEventListener('input', periksa);
                el.addEventListener('keyup', cekCaps);
                el.addEventListener('keydown', cekCaps);
                el.addEventListener('blur', function () { capsWarn.classList.remove('tampil'); });
            });

            form.addEventListener('submit', function (e) {
                periksa();

                if (tombol.disabled) {
                    e.preventDefault();
                    return;
                }

                tombol.disabled = true;
                tombol.innerHTML = '<i class="bi bi-hourglass-split"></i> Menyimpan...';
            });

            periksa();
        })();
    </script>

     <%- include('../partials/sesi-idle') %>
</body>
</html>