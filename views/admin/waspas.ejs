<!DOCTYPE html>
<html lang="id">
<head>
    <title>Perhitungan WASPAS</title>
    <%- include('../partials/head') %>
    <style>
        .table-scroll {
            max-height: 420px;
            overflow-y: auto;
            overflow-x: auto;
            border: 1px solid #e5e5e5;
            border-radius: 8px;
        }
        .table-scroll .data-table {
            margin: 0;
        }
        .table-scroll thead th {
            position: sticky;
            top: 0;
            background: #fff;
            z-index: 2;
            box-shadow: 0 1px 0 #e5e5e5;
        }
        .table-scroll::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }
        .table-scroll::-webkit-scrollbar-thumb {
            background: #b8c2d1;
            border-radius: 6px;
        }
        .table-scroll::-webkit-scrollbar-thumb:hover {
            background: #97a4b8;
        }
        .table-scroll::-webkit-scrollbar-track {
            background: #f4f6f9;
        }
        tr.baris-diterima td { background:#f3fbf6; }
    </style>
</head>
<body>
    <div class="app-layout">
        <%- include('../partials/sidebar', { user: user, activePage: activePage }) %>
        <div class="main-content">
            <%- include('../partials/topbar', { user: user, pageTitle: pageTitle }) %>

            <div class="content-wrapper">
                <div class="panel" style="background:#f4f8ff;">
                    <div class="panel-header-row" style="cursor:pointer;" onclick="document.getElementById('tutorialWaspas').classList.toggle('show')">
                        <div class="panel-header">
                            <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-question-circle-fill"></i></div>
                            <h3>Cara Menjalankan Perankingan</h3>
                        </div>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                    <div id="tutorialWaspas" class="tutorial-content">
                        <ol style="padding-left:20px; font-size:14px; color:#333; line-height:1.8;">
                            <li>Hanya siswa yang sudah menyatakan <strong>bersedia</strong> (dikonfirmasi siswa atau operator) yang ikut perankingan.</li>
                            <li>Pastikan bobot kriteria tersedia dan seluruh siswa yang bersedia memiliki nilai lengkap. Siswa yang belum diaktifkan atau belum konfirmasi perlu dihubungi.</li>
                            <li>Jumlah siswa harus lebih banyak minimal 1 dari kuota agar perhitungan bisa dijalankan.</li>
                            <li>Klik <strong>"Hitung Ranking WASPAS"</strong>. Siswa dengan peringkat dalam kuota otomatis berstatus <strong>Masuk Kelas Digital</strong>, sisanya <strong>Tidak Masuk Kelas Digital</strong>.</li>
                            <li>Jika ada perubahan data siswa, nilai, kesediaan, kriteria, atau bobot sebelum finalisasi, hasil dikosongkan dan perlu dihitung ulang.</li>
                            <li>Setelah hasil diperiksa, klik <strong>"Finalisasi Hasil"</strong>. Setelah itu seluruh data terkunci dan siswa dapat melihat hasilnya di tahap 3.</li>
                        </ol>
                    </div>
                </div>

                <% if (success) { %>
                    <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
                <% } %>
                <% if (terkunci) { %>
                    <div class="alert" style="background:#e2f8ea; color:#1e8449;">
                        <i class="bi bi-lock-fill"></i>
                        Hasil seleksi sudah difinalisasi. Data siswa, nilai, kriteria, bobot, dan hasil perankingan terkunci.
                    </div>
                <% } %>

                <%
                    const kuotaNum = Number(kuota) || 0;
                    const kuotaBelumTerpenuhi = cekData ? (cekData.totalSiswa <= kuotaNum) : false;

                    // Status ditentukan dari ranking dan kuota (rank <= kuota = diterima),
                    // tidak bergantung pada kolom siswa.status_penerimaan.
                    const statusDariRanking = function(h) {
                        return Number(h.ranking) <= kuotaNum ? 'diterima' : 'tidak_diterima';
                    };

                    const jumlahDiterima = hasilRanking.filter(h => statusDariRanking(h) === 'diterima').length;
                    const tombolHitungNonaktif = cekData ? (!cekData.bisaHitung || kuotaBelumTerpenuhi) : true;
                    const infoAkunAda = (typeof infoAkun !== 'undefined') && infoAkun;
                    const belumKonfirmasi = cekData ? cekData.belumKonfirmasi : 0;

                    let pesanFinal = 'Finalisasi hasil seleksi? Setelah ini data siswa, nilai, kriteria, bobot, dan hasil tidak dapat diubah lagi.';
                    if (belumKonfirmasi > 0) {
                        pesanFinal += ' Perhatian: ' + belumKonfirmasi + ' siswa belum konfirmasi kesediaan dan TIDAK ikut seleksi.';
                    }

                    const adaDetailWaspas = (typeof detailPerhitungan !== 'undefined')
                        && detailPerhitungan
                        && Array.isArray(detailPerhitungan.matrixKeputusan)
                        && detailPerhitungan.matrixKeputusan.length > 0;

                    const detailMap = {};
                    if (adaDetailWaspas) {
                        detailPerhitungan.hasil.forEach(d => { detailMap[d.id_siswa] = d; });
                    }
                %>

                <% if (cekData) { %>
                <div class="panel">
                    <div class="panel-header-row">
                        <div class="panel-header">
                            <div class="stat-icon icon-purple" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-graph-up-arrow"></i></div>
                            <h3>Status Kesiapan Perhitungan</h3>
                        </div>
                        <% if (!terkunci) { %>
                        <div style="display:flex; gap:10px;">
                            <form action="/admin/waspas/hitung" method="POST" onsubmit="return confirmDelete(this, 'Hitung ulang perankingan? Hasil sebelumnya akan digantikan.');">
                                <button type="submit" class="btn-primary"
                                        <%= tombolHitungNonaktif ? 'disabled' : '' %>
                                        style="<%= tombolHitungNonaktif ? 'opacity:0.5;cursor:not-allowed;' : '' %>">
                                    <i class="bi bi-calculator-fill"></i> Hitung Ranking WASPAS
                                </button>
                            </form>
                        </div>
                        <% } %>
                    </div>

                    <% if (kuotaBelumTerpenuhi) { %>
                        <div class="alert" style="background:#fdecea; color:#b3261e; margin-bottom:15px;">
                            <i class="bi bi-x-circle-fill"></i> Jumlah siswa yang bersedia (<%= cekData.totalSiswa %>) belum mencukupi. Perhitungan hanya bisa dijalankan jika jumlahnya lebih banyak minimal 1 dari kuota (kuota saat ini: <%= kuotaNum %>).
                        </div>
                    <% } %>

                    <% if (!cekData.bisaHitung) { %>
                        <div class="alert" style="background:#fdecea; color:#b3261e; margin-bottom:15px;">
                            <i class="bi bi-x-circle-fill"></i> Perhitungan belum dapat dijalankan. Lengkapi kekurangan berikut terlebih dahulu.
                        </div>
                    <% } %>

                    <table class="data-table">
                        <tbody>
                            <tr><td>Kuota Kelas Digital</td><td><strong><%= kuota || '-' %> siswa</strong></td></tr>
                            <tr><td>Siswa Bersedia (ikut perankingan)</td><td><%= cekData.totalSiswa %></td></tr>
                            <tr>
                                <td>Siswa Belum Konfirmasi Kesediaan</td>
                                <td>
                                    <span class="badge badge-<%= belumKonfirmasi === 0 ? 'diterima' : 'tidak_diterima' %>"><%= belumKonfirmasi %> siswa</span>
                                    <% if (belumKonfirmasi > 0) { %>
                                        <a href="/admin/siswa" style="margin-left:8px; font-size:12px;">Lihat &amp; hubungi</a>
                                    <% } %>
                                </td>
                            </tr>
                            <tr><td>Siswa Tidak Berminat</td><td><%= cekData.tidakBerminat %></td></tr>
                            <tr><td>Total Kriteria</td><td><%= cekData.totalKriteria %></td></tr>
                            <tr>
                                <td>Bobot Kriteria Tersedia</td>
                                <td><span class="badge badge-<%= cekData.totalBobot > 0 ? 'diterima' : 'tidak_diterima' %>"><%= cekData.totalBobot > 0 ? 'Sudah' : 'Belum' %></span></td>
                            </tr>
                            <tr>
                                <td>Siswa Bersedia dengan Nilai Belum Lengkap</td>
                                <td><span class="badge badge-<%= cekData.siswaBelumLengkap === 0 ? 'diterima' : 'tidak_diterima' %>"><%= cekData.siswaBelumLengkap %> siswa</span></td>
                            </tr>
                            <% if (infoAkunAda) { %>
                            <tr>
                                <td>Akun Belum Diaktifkan</td>
                                <td>
                                    <span class="badge badge-<%= infoAkun.belumAktif === 0 ? 'diterima' : 'tidak_diterima' %>"><%= infoAkun.belumAktif %> siswa</span>
                                    <% if (infoAkun.belumAktif > 0) { %>
                                        <a href="/admin/siswa?filter=belum_aktif" style="margin-left:8px; font-size:12px;">Lihat &amp; hubungi</a>
                                    <% } %>
                                </td>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
                <% } %>

                <!-- ============================================================ -->
                <!-- PANEL: Detail Tahapan Perhitungan WASPAS (terbuka otomatis)  -->
                <!-- ============================================================ -->
                <% if (adaDetailWaspas) { %>
                <div class="panel" style="background:#fdf8f4;">
                    <div class="panel-header-row" style="cursor:pointer;" onclick="document.getElementById('detailWaspas').classList.toggle('show')">
                        <div class="panel-header">
                            <div class="stat-icon icon-orange" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-diagram-3-fill"></i></div>
                            <h3>Detail Tahapan Perhitungan WASPAS</h3>
                        </div>
                        <i class="bi bi-chevron-up"></i>
                    </div>
                    <div id="detailWaspas" class="tutorial-content show">

                        <h4 style="margin-top:0;">1. Bobot &amp; Jenis Kriteria</h4>
                        <div class="table-scroll" style="max-height:260px;">
                            <table class="data-table">
                                <thead><tr><th>Kriteria</th><th>Jenis</th><th>Bobot</th></tr></thead>
                                <tbody>
                                    <% detailPerhitungan.kriteriaList.forEach(function(k) { %>
                                        <tr>
                                            <td><%= k.nama_kriteria || k.id_kriteria %></td>
                                            <td><span class="badge badge-<%= k.jenis === 'benefit' ? 'diterima' : 'belum_diproses' %>"><%= k.jenis === 'benefit' ? 'Benefit' : 'Cost' %></span></td>
                                            <td><%= (detailPerhitungan.bobotMap[k.id_kriteria] || 0).toFixed(4) %></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>

                        <h4>2. Matrix Keputusan (X) &mdash; Nilai Mentah</h4>
                        <p style="font-size:12px;color:#777;">Total baris: <strong><%= detailPerhitungan.matrixKeputusan.length %> siswa</strong> — scroll ke bawah/samping untuk melihat semua.</p>
                        <div class="table-scroll">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Siswa</th>
                                        <% detailPerhitungan.kriteriaList.forEach(function(k) { %><th><%= k.nama_kriteria || k.id_kriteria %></th><% }); %>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% detailPerhitungan.matrixKeputusan.forEach(function(baris) { %>
                                        <tr>
                                            <td><%= baris.nama %></td>
                                            <% detailPerhitungan.kriteriaList.forEach(function(k) { %>
                                                <td><%= parseFloat(baris.nilai[k.id_kriteria]).toFixed(4) %></td>
                                            <% }); %>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>

                        <h4>3. Matrix Ternormalisasi (R)</h4>
                        <p style="font-size:12px;color:#777;">Benefit: nilai &divide; nilai maksimum kolom. Cost: nilai minimum kolom &divide; nilai.</p>
                        <div class="table-scroll">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Siswa</th>
                                        <% detailPerhitungan.kriteriaList.forEach(function(k) { %><th><%= k.nama_kriteria || k.id_kriteria %></th><% }); %>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% detailPerhitungan.matrixNormalisasi.forEach(function(baris) { %>
                                        <tr>
                                            <td><%= baris.nama %></td>
                                            <% detailPerhitungan.kriteriaList.forEach(function(k) { %>
                                                <td><%= baris.normalisasi[k.id_kriteria].toFixed(4) %></td>
                                            <% }); %>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>

                        <h4>4. Kontribusi WSM (R &times; Bobot) &amp; WPM (R ^ Bobot) per Kriteria</h4>
                        <div class="table-scroll">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th rowspan="2" style="vertical-align:middle;">Siswa</th>
                                        <% detailPerhitungan.kriteriaList.forEach(function(k) { %><th colspan="2"><%= k.nama_kriteria || k.id_kriteria %></th><% }); %>
                                    </tr>
                                    <tr>
                                        <% detailPerhitungan.kriteriaList.forEach(function() { %><th>WSM</th><th>WPM</th><% }); %>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% detailPerhitungan.hasil.forEach(function(h) { %>
                                        <tr>
                                            <td><%= h.nama %></td>
                                            <% detailPerhitungan.kriteriaList.forEach(function(k) { const dk = h.detailKriteria[k.id_kriteria]; %>
                                                <td><%= dk.kontribusiWSM.toFixed(4) %></td>
                                                <td><%= dk.kontribusiWPM.toFixed(4) %></td>
                                            <% }); %>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>

                        <h4>5. Rekap Total WSM, WPM, dan Nilai Akhir Q</h4>
                        <p style="font-size:12px;color:#777;">Q = (&lambda; &times; Total WSM) + ((1 &minus; &lambda;) &times; Total WPM), dengan &lambda; = <%= detailPerhitungan.lambda %>. Total baris: <strong><%= detailPerhitungan.hasil.length %> siswa</strong>.</p>
                        <div class="table-scroll">
                            <table class="data-table">
                                <thead><tr><th>Rank</th><th>Siswa</th><th>Total WSM</th><th>Total WPM</th><th>Nilai Q</th></tr></thead>
                                <tbody>
                                    <% detailPerhitungan.hasil.forEach(function(h) { %>
                                        <tr>
                                            <td>#<%= h.ranking %></td>
                                            <td><%= h.nama %></td>
                                            <td><%= h.wsm.toFixed(4) %></td>
                                            <td><%= h.wpm.toFixed(4) %></td>
                                            <td><strong><%= h.q.toFixed(4) %></strong></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
                <% } %>

                <div class="panel">
                    <div class="panel-header">
                        <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-trophy-fill"></i></div>
                        <h3>Hasil Perangkingan Siswa</h3>
                    </div>

                    <% if (hasilRanking.length === 0) { %>
                        <p class="empty-state">Perangkingan belum dihitung.</p>
                    <% } else { %>
                        <input type="text" id="searchSiswa" placeholder="Cari nama atau NISN siswa..." class="search-input" onkeyup="filterTabelSiswa()">

                        <div class="status-legend">
                            <span><span class="dot-legend badge-diterima"></span> Masuk Kelas Digital</span>
                            <span><span class="dot-legend badge-tidak_diterima"></span> Tidak Masuk Kelas Digital</span>
                        </div>

                        <p style="font-size:13px; color:#666; margin-bottom:10px;">
                            Masuk Kelas Digital: <strong><%= jumlahDiterima %> / <%= kuota %></strong> kuota
                            <% if (!terkunci) { %> &middot; <em>hasil sementara, belum difinalisasi</em><% } %>
                        </p>

                        <div class="table-scroll" style="max-height:560px;">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Rank</th><th>NISN</th><th>Nama</th>
                                        <% if (adaDetailWaspas) { %><th>WSM</th><th>WPM</th><% } %>
                                        <th>Nilai Q</th><th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% hasilRanking.forEach(function(h) {
                                        const d = detailMap[h.id_siswa];
                                        const statusBaris = statusDariRanking(h);
                                    %>
                                        <tr class="baris-siswa <%= statusBaris === 'diterima' ? 'baris-diterima' : '' %>"
                                            data-nama="<%= h.nama.toLowerCase() %>" data-nisn="<%= h.nisn %>">
                                            <td><strong>#<%= h.ranking %></strong></td>
                                            <td><%= h.nisn %></td>
                                            <td><%= h.nama %></td>
                                            <% if (adaDetailWaspas) { %>
                                                <td><%= d ? d.wsm.toFixed(4) : '-' %></td>
                                                <td><%= d ? d.wpm.toFixed(4) : '-' %></td>
                                            <% } %>
                                            <td><strong><%= parseFloat(h.nilai_akhir_q).toFixed(4) %></strong></td>
                                            <td>
                                                <% if (statusBaris === 'diterima') { %>
                                                    <span class="badge badge-diterima">Masuk Kelas Digital</span>
                                                <% } else { %>
                                                    <span class="badge badge-tidak_diterima">Tidak Masuk Kelas Digital</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>

                        <% if (!terkunci) { %>
                            <div style="margin-top:15px;">
                                <form action="/admin/waspas/finalisasi" method="POST"
                                      onsubmit='return confirmDelete(this, <%- JSON.stringify(pesanFinal) %>);'>
                                    <button type="submit" class="btn-primary">
                                        <i class="bi bi-check-circle-fill"></i> Finalisasi Hasil
                                    </button>
                                </form>
                            </div>
                        <% } else { %>
                            <div class="alert" style="background:#e2f8ea; color:#1e8449; margin-top:15px;">
                                <i class="bi bi-check-circle-fill"></i> Hasil sudah difinalisasi dan bersifat final.
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <%- include('../partials/footer') %>
            </div>
        </div>
    </div>

    <script>
        function filterTabelSiswa() {
            const keyword = document.getElementById('searchSiswa').value.toLowerCase();
            document.querySelectorAll('.baris-siswa').forEach(row => {
                const cocok = row.dataset.nama.includes(keyword) || row.dataset.nisn.includes(keyword);
                row.style.display = cocok ? '' : 'none';
            });
        }
    </script>
</body>
</html>