<div class="sidebar">
    <div class="sidebar-header">
        <img src="/img/logo-sman12.png" alt="Logo">
        <div class="sidebar-header-text">
            <h3>SISTEM PENDUKUNG KEPUTUSAN</h3>
            <p>Penempatan Siswa Kelas Digital</p>
        </div>
    </div>

    <ul class="sidebar-menu">
        <% if (user.role === 'super_admin') { %>
            <li class="<%= activePage === 'dashboard' ? 'active' : '' %>">
                <a href="/superadmin/dashboard"><i class="bi bi-grid-fill"></i> <span>Dashboard</span></a>
            </li>
            <li class="<%= activePage === 'akun-admin' ? 'active' : '' %>">
                <a href="/superadmin/akun-admin"><i class="bi bi-people-fill"></i> <span>Kelola Akun Admin</span></a>
            </li>
            <li class="<%= activePage === 'periode' ? 'active' : '' %>">
                <a href="/superadmin/periode"><i class="bi bi-calendar-range"></i> <span>Periode Seleksi</span></a>
            </li>
            <li class="<%= activePage === 'kriteria' ? 'active' : '' %>">
                <a href="/superadmin/kriteria"><i class="bi bi-list-check"></i> <span>Kelola Kriteria</span></a>
            </li>
            <li class="<%= activePage === 'log' ? 'active' : '' %>">
                <a href="/superadmin/log"><i class="bi bi-clock-history"></i> <span>Log Aktivitas</span></a>
            </li>

        <% } else if (user.role === 'admin') { %>

            <li class="<%= activePage === 'dashboard' ? 'active' : '' %>">
                <a href="/admin/dashboard"><i class="bi bi-grid-fill"></i> <span>Dashboard</span></a>
            </li>
            <li class="<%= activePage === 'siswa' ? 'active' : '' %>">
                <a href="/admin/siswa"><i class="bi bi-person-fill"></i> <span>Data Siswa</span></a>
            </li>
            <li class="<%= activePage === 'kriteria' ? 'active' : '' %>">
                <a href="/admin/kriteria"><i class="bi bi-card-checklist"></i> <span>Kriteria</span></a>
            </li>
            <li class="<%= activePage === 'nilai' ? 'active' : '' %>">
                <a href="/admin/nilai"><i class="bi bi-pencil-square"></i> <span>Input Nilai</span></a>
            </li>
            <li class="<%= activePage === 'fucom' ? 'active' : '' %>">
                <a href="/admin/fucom"><i class="bi bi-sliders"></i> <span>FUCOM</span></a>
            </li>
            <li class="<%= activePage === 'waspas' ? 'active' : '' %>">
                <a href="/admin/waspas"><i class="bi bi-graph-up-arrow"></i> <span>WASPAS</span></a>
            </li>
            <li class="<%= activePage === 'laporan' ? 'active' : '' %>">
                <a href="/admin/laporan"><i class="bi bi-file-earmark-text-fill"></i> <span>Laporan</span></a>
            </li>

        <% } else if (user.role === 'kepsek') { %>

            <li class="<%= activePage === 'dashboard' ? 'active' : '' %>">
                <a href="/kepsek/dashboard"><i class="bi bi-grid-fill"></i> <span>Dashboard</span></a>
            </li>
            <li class="<%= activePage === 'ranking' ? 'active' : '' %>">
                <a href="/kepsek/ranking"><i class="bi bi-trophy-fill"></i> <span>Hasil Ranking</span></a>
            </li>
            <li class="<%= activePage === 'laporan' ? 'active' : '' %>">
                <a href="/kepsek/laporan"><i class="bi bi-file-earmark-text-fill"></i> <span>Laporan</span></a>
            </li>

        <% } %>
    </ul>

    <div class="sidebar-footer">
        <a href="/logout"><i class="bi bi-box-arrow-right"></i> <span>Logout</span></a>
    </div>
</div>