<!DOCTYPE html>
<html lang="id">
<head>
    <title>Ganti Password - Kelas Digital SMAN 12 Padang</title>
    <%- include('partials/siswa-head') %>
</head>
<body class="siswa-body">
    <%- include('partials/siswa-topbar', { siswa: siswa, aktif: 'profil', minimal: wajib }) %>

    <main class="siswa-shell">

        <section class="s-card s-narrow">

            <div class="s-panel-header">
                <div class="s-icon-sm s-icon-orange"><i class="bi bi-shield-lock-fill"></i></div>
                <h3>Ganti Password</h3>
            </div>

            <% if (wajib) { %>
                <div class="s-alert s-alert-warn">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Demi keamanan, Anda wajib mengganti password awal sebelum melanjutkan.
                </div>
            <% } %>

            <% if (success) { %>
                <div class="s-alert s-alert-ok"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
            <% } %>
            <% if (error) { %>
                <div class="s-alert s-alert-danger"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
            <% } %>

            <form action="/siswa/ganti-password" method="POST">
                <label>Password Lama<% if (wajib) { %> (password awal pada kartu akun)<% } %></label>
                <input type="password" name="password_lama" required>

                <label>Password Baru</label>
                <input type="password" name="password_baru" required minlength="8">

                <label>Konfirmasi Password Baru</label>
                <input type="password" name="konfirmasi_password" required minlength="8">

                <p class="s-muted s-small">Minimal 8 karakter, berbeda dari password lama, dan tidak boleh sama dengan NISN.</p>

                <div class="s-actions">
                    <% if (!wajib) { %>
                        <a href="/siswa/profil" class="s-btn s-btn-outline">Batal</a>
                    <% } %>
                    <button type="submit" class="s-btn s-btn-primary"><i class="bi bi-key-fill"></i> Simpan Password</button>
                </div>
            </form>

        </section>

    </main>

    <footer class="siswa-footer">&copy; SMAN 12 Padang &middot; Sistem Penempatan Siswa Kelas Digital</footer>
</body>
</html>