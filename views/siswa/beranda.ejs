<!DOCTYPE html>
<html lang="id">
<head>
    <title>Beranda - Kelas Digital SMAN 12 Padang</title>
    <%- include('partials/siswa-head') %>
</head>
<body class="siswa-body">
    <%- include('partials/siswa-topbar', { siswa: siswa, aktif: 'beranda', minimal: false }) %>

    <main class="siswa-shell">

        <% if (success) { %>
            <div class="s-alert s-alert-ok"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
        <% } %>
        <% if (error) { %>
            <div class="s-alert s-alert-danger"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
        <% } %>

        <section class="s-card s-hero">
            <div>
                <h1>Halo, <%= siswa.nama %></h1>
                <p>Seleksi Kelas Digital SMAN 12 Padang &middot; Tahun Ajaran <%= siswa.tahun_ajaran %></p>
            </div>
            <span class="s-chip">NISN: <%= siswa.nisn %></span>
        </section>

        <%
            const petaLangkah = {
                minat: 1, periode_tutup: 1,
                menunggu: 2,
                diterima: 3, belum_lolos: 3, tidak_ikut: 3
            };
            const langkahSekarang = petaLangkah[tahap] || 1;
            const namaLangkah = ['Respons Minat', 'Menunggu Pengumuman', 'Hasil Seleksi'];
        %>
        <ol class="s-steps">
            <% namaLangkah.forEach(function (nama, i) {
                const nomor = i + 1;
                const kelas = nomor < langkahSekarang ? 'done' : (nomor === langkahSekarang ? 'active' : '');
            %>
                <li class="<%= kelas %>">
                    <span><%= nomor < langkahSekarang ? '✓' : nomor %></span>
                    <em><%= nama %></em>
                </li>
            <% }) %>
        </ol>

        <% if (tahap === 'minat') { %>

            <section class="s-card">
                <div class="s-center">
                    <div class="s-icon s-icon-blue"><i class="bi bi-laptop"></i></div>
                    <h2>Apakah Anda berminat mengikuti Kelas Digital?</h2>
                    <p class="s-muted">
                        Jawaban Anda dipakai dalam proses seleksi penempatan siswa ke Kelas Digital.
                        Jika berminat, Anda akan diminta mengisi empat pertanyaan singkat.
                    </p>
                </div>

                <!-- Pernyataan kesediaan -->
                <div class="s-pernyataan" id="boxPernyataan">
                    <div class="s-pernyataan-head">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>
                            <strong>Baca dan centang semua pernyataan sebelum melanjutkan</strong>
                            <span>Pilihan &ldquo;Ya, saya berminat&rdquo; bersifat mengikat dan tidak dapat dibatalkan.</span>
                        </div>
                    </div>

                    <label class="s-cek">
                        <input type="checkbox" class="cek-pernyataan">
                        <span>
                            Saya memilih <strong>berminat</strong> mengikuti Kelas Digital atas kemauan saya sendiri,
                            dan sudah memahami informasi tentang Kelas Digital.
                        </span>
                    </label>

                    <label class="s-cek">
                        <input type="checkbox" class="cek-pernyataan">
                        <span>
                            Saya memahami bahwa setelah menekan tombol konfirmasi, status <strong>Berminat tidak dapat dibatalkan</strong>
                            dan saya <strong>tidak dapat mengundurkan diri</strong> dari seleksi ini.
                        </span>
                    </label>

                    <label class="s-cek">
                        <input type="checkbox" class="cek-pernyataan">
                        <span>
                            Saya <strong>siap menerima seluruh konsekuensinya</strong>, termasuk bersedia mengikuti
                            Kelas Digital apabila hasil seleksi menyatakan saya diterima.
                        </span>
                    </label>

                    <div class="s-progress"><div class="s-progress-bar" id="barPernyataan"></div></div>
                    <p class="s-muted s-small s-center" id="infoPernyataan">0 dari 3 pernyataan dicentang</p>
                </div>

                <div class="s-actions s-actions-center">
                    <a href="/siswa/tolak" class="s-btn s-btn-outline">Tidak berminat</a>
                    <button type="button" class="s-btn s-btn-primary" id="btnSetuju" disabled>
                        <i class="bi bi-check2-circle"></i> Ya, saya berminat
                    </button>
                </div>
            </section>

            <!-- Konfirmasi akhir -->
            <div class="s-modal-overlay" id="modalSetuju" role="dialog" aria-modal="true" aria-labelledby="judulModalSetuju">
                <div class="s-modal">
                    <div class="s-icon s-icon-orange"><i class="bi bi-question-circle-fill"></i></div>
                    <h3 id="judulModalSetuju">Yakin ingin melanjutkan?</h3>
                    <p class="s-muted">
                        Anda akan menyatakan <strong>berminat</strong> mengikuti Kelas Digital.
                        Begitu Anda menekan <strong>&ldquo;Ya, saya yakin&rdquo;</strong>, status berminat langsung tercatat,
                        <strong>tidak dapat dibatalkan</strong>, dan Anda <strong>tidak dapat mengundurkan diri</strong>.
                        Setelah itu Anda wajib mengisi empat pertanyaan singkat.
                    </p>

                    <form action="/siswa/form" method="POST" id="formYakin">
                        <input type="hidden" name="aksi" value="setuju">
                        <div class="s-actions s-actions-center">
                            <button type="button" class="s-btn s-btn-outline" id="btnBatalSetuju">Periksa lagi</button>
                            <button type="submit" class="s-btn s-btn-primary" id="btnYakinSetuju">
                                <i class="bi bi-arrow-right-circle-fill"></i> Ya, saya yakin
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        <% } else if (tahap === 'menunggu') { %>

            <section class="s-card">
                <h2><i class="bi bi-hourglass-split"></i> Menunggu Pengumuman</h2>
                <p class="s-muted">
                    Data Anda sudah kami terima dan Anda terdaftar sebagai peserta seleksi.
                    Hasil seleksi akan tampil di halaman ini setelah proses selesai.
                </p>

                <table class="s-table">
                    <thead>
                        <tr><th>Pertanyaan</th><th>Jawaban Anda</th></tr>
                    </thead>
                    <tbody>
                        <% pertanyaan.forEach(function (p) {
                            const nilai = jawaban[p.nama_kriteria];
                            const teks = (nilai && p.opsi[nilai - 1]) ? p.opsi[nilai - 1] : '-';
                        %>
                            <tr>
                                <td><%= p.judul %></td>
                                <td><strong><%= nilai || '-' %></strong> &mdash; <%= teks %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>

                <% if (bisaUbahJawaban) { %>
                    <div class="s-actions">
                        <a href="/siswa/form" class="s-btn s-btn-outline"><i class="bi bi-pencil-fill"></i> Ubah Jawaban</a>
                    </div>
                    <p class="s-muted s-small">Jawaban masih dapat diubah sampai hasil seleksi diumumkan.</p>
                <% } %>
            </section>

        <% } else if (tahap === 'diterima') { %>

            <section class="s-card s-result s-result-ok">
                <div class="s-icon s-icon-green"><i class="bi bi-trophy-fill"></i></div>
                <h2>Selamat! Anda diterima di Kelas Digital</h2>
                <p class="s-muted">
                    Hasil seleksi sudah final. Silakan hubungi operator sekolah untuk informasi tindak lanjut.
                </p>
            </section>

        <% } else if (tahap === 'belum_lolos') { %>

            <section class="s-card s-result s-result-warn">
                <div class="s-icon s-icon-orange"><i class="bi bi-info-circle-fill"></i></div>
                <h2>Anda belum lolos seleksi Kelas Digital</h2>
                <p class="s-muted">Terima kasih telah berpartisipasi. Tetap semangat belajar!</p>
            </section>

        <% } else if (tahap === 'tidak_ikut') { %>

            <section class="s-card s-result s-result-info">
                <div class="s-icon s-icon-blue"><i class="bi bi-info-circle-fill"></i></div>
                <h2>Anda tidak mengikuti seleksi pada periode ini</h2>
                <p class="s-muted">Silakan hubungi operator sekolah jika ada pertanyaan.</p>
            </section>

        <% } else if (tahap === 'periode_tutup') { %>

            <section class="s-card s-result s-result-warn">
                <div class="s-icon s-icon-orange"><i class="bi bi-calendar-x-fill"></i></div>
                <h2>Periode seleksi sudah ditutup</h2>
                <p>Anda belum memberikan respons sampai periode ditutup. Silakan hubungi operator sekolah.</p>
            </section>

        <% } %>

    </main>

    <footer class="siswa-footer">&copy; SMAN 12 Padang &middot; Sistem Penempatan Siswa Kelas Digital</footer>

    <% if (tahap === 'minat') { %>
    <script>
        (function () {
            var cekList = Array.prototype.slice.call(document.querySelectorAll('.cek-pernyataan'));
            var btnSetuju = document.getElementById('btnSetuju');
            var bar = document.getElementById('barPernyataan');
            var info = document.getElementById('infoPernyataan');
            var box = document.getElementById('boxPernyataan');
            var modal = document.getElementById('modalSetuju');
            var btnBatal = document.getElementById('btnBatalSetuju');
            var btnYakin = document.getElementById('btnYakinSetuju');
            var formYakin = document.getElementById('formYakin');

            function perbarui() {
                var jumlah = cekList.filter(function (c) { return c.checked; }).length;
                var total = cekList.length;

                cekList.forEach(function (c) {
                    c.closest('.s-cek').classList.toggle('dicentang', c.checked);
                });

                bar.style.width = ((jumlah / total) * 100) + '%';
                bar.classList.toggle('penuh', jumlah === total);
                box.classList.toggle('lengkap', jumlah === total);

                info.textContent = jumlah === total
                    ? 'Semua pernyataan sudah dicentang. Anda bisa melanjutkan.'
                    : jumlah + ' dari ' + total + ' pernyataan dicentang';

                btnSetuju.disabled = jumlah !== total;
            }

            function bukaModal() {
                modal.classList.add('tampil');
                btnBatal.focus();
            }

            function tutupModal() {
                modal.classList.remove('tampil');
                btnSetuju.focus();
            }

            cekList.forEach(function (c) { c.addEventListener('change', perbarui); });

            btnSetuju.addEventListener('click', function () {
                if (!btnSetuju.disabled) bukaModal();
            });

            btnBatal.addEventListener('click', tutupModal);

            modal.addEventListener('click', function (e) {
                if (e.target === modal) tutupModal();
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && modal.classList.contains('tampil')) tutupModal();
            });

            // Kirim POST ke /siswa/form dengan aksi=setuju (status berminat langsung tersimpan di server).
            formYakin.addEventListener('submit', function () {
                btnYakin.disabled = true;
                btnYakin.innerHTML = '<i class="bi bi-hourglass-split"></i> Mengalihkan...';
            });

            perbarui();
        })();
    </script>
    <% } %>

  <%# Pemantau batas waktu sesi siswa (idle 15 menit + batas maksimal). Harus di luar blok if tahap. %>
    <%- include('../partials/siswa-idle') %>
</body>
</html>