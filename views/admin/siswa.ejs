<!DOCTYPE html>
<html lang="id">
<head>
    <title>Data Siswa</title>
    <%- include('../partials/head') %>

    <style>
        .stat-row { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:18px; }
        .stat-mini { background:#fff; border:1px solid #e5e7eb; border-top:3px solid #cbd5e1; border-radius:10px; padding:12px 14px; cursor:pointer; transition:box-shadow .15s, transform .15s; }
        .stat-mini:hover { box-shadow:0 4px 12px rgba(0,0,0,.08); transform:translateY(-1px); }
        .stat-mini .angka { font-size:24px; font-weight:700; line-height:1.2; }
        .stat-mini .label { font-size:12px; color:#666; }
        .stat-mini.biru { border-top-color:#3b82f6; }
        .stat-mini.hijau { border-top-color:#22c55e; }
        .stat-mini.abu { border-top-color:#94a3b8; }
        .stat-mini.warn { border-top-color:#f59e0b; background:#fffaf0; }
        .stat-mini.merah { border-top-color:#ef4444; }

        .toolbar { display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-bottom:12px; }
        .toolbar .search-input { flex:1; min-width:220px; max-width:340px; padding:10px 14px; border:1px solid #ddd; border-radius:8px; }
        .toolbar select { padding:10px 12px; border:1px solid #ddd; border-radius:8px; }
        .toolbar .spacer { flex:1; }

        .badge-akun { display:inline-flex; align-items:center; gap:4px; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:600; white-space:nowrap; }
        .badge-akun.tanpa_akun { background:#eceff3; color:#5b6573; }
        .badge-akun.belum_aktif { background:#fdf1de; color:#b35c00; }
        .badge-akun.aktif { background:#e2f8ea; color:#1e8449; }
        .badge-akun.nonaktif { background:#fde8e8; color:#b3261e; }
        .badge-akun.berminat { background:#e2f8ea; color:#1e8449; }
        .badge-akun.tidak_berminat { background:#fde8e8; color:#b3261e; }

        .sub-info { display:block; font-size:11px; color:#888; margin-top:3px; }

        .table-scroll { max-height:580px; overflow:auto; border:1px solid #e5e7eb; border-radius:10px; }
        .table-scroll .data-table { margin:0; }
        .table-scroll thead th { position:sticky; top:0; background:#f8fafc; z-index:2; box-shadow:0 1px 0 #e5e7eb; }

        .action-cell { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
        .action-cell form { margin:0; }

        .btn-kecil { font-size:12px; padding:5px 10px; border:1px solid #d5d9e0; background:#fff; border-radius:6px; cursor:pointer; text-decoration:none; color:#333; display:inline-flex; align-items:center; gap:4px; }
        .btn-kecil:hover { background:#f4f6f9; }
        .btn-nilai { background:#eef3ff; border-color:#cbd8ff; color:#2448a5; }
        .btn-nilai:hover { background:#dfe8ff; }
        .btn-kartu { background:#f3f0ff; border-color:#d9d0ff; color:#5b3fc4; }
        .btn-kartu:hover { background:#e8e2ff; }

        .minat-aksi { display:flex; gap:5px; flex-wrap:wrap; margin-top:6px; }
        .minat-aksi form { margin:0; }
        .btn-minat-ya { background:#e2f8ea; border-color:#b7e6c9; color:#1e8449; }
        .btn-minat-ya:hover { background:#d0f1de; }
        .btn-minat-tidak { background:#fde8e8; border-color:#f5c2c0; color:#b3261e; }
        .btn-minat-tidak:hover { background:#fbd5d3; }

        .info-alur { font-size:13px; color:#444; line-height:1.7; }
        .info-alur li { margin-bottom:2px; }

        .baris-siswa.perlu-dihubungi td:first-child { box-shadow:inset 3px 0 0 #f0a020; }
        .baris-siswa.tidak-ikut td { color:#888; }

        @media (max-width:768px) {
            .toolbar .search-input { max-width:none; width:100%; }
            .table-scroll { max-height:65vh; }
        }
    </style>
</head>

<body>
<%
    const R = (typeof ringkasan !== 'undefined' && ringkasan)
        ? ringkasan
        : { total: Array.isArray(siswaList) ? siswaList.length : 0, tanpaAkun: 0, aktif: 0, nonaktif: 0, berminat: 0, tidakBerminat: 0, belumKonfirmasi: 0 };

    const filterAwalVal = (typeof filterAwal !== 'undefined' && filterAwal) ? filterAwal : '';
    const daftarSiswa = Array.isArray(siswaList) ? siswaList : [];
    const adaKartu = (Number(R.aktif) + Number(R.nonaktif)) > 0;
    const sudahTerkunci = typeof terkunci !== 'undefined' && Boolean(terkunci);
%>

<div class="app-layout">
    <%- include('../partials/sidebar', { user: user, activePage: activePage }) %>

    <div class="main-content">
        <%- include('../partials/topbar', { user: user, pageTitle: pageTitle }) %>

        <div class="content-wrapper">

            <!-- Panduan -->
            <div class="panel" style="background:#f4f8ff;">
                <div class="panel-header-row" style="cursor:pointer;" onclick="document.getElementById('tutorialSiswa').classList.toggle('show')">
                    <div class="panel-header">
                        <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-question-circle-fill"></i></div>
                        <h3>Cara Mengelola Data Siswa &amp; Akun</h3>
                    </div>
                    <i class="bi bi-chevron-down"></i>
                </div>

                <div id="tutorialSiswa" class="tutorial-content">
                    <ol class="info-alur" style="padding-left:20px;">
                        <li>Unduh template, isi data siswa, lalu <strong>Import Excel</strong> atau gunakan <strong>Tambah Siswa</strong>.</li>
                        <li>Klik <strong>Buat Akun Siswa</strong> satu kali, akun dibuat untuk semua siswa yang belum punya akun.</li>
                        <li>Cetak kartu (semua atau per siswa) lalu bagikan kepada siswa melalui saluran yang aman.</li>
                        <li>Siswa login, mengganti password awal, lalu menjawab minat dan 3 pertanyaan sendiri.</li>
                        <li>
                            Siswa yang masih <strong>Belum merespons</strong> dapat diubah statusnya oleh operator
                            menjadi <strong>Berminat</strong> atau <strong>Tidak berminat</strong> lewat tombol di kolom Status Minat.
                            Status yang sudah Berminat atau Tidak berminat tidak dapat diubah lagi.
                        </li>
                        <li>
                            Pengisian nilai oleh operator (Input/Edit Nilai dan Import Nilai) baru aktif setelah
                            <strong>tidak ada lagi siswa yang Belum merespons</strong>.
                        </li>
                        <li>Nilai dapat diubah selama hasil belum difinalisasi. Setiap perubahan mengosongkan hasil ranking dan perlu dihitung ulang.</li>
                        <li>Setelah finalisasi, seluruh data terkunci dan siswa hanya melihat pengumuman hasil seleksi.</li>
                    </ol>
                </div>
            </div>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
            <% } %>

            <!-- Flash pembuatan akun -->
            <% if (typeof akunSiswaFlash !== 'undefined' && akunSiswaFlash) { %>
                <div class="alert <%= akunSiswaFlash.tipe === 'error' ? 'alert-danger' : 'alert-success' %>">
                    <% if (akunSiswaFlash.tipe === 'error') { %>
                        <i class="bi bi-exclamation-circle-fill"></i> <%= akunSiswaFlash.pesan %>
                    <% } else { %>
                        <i class="bi bi-check-circle-fill"></i>
                        Akun dibuat: <strong><%= akunSiswaFlash.dibuat || 0 %></strong> |
                        Sudah memiliki akun: <strong><%= akunSiswaFlash.dilewati || 0 %></strong> |
                        Gagal: <strong><%= akunSiswaFlash.jumlahGagal || 0 %></strong>
                        <% if (akunSiswaFlash.otomatisBerminat > 0) { %>
                            | Otomatis berminat (nilai sudah ada): <strong><%= akunSiswaFlash.otomatisBerminat %></strong>
                        <% } %>
                        <% if (akunSiswaFlash.jumlahGagal > 0 && Array.isArray(akunSiswaFlash.gagal)) { %>
                            <ul style="margin-top:6px;">
                                <% akunSiswaFlash.gagal.forEach(function(g) { %>
                                    <li><%= g.nama %> (NISN: <%= g.nisn || '-' %>): <%= g.alasan %></li>
                                <% }) %>
                            </ul>
                        <% } %>

                        <% if (akunSiswaFlash.dibuat > 0) { %>
                            <div style="margin-top:6px;">
                                <a href="/akun-siswa/kartu" target="_blank" rel="noopener" class="btn-kecil btn-kartu">
                                    <i class="bi bi-printer-fill"></i> Cetak Semua Kartu
                                </a>
                            </div>
                        <% } %>
                    <% } %>
                </div>
            <% } %>

            <% if (sudahTerkunci) { %>
                <div class="alert" style="background:#fdf1de;color:#b35c00;">
                    <i class="bi bi-lock-fill"></i>
                    Hasil seleksi sudah difinalisasi. Seluruh data siswa, akun, dan nilai terkunci.
                </div>
            <% } %>

            <!-- Ringkasan -->
            <div class="stat-row">
                <div class="stat-mini biru" data-filter="" data-minat="">
                    <div class="angka"><%= R.total || 0 %></div>
                    <div class="label">Total siswa</div>
                </div>
                <div class="stat-mini abu" data-filter="tanpa_akun">
                    <div class="angka"><%= R.tanpaAkun || 0 %></div>
                    <div class="label">Belum punya akun</div>
                </div>
                <div class="stat-mini hijau" data-filter="aktif">
                    <div class="angka"><%= R.aktif || 0 %></div>
                    <div class="label">Akun aktif</div>
                </div>
                <div class="stat-mini merah" data-filter="nonaktif">
                    <div class="angka"><%= R.nonaktif || 0 %></div>
                    <div class="label">Akun nonaktif</div>
                </div>
                <div class="stat-mini hijau" data-minat="berminat">
                    <div class="angka"><%= R.berminat || 0 %></div>
                    <div class="label">Berminat (ikut seleksi)</div>
                </div>
                <div class="stat-mini <%= R.belumKonfirmasi > 0 ? 'warn' : 'abu' %>" data-minat="belum_respon">
                    <div class="angka"><%= R.belumKonfirmasi || 0 %></div>
                    <div class="label">Belum merespons</div>
                </div>
                <div class="stat-mini merah" data-minat="tidak_berminat">
                    <div class="angka"><%= R.tidakBerminat || 0 %></div>
                    <div class="label">Tidak berminat</div>
                </div>
            </div>

            <!-- Tabel -->
            <div class="panel">
                <div class="panel-header-row">
                    <div class="panel-header">
                        <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-person-fill"></i></div>
                        <h3>Daftar Siswa Calon Kelas Digital</h3>
                    </div>

                    <div style="display:flex;gap:10px;flex-wrap:wrap;">
                        <a href="/admin/siswa/template" class="btn-secondary" style="text-decoration:none;display:flex;align-items:center;gap:6px;">
                            <i class="bi bi-download"></i> Unduh Template
                        </a>

                        <% if (!sudahTerkunci) { %>
                            <button type="button" class="btn-secondary" onclick="bukaModal('modalImport')">
                                <i class="bi bi-file-earmark-excel-fill"></i> Import Excel
                            </button>
                            <button type="button" class="btn-primary" onclick="bukaModal('modalTambah')">
                                <i class="bi bi-plus-lg"></i> Tambah Siswa
                            </button>
                        <% } %>
                    </div>
                </div>

                <div class="toolbar">
                    <input type="text" id="searchSiswa" class="search-input" placeholder="Cari nama atau NISN..." autocomplete="off">

                    <select id="filterStatus">
                        <option value="">Semua status akun</option>
                        <option value="tanpa_akun">Belum punya akun</option>
                        <option value="aktif">Aktif</option>
                        <option value="nonaktif">Nonaktif</option>
                    </select>

                    <select id="filterMinat">
                        <option value="">Semua status minat</option>
                        <option value="berminat">Berminat</option>
                        <option value="belum_respon">Belum merespons</option>
                        <option value="tidak_berminat">Tidak berminat</option>
                    </select>

                    <span id="hitungTampil" style="font-size:12px;color:#777;"></span>
                    <span class="spacer"></span>

                    <% if (adaKartu) { %>
                        <a href="/akun-siswa/kartu" target="_blank" rel="noopener" class="btn-kecil btn-kartu" style="padding:9px 12px;">
                            <i class="bi bi-printer-fill"></i> Cetak Semua Kartu
                        </a>
                    <% } %>

                    <% if (R.tanpaAkun > 0 && !sudahTerkunci) { %>
                        <form action="/akun-siswa/generate" method="POST" style="margin:0;" onsubmit="return prosesGenerate(this)">
                            <button type="submit" class="btn-primary">
                                <i class="bi bi-person-plus-fill"></i> Buat Akun Siswa (<%= R.tanpaAkun %>)
                            </button>
                        </form>
                    <% } else if (R.total > 0) { %>
                        <span class="badge-akun aktif"><i class="bi bi-check-circle-fill"></i> Semua siswa sudah punya akun</span>
                    <% } %>
                </div>

                <div class="table-scroll">
                    <table class="data-table" id="tabelSiswa">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>NISN</th>
                                <th>Nama</th>
                                <th>JK</th>
                                <th>Sekolah Asal</th>
                                <th>PIP/PKH</th>
                                <th>Status Akun</th>
                                <th>Status Minat</th>
                                <th>Nilai</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (daftarSiswa.length === 0) { %>
                                <tr>
                                    <td colspan="10" class="empty-state">Belum ada data siswa. Tambahkan manual atau import dari Excel.</td>
                                </tr>
                            <% } %>

                            <% daftarSiswa.forEach(function(s, index) {
                                const punyaAkun = Boolean(s.punya_akun);
                                const st = !punyaAkun ? 'tanpa_akun' : (s.status_akun || 'aktif');
                                const minat = punyaAkun ? (s.status_minat || 'belum_respon') : 'belum_respon';

                                const labelAkun = { tanpa_akun: 'Belum Ada Akun', aktif: 'Aktif', nonaktif: 'Nonaktif' }[st] || 'Tidak Dikenal';
                                const labelMinat = { berminat: 'Berminat', belum_respon: 'Belum merespons', tidak_berminat: 'Tidak berminat' }[minat] || 'Belum merespons';
                                const kelasMinat = { berminat: 'berminat', belum_respon: 'belum_aktif', tidak_berminat: 'tidak_berminat' }[minat] || 'tanpa_akun';
                                const bisaNilai = minat !== 'tidak_berminat';
                                const bisaUbahMinat = punyaAkun && minat === 'belum_respon' && !sudahTerkunci;
                            %>
                                <tr class="baris-siswa <%= minat === 'belum_respon' ? 'perlu-dihubungi' : '' %> <%= minat === 'tidak_berminat' ? 'tidak-ikut' : '' %>"
                                    data-nama="<%= (s.nama || '').toLowerCase() %>"
                                    data-nisn="<%= s.nisn || '' %>"
                                    data-status="<%= st %>"
                                    data-minat="<%= minat %>">

                                    <td class="no-urut"><%= index + 1 %></td>
                                    <td><%= s.nisn || '-' %></td>
                                    <td><%= s.nama || '-' %></td>
                                    <td><%= s.jenis_kelamin === 'L' ? 'Laki-laki' : (s.jenis_kelamin === 'P' ? 'Perempuan' : '-') %></td>
                                    <td><%= s.sekolah_asal || '-' %></td>

                                    <td>
                                        <span class="badge badge-<%= s.status_pip_pkh ? 'green' : 'red' %>">
                                            <%= s.status_pip_pkh ? 'Ya' : 'Tidak' %>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge-akun <%= st %>"><%= labelAkun %></span>
                                        <% if (punyaAkun && s.wajib_ganti_password) { %>
                                            <span class="sub-info">Belum ganti password awal</span>
                                        <% } else if (punyaAkun && s.last_login) { %>
                                            <span class="sub-info">Login terakhir: <%= new Date(s.last_login).toLocaleDateString('id-ID') %></span>
                                        <% } %>
                                    </td>

                                    <td>
                                        <span class="badge-akun <%= kelasMinat %>"><%= labelMinat %></span>

                                        <% if (bisaUbahMinat) { %>
                                            <div class="minat-aksi">
                                                <form action="/admin/siswa/minat" method="POST"
                                                      onsubmit="return confirmDelete(this, 'Ubah status minat siswa ini menjadi Berminat? Siswa akan ikut perankingan dan status ini tidak dapat diubah lagi.')">
                                                    <input type="hidden" name="id_siswa" value="<%= s.id_siswa %>">
                                                    <input type="hidden" name="status_minat" value="berminat">
                                                    <button type="submit" class="btn-kecil btn-minat-ya" title="Tandai siswa berminat">
                                                        <i class="bi bi-check-lg"></i> Berminat
                                                    </button>
                                                </form>

                                                <form action="/admin/siswa/minat" method="POST"
                                                      onsubmit="return confirmDelete(this, 'Ubah status minat siswa ini menjadi Tidak berminat? Akun siswa akan dinonaktifkan dan status ini tidak dapat diubah lagi.')">
                                                    <input type="hidden" name="id_siswa" value="<%= s.id_siswa %>">
                                                    <input type="hidden" name="status_minat" value="tidak_berminat">
                                                    <button type="submit" class="btn-kecil btn-minat-tidak" title="Tandai siswa tidak berminat">
                                                        <i class="bi bi-x-lg"></i> Tidak
                                                    </button>
                                                </form>
                                            </div>
                                        <% } else if (!punyaAkun && !sudahTerkunci) { %>
                                            <span class="sub-info">Buat akun dulu untuk mengubah status</span>
                                        <% } %>
                                    </td>

                                    <td>
                                        <% if (bisaNilai) { %>
                                            <a class="btn-kecil btn-nilai" href="/admin/nilai/<%= s.id_siswa %>" title="Input atau edit nilai siswa">
                                                <i class="bi bi-pencil-square"></i>
                                                <%= sudahTerkunci ? 'Lihat' : 'Input/Edit' %>
                                            </a>
                                        <% } else { %>
                                            <span style="color:#999;font-size:12px;">Tidak ikut</span>
                                        <% } %>
                                    </td>

                                    <td class="action-cell">
                                        <% if (punyaAkun) { %>
                                            <a class="btn-kecil btn-kartu" href="/akun-siswa/<%= s.id_siswa %>/kartu" target="_blank" rel="noopener" title="Cetak kartu akun">
                                                <i class="bi bi-printer-fill"></i> Kartu
                                            </a>
                                        <% } %>

                                        <% if (punyaAkun && st === 'aktif' && !sudahTerkunci) { %>
                                            <form action="/akun-siswa/<%= s.id_siswa %>/reset-password" method="POST"
                                                  onsubmit="return confirmDelete(this, 'Reset password akun siswa ini? Password lama tidak akan berlaku lagi.')">
                                                <button type="submit" class="btn-kecil"><i class="bi bi-key-fill"></i> Reset</button>
                                            </form>
                                        <% } %>

                                        <% if (!sudahTerkunci) { %>
                                            <button type="button" class="btn-icon" title="Edit data siswa"
                                                    onclick="bukaModalEdit(this)"
                                                    data-siswa="<%= encodeURIComponent(JSON.stringify(s)) %>">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                            <form action="/admin/siswa/delete/<%= s.id_siswa %>" method="POST"
                                                  onsubmit="return confirmDelete(this, 'Hapus data siswa ini beserta akun dan nilainya?')">
                                                <button type="submit" class="btn-icon btn-icon-danger" title="Hapus data siswa">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <span style="color:#999;font-size:12px;">Terkunci</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>

                            <tr id="barisKosongCari" style="display:none;">
                                <td colspan="10" class="empty-state">Tidak ada siswa yang cocok dengan pencarian atau filter.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <%- include('../partials/footer') %>
        </div>
    </div>
</div>

<!-- Modal Tambah -->
<div class="modal-overlay" id="modalTambah">
    <div class="modal-box">
        <div class="modal-header">
            <h3><i class="bi bi-person-plus-fill"></i> Tambah Data Siswa</h3>
            <button type="button" class="modal-close" onclick="tutupModal('modalTambah')">&times;</button>
        </div>

        <form action="/admin/siswa/create" method="POST" onsubmit="return validasiFormSiswa(this)">
            <label>NISN (Hanya Angka)</label>
            <input type="text" name="nisn" id="nisn_tambah" required autocomplete="off" maxlength="20">

            <label>Nama Lengkap</label>
            <input type="text" name="nama" id="nama_tambah" required autocomplete="off">

            <label>Jenis Kelamin</label>
            <select name="jenis_kelamin" required>
                <option value="L">Laki-laki</option>
                <option value="P">Perempuan</option>
            </select>

            <label>Sekolah Asal</label>
            <input type="text" name="sekolah_asal" id="sekolah_tambah" required autocomplete="off">

            <label>Pekerjaan Ayah</label>
            <input type="text" name="pekerjaan_ayah" id="ayah_tambah" required autocomplete="off">

            <label>Pekerjaan Ibu</label>
            <input type="text" name="pekerjaan_ibu" id="ibu_tambah" required autocomplete="off">

            <label>Penerima PIP/PKH?</label>
            <select name="status_pip_pkh">
                <option value="tidak">Tidak</option>
                <option value="ya">Ya</option>
            </select>

            <p id="peringatan_siswa_tambah" style="color:#e74c3c;font-size:12px;margin-top:8px;display:none;"></p>

            <div class="modal-footer">
                <button type="button" class="btn-secondary" onclick="tutupModal('modalTambah')">Batal</button>
                <button type="submit" class="btn-primary">Simpan</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Edit -->
<div class="modal-overlay" id="modalEdit">
    <div class="modal-box">
        <div class="modal-header">
            <h3><i class="bi bi-pencil-square"></i> Edit Data Siswa</h3>
            <button type="button" class="modal-close" onclick="tutupModal('modalEdit')">&times;</button>
        </div>

        <form action="/admin/siswa/update" method="POST" onsubmit="return validasiFormSiswa(this)">
            <input type="hidden" name="id_siswa" id="edit_id_siswa">

            <label>NISN (Hanya Angka)</label>
            <input type="text" name="nisn" id="edit_nisn" required autocomplete="off" maxlength="20">

            <label>Nama Lengkap</label>
            <input type="text" name="nama" id="edit_nama" required autocomplete="off">

            <label>Jenis Kelamin</label>
            <select name="jenis_kelamin" id="edit_jk" required>
                <option value="L">Laki-laki</option>
                <option value="P">Perempuan</option>
            </select>

            <label>Sekolah Asal</label>
            <input type="text" name="sekolah_asal" id="edit_sekolah" required autocomplete="off">

            <label>Pekerjaan Ayah</label>
            <input type="text" name="pekerjaan_ayah" id="edit_ayah" required autocomplete="off">

            <label>Pekerjaan Ibu</label>
            <input type="text" name="pekerjaan_ibu" id="edit_ibu" required autocomplete="off">

            <label>Penerima PIP/PKH?</label>
            <select name="status_pip_pkh" id="edit_pip">
                <option value="tidak">Tidak</option>
                <option value="ya">Ya</option>
            </select>

            <p id="peringatan_siswa_edit" style="color:#e74c3c;font-size:12px;margin-top:8px;display:none;"></p>

            <div class="modal-footer">
                <button type="button" class="btn-secondary" onclick="tutupModal('modalEdit')">Batal</button>
                <button type="submit" class="btn-primary">Simpan Perubahan</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Import -->
<div class="modal-overlay" id="modalImport">
    <div class="modal-box">
        <div class="modal-header">
            <h3><i class="bi bi-file-earmark-excel-fill"></i> Import Data dari Excel</h3>
            <button type="button" class="modal-close" onclick="tutupModal('modalImport')">&times;</button>
        </div>

        <form action="/admin/siswa/import" method="POST" enctype="multipart/form-data">
            <p style="font-size:13px;color:#777;margin-bottom:15px;">
                Pastikan file Excel memiliki kolom NISN, NAMA SISWA, JENIS KELAMIN SISWA, ASAL SEKOLAH,
                PEKERJAAN AYAH, PEKERJAAN IBU, dan status penerima PIP/PKH sesuai template yang disediakan sistem.
            </p>

            <label>Pilih File Excel (.xlsx / .xls)</label>
            <input type="file" name="fileExcel" accept=".xlsx,.xls" required>

            <div class="modal-footer">
                <button type="button" class="btn-secondary" onclick="tutupModal('modalImport')">Batal</button>
                <button type="submit" class="btn-primary">Import Sekarang</button>
            </div>
        </form>
    </div>
</div>

<script>
    // ===== MODAL =====
    function bukaModal(id) {
        const modal = document.getElementById(id);
        if (modal) modal.style.display = 'flex';
    }

    function tutupModal(id) {
        const modal = document.getElementById(id);
        if (modal) modal.style.display = 'none';
    }

    document.querySelectorAll('.modal-overlay').forEach(function(modal) {
        modal.addEventListener('click', function(event) {
            if (event.target === modal) modal.style.display = 'none';
        });
    });

    // Buat akun: satu klik, tombol dikunci agar tidak terkirim dua kali.
    function prosesGenerate(form) {
        const button = form.querySelector('button');
        if (button) {
            button.disabled = true;
            button.innerHTML = '<i class="bi bi-hourglass-split"></i> Membuat akun...';
        }
        return true;
    }

    // ===== PENCARIAN DAN FILTER =====
    (function() {
        const inputCari = document.getElementById('searchSiswa');
        const selectFilter = document.getElementById('filterStatus');
        const selectMinat = document.getElementById('filterMinat');
        const barisKosong = document.getElementById('barisKosongCari');
        const hitungEl = document.getElementById('hitungTampil');

        function terapkanFilter() {
            const kata = inputCari.value.trim().toLowerCase();
            const status = selectFilter.value;
            const minat = selectMinat.value;
            let tampil = 0;

            document.querySelectorAll('.baris-siswa').forEach(function(row) {
                const nama = row.dataset.nama || '';
                const nisn = row.dataset.nisn || '';

                const cocok =
                    (!kata || nama.includes(kata) || nisn.includes(kata)) &&
                    (!status || row.dataset.status === status) &&
                    (!minat || row.dataset.minat === minat);

                row.style.display = cocok ? '' : 'none';

                if (cocok) {
                    tampil++;
                    const nomor = row.querySelector('.no-urut');
                    if (nomor) nomor.textContent = tampil;
                }
            });

            if (barisKosong) barisKosong.style.display = tampil === 0 ? '' : 'none';
            if (hitungEl) hitungEl.textContent = tampil + ' siswa ditampilkan';
        }

        inputCari.addEventListener('input', terapkanFilter);
        selectFilter.addEventListener('change', terapkanFilter);
        selectMinat.addEventListener('change', terapkanFilter);

        document.querySelectorAll('.stat-mini').forEach(function(kartu) {
            kartu.addEventListener('click', function() {
                selectFilter.value = kartu.dataset.filter || '';
                selectMinat.value = kartu.dataset.minat || '';
                terapkanFilter();
            });
        });

        selectFilter.value = <%- JSON.stringify(filterAwalVal) %>;
        terapkanFilter();
    })();

    // ===== MODAL EDIT =====
    function bukaModalEdit(button) {
        let s;

        try {
            s = JSON.parse(decodeURIComponent(button.dataset.siswa));
        } catch (error) {
            alert('Data siswa tidak dapat dibaca. Muat ulang halaman.');
            return;
        }

        document.getElementById('edit_id_siswa').value = s.id_siswa || '';
        document.getElementById('edit_nisn').value = s.nisn || '';
        document.getElementById('edit_nama').value = s.nama || '';
        document.getElementById('edit_jk').value = s.jenis_kelamin || 'L';
        document.getElementById('edit_sekolah').value = s.sekolah_asal || '';
        document.getElementById('edit_ayah').value = s.pekerjaan_ayah || '';
        document.getElementById('edit_ibu').value = s.pekerjaan_ibu || '';
        document.getElementById('edit_pip').value = Number(s.status_pip_pkh) === 1 ? 'ya' : 'tidak';

        const peringatan = document.getElementById('peringatan_siswa_edit');
        peringatan.textContent = '';
        peringatan.style.display = 'none';

        bukaModal('modalEdit');
    }

    // ===== VALIDASI INPUT =====
    const REGEX_ANGKA_SAJA = /^[0-9]+$/;
    const REGEX_HURUF_SAJA_SISWA = /^[A-Za-zÀ-ÖØ-öø-ÿ]+(?: [A-Za-zÀ-ÖØ-öø-ÿ]+)*$/;
    const REGEX_SEKOLAH_SISWA = /^[A-Za-zÀ-ÖØ-öø-ÿ0-9]+(?: [A-Za-zÀ-ÖØ-öø-ÿ0-9]+)*$/;

    function sanitizeAngka(input) {
        input.value = input.value.replace(/[^0-9]/g, '');
    }

    function sanitizeHurufSiswa(input) {
        let val = input.value.replace(/[^A-Za-zÀ-ÖØ-öø-ÿ\s]/g, '');
        input.value = val.replace(/\s{2,}/g, ' ');
    }

    function sanitizeSekolahSiswa(input) {
        let val = input.value.replace(/[^A-Za-zÀ-ÖØ-öø-ÿ0-9\s]/g, '');
        input.value = val.replace(/\s{2,}/g, ' ');
    }

    ['nisn_tambah', 'edit_nisn'].forEach(function(id) {
        const el = document.getElementById(id);
        if (el) el.addEventListener('input', function() { sanitizeAngka(this); });
    });

    ['nama_tambah', 'ayah_tambah', 'ibu_tambah', 'edit_nama', 'edit_ayah', 'edit_ibu'].forEach(function(id) {
        const el = document.getElementById(id);
        if (el) el.addEventListener('input', function() { sanitizeHurufSiswa(this); });
    });

    ['sekolah_tambah', 'edit_sekolah'].forEach(function(id) {
        const el = document.getElementById(id);
        if (el) el.addEventListener('input', function() { sanitizeSekolahSiswa(this); });
    });

    function validasiFormSiswa(form) {
        const isEdit = form.querySelector('#edit_id_siswa') !== null;
        const peringatanEl = document.getElementById(isEdit ? 'peringatan_siswa_edit' : 'peringatan_siswa_tambah');

        const nisnVal = form.elements.nisn.value.trim();
        const namaVal = form.elements.nama.value.trim();
        const sekolahVal = form.elements.sekolah_asal.value.trim();
        const ayahVal = form.elements.pekerjaan_ayah.value.trim();
        const ibuVal = form.elements.pekerjaan_ibu.value.trim();

        function gagal(pesan, field) {
            peringatanEl.textContent = pesan;
            peringatanEl.style.display = 'block';
            if (field) field.focus();
            return false;
        }

        peringatanEl.textContent = '';
        peringatanEl.style.display = 'none';

        if (!nisnVal || !REGEX_ANGKA_SAJA.test(nisnVal)) return gagal('NISN wajib diisi dan hanya boleh berisi angka.', form.elements.nisn);
        if (!namaVal || !REGEX_HURUF_SAJA_SISWA.test(namaVal)) return gagal('Nama wajib diisi dan hanya boleh berisi huruf serta spasi.', form.elements.nama);
        if (!sekolahVal || !REGEX_SEKOLAH_SISWA.test(sekolahVal)) return gagal('Sekolah asal wajib diisi dengan huruf, angka, dan spasi.', form.elements.sekolah_asal);
        if (!ayahVal || !REGEX_HURUF_SAJA_SISWA.test(ayahVal)) return gagal('Pekerjaan ayah wajib diisi dengan huruf dan spasi.', form.elements.pekerjaan_ayah);
        if (!ibuVal || !REGEX_HURUF_SAJA_SISWA.test(ibuVal)) return gagal('Pekerjaan ibu wajib diisi dengan huruf dan spasi.', form.elements.pekerjaan_ibu);

        form.elements.nisn.value = nisnVal;
        form.elements.nama.value = namaVal;
        form.elements.sekolah_asal.value = sekolahVal;
        form.elements.pekerjaan_ayah.value = ayahVal;
        form.elements.pekerjaan_ibu.value = ibuVal;

        return true;
    }
</script>
</body>
</html>