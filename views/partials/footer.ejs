<style>
    /* Sticky footer: kalau konten pendek, footer tetap di bawah viewport.
       Kalau konten panjang, halaman scroll normal dan footer ikut di bawah konten. */
    .content-wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }
    .footer {
        margin-top: auto;
        width: 100%;
        background: transparent;
        text-align: center;
        padding: 18px 15px 14px;
        border-top: 1px solid #edf1f7;
    }
    .footer p {
        margin: 2px 0;
        font-size: 11px;
        color: #9aa3b2;
        letter-spacing: 0.2px;
    }
    .footer p:first-child {
        color: #7a8494;
        font-weight: 500;
    }
</style>

<div class="footer">
    <p>© 2026 SMAN 12 Padang. Semua hak dilindungi.</p>
    <p>Sistem Pendukung Keputusan Penempatan Siswa Kelas Digital</p>
</div>

<div class="modal-overlay" id="confirmModal">
    <div class="modal-box" style="max-width:400px; text-align:center;">
        <div style="width:55px;height:55px;background:#fdecea;color:#e74c3c;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 15px;">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h3 style="color:#0b2545; margin-bottom:10px;">Konfirmasi Tindakan</h3>
        <p id="confirmMessage" style="color:#666; font-size:14px; margin-bottom:20px;"></p>
        <div class="modal-footer" style="justify-content:center;">
            <button type="button" class="btn-secondary" onclick="closeConfirmModal()">Batal</button>
            <button type="button" class="btn-primary" style="background:#e74c3c;" id="confirmDeleteBtn">Ya, Lanjutkan</button>
        </div>
    </div>
</div>

<script>
    let formToSubmit = null;

    function confirmDelete(formElement, message) {
        formToSubmit = formElement;
        document.getElementById('confirmMessage').innerText = message || 'Apakah Anda yakin ingin melanjutkan tindakan ini?';
        document.getElementById('confirmModal').style.display = 'flex';
        return false;
    }

    function closeConfirmModal() {
        document.getElementById('confirmModal').style.display = 'none';
        formToSubmit = null;
    }

    document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
        if (formToSubmit) formToSubmit.submit();
        closeConfirmModal();
    });
</script>

<% if (typeof wajibGantiPassword !== 'undefined' && wajibGantiPassword) { %>
<style>
    #wajibGantiPasswordOverlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(4, 12, 26, 0.88);
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }
    #wajibGantiPasswordOverlay .wgp-box {
        background: #fff;
        border-radius: 14px;
        max-width: 430px;
        width: 100%;
        padding: 30px 28px;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        position: relative;
    }
    #wajibGantiPasswordOverlay .wgp-arrow {
        font-size: 34px;
        color: #f39c12;
        animation: wgpBounce 1.1s infinite;
        margin-bottom: 6px;
    }
    @keyframes wgpBounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(10px); }
    }
    #wajibGantiPasswordOverlay .wgp-icon {
        width: 60px; height: 60px;
        background: #fdf1de;
        color: #b35c00;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 28px;
        margin: 0 auto 14px;
    }
    #wajibGantiPasswordOverlay h3 {
        color: #0b2545;
        margin-bottom: 8px;
    }
    #wajibGantiPasswordOverlay p.wgp-desc {
        color: #666;
        font-size: 14px;
        margin-bottom: 20px;
        line-height: 1.6;
    }
    #wajibGantiPasswordOverlay label {
        display: block;
        text-align: left;
        font-size: 13px;
        color: #333;
        margin: 12px 0 4px;
    }
    #wajibGantiPasswordOverlay input {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 14px;
        box-sizing: border-box;
    }
    #wajibGantiPasswordOverlay .wgp-input-wrap {
        position: relative;
    }
    #wajibGantiPasswordOverlay .wgp-input-wrap input {
        padding-right: 38px;
    }
    #wajibGantiPasswordOverlay .wgp-toggle-eye {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #999;
        font-size: 15px;
        user-select: none;
    }
    #wajibGantiPasswordOverlay .wgp-toggle-eye:hover {
        color: #555;
    }
    #wajibGantiPasswordOverlay .wgp-hint {
        text-align: left;
        font-size: 11px;
        color: #999;
        margin-top: 4px;
        transition: color 0.2s;
    }
    #wajibGantiPasswordOverlay .wgp-hint.ok {
        color: #2ecc71;
    }
    #wajibGantiPasswordOverlay .wgp-hint.bad {
        color: #e74c3c;
    }
    #wajibGantiPasswordOverlay input.wgp-valid {
        border-color: #2ecc71;
    }
    #wajibGantiPasswordOverlay input.wgp-invalid {
        border-color: #e74c3c;
    }
    #wajibGantiPasswordOverlay .wgp-submit {
        margin-top: 20px;
        width: 100%;
        padding: 11px;
        background: #0b2545;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s, opacity 0.2s;
    }
    #wajibGantiPasswordOverlay .wgp-submit:hover {
        background: #123566;
    }
    #wajibGantiPasswordOverlay .wgp-submit:disabled {
        background: #a9b3c2;
        cursor: not-allowed;
    }
    #wajibGantiPasswordOverlay .wgp-error {
        color: #e74c3c;
        font-size: 12px;
        margin-top: 10px;
        display: none;
    }
    #wajibGantiPasswordOverlay .wgp-box.wgp-shake {
        animation: wgpShake 0.4s;
    }
    @keyframes wgpShake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-6px); }
        75% { transform: translateX(6px); }
    }
</style>

<div id="wajibGantiPasswordOverlay">
    <div class="wgp-box" id="wgpBox">
        <div class="wgp-arrow"><i class="bi bi-arrow-down-circle-fill"></i></div>
        <div class="wgp-icon"><i class="bi bi-shield-lock-fill"></i></div>
        <h3>Wajib Ganti Password</h3>
        <p class="wgp-desc">
            Kamu masih pakai password sementara hasil reset. Demi keamanan akun,
            silakan buat password baru sebelum melanjutkan ke sistem.
        </p>
        <form action="/ganti-password-wajib" method="POST" id="wgpForm" onsubmit="return validasiFormGantiWajib(this)">
            <label>Password Baru</label>
            <div class="wgp-input-wrap">
                <input type="password" name="newPassword" id="wgp_newPassword" required minlength="6" autocomplete="new-password">
                <span class="wgp-toggle-eye" data-target="wgp_newPassword"><i class="bi bi-eye-fill"></i></span>
            </div>
            <p class="wgp-hint" id="wgp_hint_new">Minimal 6 karakter.</p>

            <label>Konfirmasi Password Baru</label>
            <div class="wgp-input-wrap">
                <input type="password" name="confirmPassword" id="wgp_confirmPassword" required minlength="6" autocomplete="new-password">
                <span class="wgp-toggle-eye" data-target="wgp_confirmPassword"><i class="bi bi-eye-fill"></i></span>
            </div>
            <p class="wgp-hint" id="wgp_hint_confirm">Ulangi password baru di atas.</p>

            <p class="wgp-error" id="wgp_error"></p>
            <button type="submit" class="wgp-submit" id="wgp_submitBtn" disabled>Simpan Password Baru</button>
        </form>
    </div>
</div>

<script>
    (function() {
        const newPassEl = document.getElementById('wgp_newPassword');
        const confirmPassEl = document.getElementById('wgp_confirmPassword');
        const hintNewEl = document.getElementById('wgp_hint_new');
        const hintConfirmEl = document.getElementById('wgp_hint_confirm');
        const submitBtn = document.getElementById('wgp_submitBtn');

        document.querySelectorAll('#wajibGantiPasswordOverlay .wgp-toggle-eye').forEach(function(eyeEl) {
            eyeEl.addEventListener('click', function() {
                const targetInput = document.getElementById(this.getAttribute('data-target'));
                const icon = this.querySelector('i');
                if (targetInput.type === 'password') {
                    targetInput.type = 'text';
                    icon.classList.remove('bi-eye-fill');
                    icon.classList.add('bi-eye-slash-fill');
                } else {
                    targetInput.type = 'password';
                    icon.classList.remove('bi-eye-slash-fill');
                    icon.classList.add('bi-eye-fill');
                }
            });
        });

        function cekValidasiRealtime() {
            const newPass = newPassEl.value;
            const confirmPass = confirmPassEl.value;

            if (newPass.length === 0) {
                newPassEl.classList.remove('wgp-valid', 'wgp-invalid');
                hintNewEl.textContent = 'Minimal 6 karakter.';
                hintNewEl.className = 'wgp-hint';
            } else if (newPass.length < 6) {
                newPassEl.classList.remove('wgp-valid');
                newPassEl.classList.add('wgp-invalid');
                hintNewEl.textContent = `Kurang ${6 - newPass.length} karakter lagi.`;
                hintNewEl.className = 'wgp-hint bad';
            } else {
                newPassEl.classList.remove('wgp-invalid');
                newPassEl.classList.add('wgp-valid');
                hintNewEl.textContent = 'Panjang password sudah cukup.';
                hintNewEl.className = 'wgp-hint ok';
            }

            if (confirmPass.length === 0) {
                confirmPassEl.classList.remove('wgp-valid', 'wgp-invalid');
                hintConfirmEl.textContent = 'Ulangi password baru di atas.';
                hintConfirmEl.className = 'wgp-hint';
            } else if (confirmPass !== newPass) {
                confirmPassEl.classList.remove('wgp-valid');
                confirmPassEl.classList.add('wgp-invalid');
                hintConfirmEl.textContent = 'Belum cocok dengan password baru.';
                hintConfirmEl.className = 'wgp-hint bad';
            } else {
                confirmPassEl.classList.remove('wgp-invalid');
                confirmPassEl.classList.add('wgp-valid');
                hintConfirmEl.textContent = 'Password cocok.';
                hintConfirmEl.className = 'wgp-hint ok';
            }

            const semuaValid = newPass.length >= 6 && confirmPass.length >= 6 && newPass === confirmPass;
            submitBtn.disabled = !semuaValid;
        }

        newPassEl.addEventListener('input', cekValidasiRealtime);
        confirmPassEl.addEventListener('input', cekValidasiRealtime);
    })();

    function validasiFormGantiWajib(form) {
        const errEl = document.getElementById('wgp_error');
        const boxEl = document.getElementById('wgpBox');
        const newPass = form.newPassword.value;
        const confirmPass = form.confirmPassword.value;

        function tampilkanErrorShake(pesan) {
            errEl.innerText = pesan;
            errEl.style.display = 'block';
            boxEl.classList.remove('wgp-shake');
            void boxEl.offsetWidth;
            boxEl.classList.add('wgp-shake');
        }

        if (newPass.length < 6) {
            tampilkanErrorShake('Password baru minimal 6 karakter.');
            return false;
        }
        if (newPass !== confirmPass) {
            tampilkanErrorShake('Konfirmasi password tidak cocok.');
            return false;
        }
        return true;
    }
</script>
<% } %>