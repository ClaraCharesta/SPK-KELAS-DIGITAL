<!DOCTYPE html>
<html lang="id">
<head>
    <title><%= terkunci ? 'Nilai: ' : 'Input Nilai: ' %><%= siswa.nama %></title>
    <%- include('../partials/head') %>
    <style>
        .nilai-terkunci { font-size:18px; font-weight:700; color:#1f2937; }
        .nilai-terkunci.kosong { font-weight:400; color:#aaa; }

        .input-nilai {
            width:150px; padding:8px 10px; border:1px solid #ddd; border-radius:6px;
            font-size:14px; font-family:inherit; outline:none;
        }
        .input-nilai:focus { border-color:#1d5fd6; box-shadow:0 0 0 3px rgba(29,95,214,.12); }
        .input-nilai.salah { border:2px solid #e74c3c; }
        .input-nilai:disabled { background:#f3f4f6; cursor:not-allowed; }

        .hint-nilai { font-size:11px; color:#999; margin-top:4px; line-height:1.5; }
        .pesan-field { display:none; font-size:12px; font-weight:600; color:#e74c3c; margin-top:4px; }

        .ringkasan-error-form {
            display:none; background:#fdecea; color:#b3261e; border:1px solid #f5c2bd;
            border-radius:10px; padding:12px 16px; margin-bottom:16px; font-size:14px; line-height:1.5;
        }
        .ringkasan-error-form ul { margin:8px 0 0; padding-left:20px; font-size:13px; }
        .ringkasan-error-form li { margin-bottom:3px; }
    </style>
</head>
<body>
<%
    const bobotOk = (typeof bobotFinal !== 'undefined') ? Boolean(bobotFinal) : false;

    // Akademik & Psikotes: skala 0-100 (2 angka di belakang koma). Kriteria lain: bilangan bulat 1-5.
    const skor100 = function(k) {
        const n = String(k.nama_kriteria || '').toLowerCase();
        return n.indexOf('akademik') !== -1 || n.indexOf('psikotes') !== -1;
    };

    // Skor 0-100 tampil 2 angka di belakang koma (92 -> 92,00). Skala 1-5 tampil bulat.
    const formatNilai = function(v, k) {
        if (v === null || v === undefined || v === '') return null;
        const n = Number(v);
        if (!Number.isFinite(n)) return null;
        return skor100(k) ? n.toFixed(2).replace('.', ',') : String(Math.round(n));
    };
%>
    <div class="app-layout">
        <%- include('../partials/sidebar', { user: user, activePage: activePage }) %>
        <div class="main-content">
            <%- include('../partials/topbar', { user: user, pageTitle: pageTitle }) %>
            <div class="content-wrapper">
                <a href="/operator/nilai" class="back-link"><i class="bi bi-arrow-left"></i> Kembali ke Daftar Siswa</a>

                <% if (terkunci) { %>
                    <div class="alert" style="background:#fdf1de; color:#b35c00;">
                        <i class="bi bi-lock-fill"></i> Hasil seleksi sudah difinalisasi. Nilai terkunci dan hanya bisa dilihat.
                    </div>
                <% } else if (statusMinat === 'tidak_berminat') { %>
                    <div class="alert alert-danger">
                        <i class="bi bi-x-circle-fill"></i> Siswa ini menyatakan tidak berminat mengikuti Kelas Digital. Nilai tidak dapat diisi.
                    </div>
                <% } else if (!bobotOk) { %>
                    <div class="alert" style="background:#fdf1de; color:#b35c00;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Input nilai dinonaktifkan karena <strong>pembobotan FUCOM belum selesai atau belum konsisten</strong>.
                        Selesaikan di menu <a href="/operator/fucom" style="font-weight:600;">Pembobotan Kriteria</a>.
                    </div>
                <% } else if (jumlahBelumRespon > 0) { %>
                    <div class="alert" style="background:#fdf1de; color:#b35c00;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Input nilai dinonaktifkan karena masih ada <strong><%= jumlahBelumRespon %> siswa</strong> yang belum merespons.
                        Selesaikan di menu <a href="/operator/siswa" style="font-weight:600;">Data Siswa</a>.
                    </div>
                <% } %>

                <% if (success) { %>
                    <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
                <% } %>

                <div class="panel">
                    <div class="panel-header">
                        <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-person-fill"></i></div>
                        <div>
                            <h3><%= siswa.nama %></h3>
                            <p style="font-size:13px; color:#888;">NISN: <%= siswa.nisn %></p>
                        </div>
                    </div>

                    <% if (terkunci) { %>

                        <!-- Mode terkunci: nilai ditampilkan sebagai teks (tanpa input) -->
                        <table class="data-table">
                            <thead>
                                <tr><th>Kriteria</th><th>Jenis</th><th>Nilai</th></tr>
                            </thead>
                            <tbody>
                                <% if (kriteriaList.length === 0) { %>
                                    <tr><td colspan="3" class="empty-state">Belum ada kriteria pada periode ini.</td></tr>
                                <% } %>

                                <% kriteriaList.forEach(function(k) {
                                    const tampil = formatNilai(k.nilai_mentah, k);
                                %>
                                    <tr>
                                        <td><%= k.nama_kriteria %></td>
                                        <td>
                                            <span class="badge badge-<%= k.jenis === 'benefit' ? 'green' : 'red' %>">
                                                <%= k.jenis === 'benefit' ? 'Benefit' : 'Cost' %>
                                            </span>
                                        </td>
                                        <td>
                                            <% if (tampil !== null) { %>
                                                <span class="nilai-terkunci"><%= tampil %></span>
                                            <% } else { %>
                                                <span class="nilai-terkunci kosong">Belum diisi</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>

                    <% } else { %>

                        <div id="ringkasanErrorForm" class="ringkasan-error-form" role="alert"></div>

                        <form action="/operator/nilai/<%= siswa.id_siswa %>/save" method="POST" id="formNilai" novalidate>
                            <table class="data-table">
                                <thead>
                                    <tr><th>Kriteria</th><th>Jenis</th><th>Nilai</th></tr>
                                </thead>
                                <tbody>
                                    <% kriteriaList.forEach(function(k) {
                                        var isSkor100 = skor100(k);
                                        var nilaiAwal = formatNilai(k.nilai_mentah, k);
                                    %>
                                        <tr>
                                            <td><%= k.nama_kriteria %></td>
                                            <td>
                                                <span class="badge badge-<%= k.jenis === 'benefit' ? 'green' : 'red' %>">
                                                    <%= k.jenis === 'benefit' ? 'Benefit' : 'Cost' %>
                                                </span>
                                            </td>
                                            <td>
                                                <input type="hidden" name="id_kriteria" value="<%= k.id_kriteria %>">
                                                <input type="text"
                                                    class="input-nilai"
                                                    name="nilai_mentah"
                                                    inputmode="<%= isSkor100 ? 'decimal' : 'numeric' %>"
                                                    autocomplete="off"
                                                    data-skala="<%= isSkor100 ? '100' : '5' %>"
                                                    data-nama="<%= k.nama_kriteria %>"
                                                    placeholder="<%= isSkor100 ? 'contoh: 85,50' : '1 - 5' %>"
                                                    value="<%= nilaiAwal !== null ? nilaiAwal : '' %>"
                                                    <%= bolehIsi ? '' : 'disabled' %>>
                                                <div class="pesan-field"></div>
                                                <div class="hint-nilai">
                                                    <% if (isSkor100) { %>
                                                        Skala 0 - 100. Desimal boleh pakai koma atau titik (85,5 atau 85.5). Otomatis disimpan 2 angka di belakang koma.
                                                    <% } else { %>
                                                        Skala 1 - 5, hanya angka bulat 1, 2, 3, 4, atau 5 (tidak boleh 0 dan tidak boleh desimal)
                                                    <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>

                            <% if (bolehIsi) { %>
                                <div class="modal-footer" style="margin-top:20px;">
                                    <button type="submit" class="btn-primary"><i class="bi bi-save-fill"></i> Simpan Semua Nilai</button>
                                </div>
                            <% } else { %>
                                <div class="modal-footer" style="margin-top:20px;">
                                    <button type="button" class="btn-primary" disabled style="opacity:.5; cursor:not-allowed;">
                                        <i class="bi bi-lock-fill"></i> Simpan Semua Nilai
                                    </button>
                                </div>
                            <% } %>
                        </form>

                    <% } %>
                </div>

                <%- include('../partials/footer') %>
            </div>
        </div>
    </div>

    <% if (!terkunci) { %>
    <script>
        (function () {
            const form = document.getElementById('formNilai');
            if (!form) return;

            const kotakRingkasan = document.getElementById('ringkasanErrorForm');
            const POLA_ANGKA = /^(\d+([.,]\d*)?|[.,]\d+)$/;

            function periksa(inp) {
                const skala = inp.getAttribute('data-skala');
                const teks = (inp.value || '').replace(/[\s\u00A0\u200B]/g, '');

                if (teks === '') return { valid: false, pesan: 'Belum diisi.' };
                if (/^[-\u2212\u2013]/.test(teks)) return { valid: false, pesan: 'Tidak boleh bernilai negatif.' };
                if (!POLA_ANGKA.test(teks)) {
                    return { valid: false, pesan: 'Hanya boleh angka. Desimal pakai satu tanda koma atau titik.' };
                }

                let n = Number(teks.replace(',', '.'));

                if (skala === '5') {
                    if (Math.abs(n - Math.round(n)) > 1e-9) {
                        return { valid: false, pesan: 'Harus bilangan bulat 1-5, tanpa desimal.' };
                    }
                    n = Math.round(n);
                    if (n === 0) return { valid: false, pesan: 'Tidak boleh 0. Isi 1, 2, 3, 4, atau 5.' };
                    if (n < 1 || n > 5) return { valid: false, pesan: 'Harus antara 1 sampai 5.' };
                    return { valid: true, kirim: String(n), tampil: String(n) };
                }

                if (n < 0 || n > 100) return { valid: false, pesan: 'Harus antara 0 sampai 100.' };

                const bulat = Math.round((n + Number.EPSILON) * 100) / 100;
                const dua = bulat.toFixed(2);
                return { valid: true, kirim: dua, tampil: dua.replace('.', ',') };
            }

            function elemenPesan(inp) {
                const sel = inp.parentNode.querySelector('.pesan-field');
                return sel;
            }

            function tandai(inp, hasil) {
                const el = elemenPesan(inp);
                if (hasil.valid) {
                    inp.classList.remove('salah');
                    if (el) { el.textContent = ''; el.style.display = 'none'; }
                } else {
                    inp.classList.add('salah');
                    if (el) { el.textContent = hasil.pesan; el.style.display = 'block'; }
                }
            }

            function sembunyikanRingkasan() {
                if (!kotakRingkasan) return;
                kotakRingkasan.style.display = 'none';
                kotakRingkasan.textContent = '';
            }

            form.querySelectorAll('input[name="nilai_mentah"]').forEach(function (inp) {
                inp.addEventListener('input', function () {
                    const bersih = this.value.replace(/[^0-9.,]/g, '');
                    if (bersih !== this.value) this.value = bersih;
                    this.classList.remove('salah');
                    const el = elemenPesan(this);
                    if (el) { el.textContent = ''; el.style.display = 'none'; }
                });

                inp.addEventListener('blur', function () {
                    if (this.disabled) return;
                    if (this.value.trim() === '') {
                        this.classList.remove('salah');
                        const el = elemenPesan(this);
                        if (el) { el.textContent = ''; el.style.display = 'none'; }
                        return;
                    }
                    const hasil = periksa(this);
                    tandai(this, hasil);
                    if (hasil.valid) this.value = hasil.tampil;
                });
            });

            form.addEventListener('submit', function (e) {
                const inputs = Array.prototype.slice.call(
                    this.querySelectorAll('input[name="nilai_mentah"]:not([disabled])')
                );
                const masalah = [];
                const hasilSemua = [];

                inputs.forEach(function (inp) {
                    const hasil = periksa(inp);
                    hasilSemua.push(hasil);
                    tandai(inp, hasil);
                    if (!hasil.valid) {
                        masalah.push({ inp: inp, nama: inp.getAttribute('data-nama') || 'Kriteria', pesan: hasil.pesan });
                    }
                });

                if (masalah.length > 0) {
                    e.preventDefault();

                    if (kotakRingkasan) {
                        kotakRingkasan.textContent = '';

                        const judul = document.createElement('strong');
                        judul.textContent = 'Nilai belum bisa disimpan. Ada ' + masalah.length + ' kolom yang perlu diperbaiki:';
                        kotakRingkasan.appendChild(judul);

                        const daftar = document.createElement('ul');
                        masalah.forEach(function (m) {
                            const li = document.createElement('li');
                            li.textContent = m.nama + ': ' + m.pesan;
                            daftar.appendChild(li);
                        });
                        kotakRingkasan.appendChild(daftar);

                        kotakRingkasan.style.display = 'block';
                        if (kotakRingkasan.scrollIntoView) kotakRingkasan.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }

                    masalah[0].inp.focus();
                    return;
                }

                sembunyikanRingkasan();

                inputs.forEach(function (inp, i) {
                    inp.value = hasilSemua[i].kirim;
                });
            });
        })();
    </script>
    <% } %>
</body>
</html>