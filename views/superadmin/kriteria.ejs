<!DOCTYPE html>
<html lang="id">
<head>
    <title>Kelola Kriteria</title>
    <%- include('../partials/head') %>
</head>
<body>
    <div class="app-layout">
        <%- include('../partials/sidebar', { user: user, activePage: activePage }) %>
        <div class="main-content">
            <%- include('../partials/topbar', { user: user, pageTitle: pageTitle }) %>
            <div class="content-wrapper">
                <% if (success) { %>
                    <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
                <% } %>
                <div class="panel">
                    <% if (terkunci) { %>
                        <div class="alert" style="background:#fdf1de; color:#b35c00;">
                            <i class="bi bi-lock-fill"></i> Kriteria terkunci karena pembobotan FUCOM sudah final dan/atau perankingan sudah dijalankan pada periode ini. Buka periode baru untuk mengubah kriteria.
                        </div>
                    <% } %>
                    <div class="panel-header-row">
                        <div class="panel-header">
                            <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-card-checklist"></i></div>
                            <h3>Daftar Kriteria Penilaian</h3>
                        </div>
                        <% if (!terkunci) { %>
                            <button class="btn-primary" onclick="document.getElementById('modalTambah').style.display='flex'">
                                <i class="bi bi-plus-lg"></i> Tambah Kriteria
                            </button>
                        <% } %>
                    </div>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Nama Kriteria</th>
                                <th>Jenis</th>
                                <th>Keterangan</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (kriteriaList.length === 0) { %>
                                <tr><td colspan="5" class="empty-state">Belum ada kriteria. Tambahkan 6 kriteria yang sudah disepakati.</td></tr>
                            <% } %>
                            <% kriteriaList.forEach(function(k, index) { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= k.nama_kriteria %></td>
                                    <td><span class="badge badge-<%= k.jenis === 'benefit' ? 'green' : 'red' %>"><%= k.jenis === 'benefit' ? 'Benefit' : 'Cost' %></span></td>
                                    <td><%= k.keterangan || '-' %></td>
                                    <td class="action-cell">
                                        <% if (!terkunci) { %>
                                            <button class="btn-icon" title="Edit" onclick='bukaModalEdit(<%- JSON.stringify(k) %>)'>
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <form action="/superadmin/kriteria/delete/<%= k.id_kriteria %>" method="POST" style="display:inline;" onsubmit="return confirmDelete(this,'Yakin ingin menghapus kriteria ini?');">
                                                <button type="submit" class="btn-icon btn-icon-danger" title="Hapus">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <span style="color:#999; font-size:12px;">Terkunci</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>

                </div>
                <%- include('../partials/footer') %>
            </div>
        </div>
    </div>

    <!-- Modal Tambah Kriteria -->
    <div class="modal-overlay" id="modalTambah">
        <div class="modal-box">
            <div class="modal-header">
                <h3><i class="bi bi-plus-circle-fill"></i> Tambah Kriteria Baru</h3>
                <button class="modal-close" onclick="document.getElementById('modalTambah').style.display='none'">&times;</button>
            </div>
            <form action="/superadmin/kriteria/create" method="POST" onsubmit="return validasiFormKriteria(this, null)">
                <label>Nama Kriteria (Hanya Huruf)</label>
                <input type="text" name="nama_kriteria" id="nama_kriteria_tambah" required placeholder="Contoh: Nilai Akademik" autocomplete="off">
                <p id="peringatan_nama_tambah" style="color:#e74c3c; font-size:12px; margin-top:4px; display:none;"></p>
                <label>Jenis Kriteria</label>
                <select name="jenis" required>
                    <option value="benefit">Benefit (semakin tinggi semakin baik)</option>
                    <option value="cost">Cost (semakin rendah semakin baik)</option>
                </select>
                <label>Keterangan (Opsional)</label>
                <input type="text" name="keterangan" value="Kriteria tambahan" placeholder="Penjelasan singkat kriteria">
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="document.getElementById('modalTambah').style.display='none'">Batal</button>
                    <button type="submit" class="btn-primary">Simpan</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Edit Kriteria -->
    <div class="modal-overlay" id="modalEdit">
        <div class="modal-box">
            <div class="modal-header">
                <h3><i class="bi bi-pencil-square"></i> Edit Kriteria</h3>
                <button class="modal-close" onclick="document.getElementById('modalEdit').style.display='none'">&times;</button>
            </div>
            <form action="/superadmin/kriteria/update" method="POST" onsubmit="return validasiFormKriteria(this, document.getElementById('edit_id_kriteria').value)">
                <input type="hidden" name="id_kriteria" id="edit_id_kriteria">
                <label>Nama Kriteria (Hanya Huruf)</label>
                <input type="text" name="nama_kriteria" id="edit_nama_kriteria" required autocomplete="off">
                <p id="peringatan_nama_edit" style="color:#e74c3c; font-size:12px; margin-top:4px; display:none;"></p>
                <label>Jenis Kriteria</label>
                <select name="jenis" id="edit_jenis" required>
                    <option value="benefit">Benefit (semakin tinggi semakin baik)</option>
                    <option value="cost">Cost (semakin rendah semakin baik)</option>
                </select>
                <label>Keterangan (Opsional)</label>
                <input type="text" name="keterangan" id="edit_keterangan">
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="document.getElementById('modalEdit').style.display='none'">Batal</button>
                    <button type="submit" class="btn-primary">Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function bukaModalEdit(k) {
            document.getElementById('edit_id_kriteria').value = k.id_kriteria;
            document.getElementById('edit_nama_kriteria').value = k.nama_kriteria;
            document.getElementById('edit_jenis').value = k.jenis;
            document.getElementById('edit_keterangan').value = k.keterangan || '';
            document.getElementById('modalEdit').style.display = 'flex';
        }
    </script>

    <script>
    // Data kriteria yang sudah ada, untuk cek duplikat (id + nama huruf kecil, trim)
    const daftarKriteria = <%- JSON.stringify(kriteriaList.map(k => ({ id: k.id_kriteria, nama: k.nama_kriteria.trim().toLowerCase() }))) %>;

    // Regex: hanya huruf (termasuk spasi antar kata), minimal 1 huruf, tidak boleh cuma spasi
    const REGEX_HURUF_SAJA = /^[A-Za-zÀ-ÖØ-öø-ÿ]+( [A-Za-zÀ-ÖØ-öø-ÿ]+)*$/;

    function sanitizeHurufInput(input) {
        // buang semua karakter selain huruf dan spasi
        let val = input.value.replace(/[^A-Za-zÀ-ÖØ-öø-ÿ\s]/g, '');
        // cegah spasi ganda beruntun & cegah diawali spasi
        val = val.replace(/\s{2,}/g, ' ');
        input.value = val;
    }

    function cekDuplikatNama(nama, excludeId) {
        const namaLower = nama.trim().toLowerCase();
        return daftarKriteria.some(k => k.nama === namaLower && String(k.id) !== String(excludeId));
    }

    function validasiFormKriteria(form, excludeId) {
        const inputNama = form.nama_kriteria;
        const namaTrim = inputNama.value.trim();
        const isTambah = excludeId === null;
        const peringatanEl = document.getElementById(isTambah ? 'peringatan_nama_tambah' : 'peringatan_nama_edit');

        if (namaTrim === '' || !REGEX_HURUF_SAJA.test(namaTrim)) {
            peringatanEl.innerText = 'Nama kriteria hanya boleh berisi huruf dan spasi antar kata, tidak boleh angka/simbol/kosong.';
            peringatanEl.style.display = 'block';
            inputNama.focus();
            return false;
        }

        if (cekDuplikatNama(namaTrim, excludeId)) {
            peringatanEl.innerText = 'Kriteria dengan nama tersebut sudah ada.';
            peringatanEl.style.display = 'block';
            inputNama.focus();
            return false;
        }

        inputNama.value = namaTrim; // pastikan tersimpan tanpa spasi di awal/akhir
        return true;
    }

    document.getElementById('nama_kriteria_tambah').addEventListener('input', function() {
        sanitizeHurufInput(this);
        document.getElementById('peringatan_nama_tambah').style.display = 'none';
    });
    document.getElementById('edit_nama_kriteria').addEventListener('input', function() {
        sanitizeHurufInput(this);
        document.getElementById('peringatan_nama_edit').style.display = 'none';
    });
    </script>
</body>
</html>