<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Lupa Password - Sistem Penempatan Siswa Kelas Digital</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>
    <div class="login-wrapper">
        <div class="login-left">
            <img src="/img/logo-sman12.png" alt="Logo SMAN 12 Padang" class="logo">
            <h1>SISTEM PENEMPATAN SISWA <br><span>KELAS DIGITAL</span></h1>
            <p class="subtitle">Sistem informasi untuk membantu proses penempatan siswa pada kelas digital di SMAN 12 Padang.</p>
        </div>

        <div class="login-right">
            <div class="login-card">
                <h2>Lupa Password</h2>
                <p class="desc">Masukkan email yang terdaftar pada akun kamu. Kami akan mengirimkan tautan untuk mereset password.</p>
                <hr>

                <% if (success) { %>
                    <div class="alert-success" style="background:#e6f7ec; color:#1e7e34; padding:10px 14px; border-radius:8px; margin-bottom:15px; font-size:14px;">
                        <i class="bi bi-check-circle-fill"></i> <%= success %>
                    </div>
                <% } %>
                <% if (error) { %>
                    <div class="alert-error"><%= error %></div>
                <% } %>

                <% if (!success) { %>
                <form action="/forgot-password" method="POST">
                    <label for="email">Email Terdaftar:</label>
                    <input type="email" id="email" name="email" placeholder="Masukkan email akun kamu" required autocomplete="off">

                    <button type="submit">Kirim Tautan Reset</button>
                </form>
                <% } %>

                <p style="text-align:center; margin-top:15px; font-size:14px;">
                    <a href="/login" style="color:#1d5fd6; text-decoration:none;"><i class="bi bi-arrow-left"></i> Kembali ke Login</a>
                </p>
            </div>
        </div>
    </div>
</body>
</html>