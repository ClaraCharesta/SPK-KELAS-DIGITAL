<% const ROLE_LABEL = { admin: 'Admin', operator: 'Operator', kepsek: 'Kepala Sekolah' }; %>
<% const ROLE_BADGE = { admin: 'purple', operator: 'blue', kepsek: 'green' }; %>
<!DOCTYPE html>
<html lang="id">
<head>
    <title>Log Aktivitas</title>
    <%- include('../partials/head') %>
    <style>
        /* ===== Hanya tabel yang bisa discroll (atas-bawah & kanan-kiri) ===== */
        .log-scroll {
            max-height: calc(100vh - 270px);
            min-height: 220px;
            overflow: auto;
            -webkit-overflow-scrolling: touch;
            border: 1px solid #eceff4;
            border-radius: 10px;
            background: #fff;
        }
        .log-scroll::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        .log-scroll::-webkit-scrollbar-track {
            background: #f1f3f7;
            border-radius: 8px;
        }
        .log-scroll::-webkit-scrollbar-thumb {
            background: #c5cbd6;
            border-radius: 8px;
        }
        .log-scroll::-webkit-scrollbar-thumb:hover {
            background: #a9b1bf;
        }
        .log-scroll .data-table {
            width: 100%;
            min-width: 700px;
            margin: 0;
            border-collapse: separate;
            border-spacing: 0;
        }
        /* Header menempel di atas saat tabel discroll ke bawah */
        .log-scroll .data-table thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            background: #f7f9fc;
            color: #5b6577;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            padding: 13px 16px;
            text-align: left;
            white-space: nowrap;
            border-bottom: 1px solid #e6eaf0;
            box-shadow: 0 1px 0 #e6eaf0;
        }
        .log-scroll .data-table tbody td {
            padding: 12px 16px;
            font-size: 14px;
            vertical-align: middle;
            border-bottom: 1px solid #f0f2f6;
            background: #fff;
        }
        .log-scroll .data-table tbody tr:last-child td {
            border-bottom: none;
        }
        .log-scroll .data-table tbody tr:hover td {
            background: #f8faff;
        }
    </style>
</head>
<body>
    <div class="app-layout">
        <%- include('../partials/sidebar', { user: user, activePage: activePage }) %>
        <div class="main-content">
            <%- include('../partials/topbar', { user: user, pageTitle: pageTitle }) %>
            <div class="content-wrapper">
                <div class="panel">
                    <div class="panel-header-row">
                        <div class="panel-header">
                            <div class="stat-icon icon-purple" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-clock-history"></i></div>
                            <h3>Riwayat Aktivitas Pengguna</h3>
                        </div>
                        <form method="GET" style="display:flex; gap:10px;">
                            <select name="role" onchange="this.form.submit()" style="padding:8px 12px; border:1px solid #ddd; border-radius:8px; font-size:13px;">
                                <option value="">Semua Role</option>
                                <option value="admin" <%= filterRole === 'admin' ? 'selected' : '' %>>Admin</option>
                                <option value="operator" <%= filterRole === 'operator' ? 'selected' : '' %>>Operator</option>
                                <option value="kepsek" <%= filterRole === 'kepsek' ? 'selected' : '' %>>Kepala Sekolah</option>
                            </select>
                            <input type="date" name="tanggal" value="<%= filterTanggal %>" onchange="this.form.submit()" style="padding:8px 12px; border:1px solid #ddd; border-radius:8px; font-size:13px;">
                            <% if (filterRole || filterTanggal) { %>
                                <a href="/superadmin/log" class="btn-secondary" style="display:flex; align-items:center; padding:0 15px;">Reset</a>
                            <% } %>
                        </form>
                    </div>
                    <div class="log-scroll">
                        <table class="data-table" style="min-width:700px;">
                            <thead>
                                <tr><th style="white-space:nowrap;">Waktu</th><th style="white-space:nowrap;">Nama</th><th style="white-space:nowrap;">Role</th><th>Aktivitas</th></tr>
                            </thead>
                            <tbody>
                                <% if (logs.length === 0) { %>
                                    <tr><td colspan="4" class="empty-state">Belum ada aktivitas tercatat.</td></tr>
                                <% } %>
                                <% logs.forEach(function(l) { %>
                                    <tr>
                                        <td style="white-space:nowrap;"><%= new Date(l.waktu).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %></td>
                                        <td style="white-space:nowrap;"><%= l.nama %></td>
                                        <td style="white-space:nowrap;">
                                            <span class="badge badge-<%= ROLE_BADGE[l.role] || 'green' %>">
                                                <%= ROLE_LABEL[l.role] || l.role %>
                                            </span>
                                        </td>
                                        <td><%= l.aktivitas %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <%- include('../partials/footer') %>
            </div>
        </div>
    </div>
</body>
</html>