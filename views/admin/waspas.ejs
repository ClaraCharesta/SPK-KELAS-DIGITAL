<!DOCTYPE html>
<html lang="id">
<head>
    <title>Perhitungan WASPAS</title>
    <%- include('../partials/head') %>
</head>
<body>
    <div class="app-layout">
        <%- include('../partials/sidebar', { user: user, activePage: activePage }) %>
        <div class="main-content">
            <%- include('../partials/topbar', { user: user, pageTitle: pageTitle }) %>

            <div class="content-wrapper">
                <% if (success) { %>
                    <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
                <% } %>

                <% if (cekData) { %>
                <div class="panel">
                    <div class="panel-header-row">
                        <div class="panel-header">
                            <div class="stat-icon icon-purple" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-graph-up-arrow"></i></div>
                            <h3>Status Kesiapan Perhitungan</h3>
                        </div>
                        <form action="/admin/waspas/hitung" method="POST">
                            <button type="submit" class="btn-primary"><i class="bi bi-calculator-fill"></i> Hitung Ranking WASPAS</button>
                        </form>
                    </div>
                    <table class="data-table">
                        <tbody>
                            <tr><td>Total Siswa</td><td><%= cekData.totalSiswa %></td></tr>
                            <tr><td>Total Kriteria</td><td><%= cekData.totalKriteria %></td></tr>
                            <tr><td>Bobot Kriteria Tersedia</td><td><span class="badge badge-<%= cekData.totalBobot > 0 ? 'green' : 'red' %>"><%= cekData.totalBobot > 0 ? 'Sudah' : 'Belum' %></span></td></tr>
                            <tr><td>Siswa dengan Nilai Belum Lengkap</td><td><span class="badge badge-<%= cekData.siswaBelumLengkap === 0 ? 'green' : 'red' %>"><%= cekData.siswaBelumLengkap %> siswa</span></td></tr>
                        </tbody>
                    </table>
                </div>
                <% } %>

                <div class="panel">
                    <div class="panel-header">
                        <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-trophy-fill"></i></div>
                        <h3>Hasil Perangkingan Siswa (Kuota: <%= kuota || '-' %>)</h3>
                    </div>

                    <% if (hasilRanking.length === 0) { %>
                        <p class="empty-state">Perangkingan belum dihitung. Klik "Hitung Ranking WASPAS" di atas.</p>
                    <% } else { %>
                        <table class="data-table">
                            <thead>
                                <tr><th>Rank</th><th>NISN</th><th>Nama</th><th>WSM</th><th>WPM</th><th>Nilai Q</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                <% hasilRanking.forEach(function(h) { %>
                                    <tr>
                                        <td><strong>#<%= h.ranking %></strong></td>
                                        <td><%= h.nisn %></td>
                                        <td><%= h.nama %></td>
                                        <td><%= parseFloat(h.nilai_wsm).toFixed(4) %></td>
                                        <td><%= parseFloat(h.nilai_wpm).toFixed(4) %></td>
                                        <td><strong><%= parseFloat(h.nilai_akhir_q).toFixed(4) %></strong></td>
                                        <td>
                                            <span class="badge badge-<%= h.status_penerimaan === 'diterima' ? 'green' : 'blue' %>">
                                                <%= h.status_penerimaan === 'diterima' ? 'Diterima' : 'Cadangan' %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } %>
                </div>

                <%- include('../partials/footer') %>
            </div>
        </div>
    </div>
</body>
</html>