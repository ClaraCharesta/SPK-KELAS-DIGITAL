<!DOCTYPE html>
<html lang="id">
<head>
    <title>Laporan</title>
    <%- include('../partials/head') %>
</head>
<body>
    <div class="app-layout">
        <%- include('../partials/sidebar', { user: user, activePage: activePage }) %>
        <div class="main-content">
            <%- include('../partials/topbar', { user: user, pageTitle: pageTitle }) %>

            <div class="content-wrapper">
                <% if (error) { %>
                    <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
                <% } %>

                <% if (periode) { %>
                <div class="panel laporan-panel">
                    <div class="panel-header">
                        <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-file-earmark-text-fill"></i></div>
                        <div>
                            <h3>Laporan Hasil Penempatan Kelas Digital</h3>
                            <p class="stat-desc">Tahun Ajaran <%= periode.tahun_ajaran %> — <%= hasilRanking.length %> siswa</p>
                        </div>
                    </div>
                    <a href="/<%= user.role %>/laporan/unduh" class="btn-primary"><i class="bi bi-download"></i> Unduh Laporan PDF</a>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <div class="stat-icon icon-orange" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-sliders"></i></div>
                        <h3>Bobot Kriteria</h3>
                    </div>
                    <table class="data-table">
                        <thead><tr><th>Kriteria</th><th>Bobot</th></tr></thead>
                        <tbody>
                            <% bobotKriteria.forEach(function(b) { %>
                                <tr><td><%= b.nama_kriteria %></td><td><strong><%= (b.nilai_bobot * 100).toFixed(2) %>%</strong></td></tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <div class="stat-icon icon-purple" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-trophy-fill"></i></div>
                        <h3>Hasil Perangkingan Siswa</h3>
                    </div>
                    <table class="data-table">
                        <thead><tr><th>Rank</th><th>NISN</th><th>Nama</th><th>Nilai Q</th><th>Status</th></tr></thead>
                        <tbody>
                            <% hasilRanking.forEach(function(h) { %>
                                <tr>
                                    <td>#<%= h.ranking %></td>
                                    <td><%= h.nisn %></td>
                                    <td><%= h.nama %></td>
                                    <td><%= parseFloat(h.nilai_akhir_q).toFixed(4) %></td>
                                    <td><span class="badge badge-<%= h.status_penerimaan === 'diterima' ? 'green' : 'blue' %>"><%= h.status_penerimaan === 'diterima' ? 'Diterima' : 'Cadangan' %></span></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <% } %>

                <%- include('../partials/footer') %>
            </div>
        </div>
    </div>
</body>
</html>