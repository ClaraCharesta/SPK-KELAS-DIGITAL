<!DOCTYPE html>
<html lang="id">
<head>
    <title>Hasil Ranking Siswa</title>
    <%- include('../partials/head') %>
</head>
<body>
    <div class="app-layout">
        <%- include('../partials/sidebar', { user: user, activePage: activePage }) %>
        <div class="main-content">
            <%- include('../partials/topbar', { user: user, pageTitle: pageTitle }) %>
            <div class="content-wrapper">
                <% if (error) { %>
                    <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
                <% } %>
                <% if (periode) { %>
                <div class="panel">
                    <div class="panel-header">
                        <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-trophy-fill"></i></div>
                        <div>
                            <h3>Hasil Perangkingan Siswa</h3>
                            <p class="stat-desc">Tahun Ajaran <%= periode.tahun_ajaran %> — Kuota: <%= periode.kuota_kelas_digital %> siswa</p>
                        </div>
                    </div>
                    <% if (hasilRanking.length === 0) { %>
                        <p class="empty-state">Belum ada hasil perangkingan. Admin belum menjalankan perhitungan WASPAS.</p>
                    <% } else { %>
                        <div class="status-legend">
                            <span><span class="dot-legend badge-diusulkan"></span> Diusulkan</span>
                            <span><span class="dot-legend badge-cadangan"></span> Cadangan</span>
                            <span><span class="dot-legend badge-lulus"></span> Lulus (Final)</span>
                        </div>
                        <input type="text" id="searchSiswa" placeholder="Cari nama atau NISN siswa..." 
                               style="width:100%; max-width:350px; padding:10px 14px; border:1px solid #ddd; border-radius:8px; margin-bottom:15px;"
                               onkeyup="filterTabelSiswa()">
                        <table class="data-table">
                            <thead>
                                <tr><th>Rank</th><th>NISN</th><th>Nama</th><th>Nilai Q</th><th>Status</th><th>Detail</th></tr>
                            </thead>
                            <tbody id="tabelBodyRanking">
                                <% hasilRanking.forEach(function(h) { %>
                                    <tr class="baris-siswa" data-nama="<%= h.nama.toLowerCase() %>" data-nisn="<%= h.nisn %>">
                                        <td><strong>#<%= h.ranking %></strong></td>
                                        <td><%= h.nisn %></td>
                                        <td><%= h.nama %></td>
                                        <td><%= parseFloat(h.nilai_akhir_q).toFixed(4) %></td>
                                        <td>
                                            <span class="badge badge-<%= h.status_penerimaan %>">
                                                <%= h.status_penerimaan === 'diusulkan' ? 'Diusulkan' : (h.status_penerimaan === 'lulus' ? 'Lulus' : 'Cadangan') %>
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn-icon" title="Lihat Detail Nilai" onclick="lihatDetailSiswa(<%= h.id_siswa %>, '<%= h.nama %>')">
                                                <i class="bi bi-eye-fill"></i>
                                            </button>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } %>
                </div>
                <% } %>
                <%- include('../partials/footer') %>
            </div>
        </div>
    </div>
    <!-- Modal Detail Nilai Siswa -->
    <div class="modal-overlay" id="modalDetailSiswa">
        <div class="modal-box" style="max-width:500px;">
            <div class="modal-header">
                <h3><i class="bi bi-person-lines-fill"></i> Detail Nilai: <span id="detailNamaSiswa"></span></h3>
                <button class="modal-close" onclick="document.getElementById('modalDetailSiswa').style.display='none'">&times;</button>
            </div>
            <table class="data-table">
                <thead><tr><th>Kriteria</th><th>Nilai</th></tr></thead>
                <tbody id="isiDetailSiswa"></tbody>
            </table>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" onclick="document.getElementById('modalDetailSiswa').style.display='none'">Tutup</button>
            </div>
        </div>
    </div>
    <script>
        async function lihatDetailSiswa(id_siswa, nama) {
            document.getElementById('detailNamaSiswa').innerText = nama;
            const res = await fetch('/kepsek/ranking/detail/' + id_siswa);
            const data = await res.json();
            const tbody = document.getElementById('isiDetailSiswa');
            tbody.innerHTML = '';
            if (data.success) {
                data.detail.forEach(function(d) {
                    const tr = document.createElement('tr');
                    const nilaiTampil = d.nilai_mentah !== null ? d.nilai_mentah : '<span style="color:#e74c3c;">Belum diisi</span>';
                    tr.innerHTML = `<td>${d.nama_kriteria}</td><td>${nilaiTampil}</td>`;
                    tbody.appendChild(tr);
                });
            }
            document.getElementById('modalDetailSiswa').style.display = 'flex';
        }

        function filterTabelSiswa() {
            const keyword = document.getElementById('searchSiswa').value.toLowerCase();
            document.querySelectorAll('.baris-siswa').forEach(row => {
                const cocok = row.dataset.nama.includes(keyword) || row.dataset.nisn.includes(keyword);
                row.style.display = cocok ? '' : 'none';
            });
        }
    </script>
</body>
</html>