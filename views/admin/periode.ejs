<!DOCTYPE html>
<html lang="id">
<head>
    <title>Kelola Periode Seleksi</title>
    <%- include('../partials/head') %>
    <style>
        .ta-field {
            display: flex; align-items: center; justify-content: center; gap: 8px;
            border: 1.5px solid #dcdfe6; border-radius: 12px; padding: 6px 16px;
            background: #fff; width: fit-content; max-width: 100%;
            transition: border-color .15s, box-shadow .15s;
        }
        .ta-field:focus-within { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,.12); }
        .ta-field.tidak-valid { border-color: #e74c3c; box-shadow: 0 0 0 3px rgba(231,76,60,.12); }
        .ta-field input {
            width: 84px !important; border: none !important; outline: none !important;
            box-shadow: none !important; background: transparent !important;
            text-align: center; font-size: 22px; font-weight: 600; letter-spacing: 5px;
            padding: 8px 0 !important; margin: 0 !important; color: #0b2545;
        }
        .ta-field input::placeholder { color: #c3cad8; letter-spacing: 5px; font-weight: 400; }
        .ta-slash { font-size: 28px; color: #9aa5b8; font-weight: 300; line-height: 1; user-select: none; }
        .ta-bantuan { font-size: 12px; color: #6b7685; margin-top: 6px; }
        .ta-bantuan strong { color: #1d4ed8; }
        .ta-field.ta-tetap { background: #f3f5f9; border-color: #dcdfe6; cursor: not-allowed; padding: 10px 18px; }
        .ta-field.ta-tetap:focus-within { border-color: #dcdfe6; box-shadow: none; }
        .ta-teks { font-size: 22px; font-weight: 600; letter-spacing: 3px; color: #0b2545; user-select: none; }
        .ta-ikon-kunci { font-size: 16px; color: #9aa5b8; }
        .tgl-bantuan { font-size: 12px; color: #6b7685; margin-top: 4px; }
        .rentang-info {
            font-size: 12px; color: #1d4ed8; background: #eef4ff; border-radius: 8px;
            padding: 8px 10px; margin-top: 10px; display: flex; gap: 6px; align-items: flex-start;
        }
        .btn-icon.terkunci, .btn-icon:disabled {
            opacity: .35; cursor: not-allowed; pointer-events: none;
        }
        .aksi-wrap { display: inline-block; }

        .tabel-scroll { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
        .tabel-scroll .data-table { min-width: 640px; }
        .modal-box { max-width: 560px; width: calc(100% - 24px); max-height: 92vh; overflow-y: auto; }
        .modal-box input[type="date"], .modal-box input[type="number"] { width: 100%; box-sizing: border-box; }
        @media (max-width: 640px) {
            .panel-header-row { flex-wrap: wrap; gap: 10px; }
            .panel-header-row .btn-primary { width: 100%; justify-content: center; }
            .ta-field input { width: 64px !important; font-size: 18px; letter-spacing: 3px; }
            .ta-teks { font-size: 18px; letter-spacing: 2px; }
            .modal-footer { flex-wrap: wrap; gap: 8px; }
            .modal-footer button { flex: 1; }
        }
    </style>
</head>
<body>
    <%
    function formatTgl(tglStr) {
        if (!tglStr) return '-';
        const [y, m, d] = String(tglStr).split('-');
        return `${d}/${m}/${y}`;
    }

    const saranTahun = (typeof tahunSaran !== 'undefined' && tahunSaran) ? tahunSaran : '';
    const terakhirTahun = (typeof tahunTerakhir !== 'undefined' && tahunTerakhir) ? tahunTerakhir : '';
    const sekarangTahun = (typeof tahunSekarang !== 'undefined' && tahunSekarang) ? tahunSekarang : '';
    %>
    <div class="app-layout">
        <%- include('../partials/sidebar', { user: user, activePage: activePage }) %>
        <div class="main-content">
            <%- include('../partials/topbar', { user: user, pageTitle: pageTitle }) %>
            <div class="content-wrapper">
                <% if (success) { %>
                    <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
                <% } %>
                <% if (error) { %>
                    <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
                <% } %>
                <div class="panel">
                    <div class="panel-header-row">
                        <div class="panel-header">
                            <div class="stat-icon icon-blue" style="width:36px;height:36px;font-size:16px;"><i class="bi bi-calendar-range"></i></div>
                            <h3>Daftar Periode Seleksi</h3>
                        </div>
                        <button class="btn-primary" onclick="bukaModalTambah()">
                            <i class="bi bi-plus-lg"></i> Buka Periode Baru
                        </button>
                    </div>
                    <div class="tabel-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Tahun Ajaran</th>
                                <th>Kuota</th>
                                <th>Tanggal Mulai</th>
                                <th>Tanggal Selesai</th>
                                <th>Status</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (periodeList.length === 0) { %>
                                <tr><td colspan="6" class="empty-state">Belum ada periode seleksi.</td></tr>
                            <% } %>
                            <% periodeList.forEach(function(p) { %>
                                <tr>
                                    <td><%= p.tahun_ajaran %></td>
                                    <td><%= p.kuota_kelas_digital %></td>
                                    <td><%= formatTgl(p.tgl_mulai_str) %></td>
                                    <td><%= formatTgl(p.tgl_selesai_str) %></td>
                                    <td>
                                        <span class="badge <%= p.display_status.badgeClass %>">
                                            <%= p.display_status.label %>
                                        </span>
                                    </td>
                                    <td class="action-cell">
                                        <%
                                            const isLatest = p.id_periode === latestId;
                                            const selesai = p.status_penyelesaian === 'selesai';
                                            const ditutup = p.display_status.label === 'Ditutup';

                                            let alasanDasar = null;
                                            if (ditutup) {
                                                alasanDasar = 'Periode sudah ditutup.';
                                            } else if (selesai) {
                                                alasanDasar = 'Hasil seleksi sudah difinalisasi.';
                                            } else if (!isLatest) {
                                                alasanDasar = 'Hanya periode terbaru yang dapat diedit atau dihapus.';
                                            }

                                            let alasanEdit = alasanDasar;
                                            if (!alasanEdit && p.bobot_final) {
                                                alasanEdit = 'Pembobotan FUCOM sudah dilakukan, periode tidak dapat diedit lagi.';
                                            }

                                            let alasanHapus = alasanDasar;
                                            if (!alasanHapus && p.bobot_final) {
                                                alasanHapus = 'Pembobotan FUCOM sudah final, periode tidak dapat dihapus.';
                                            }
                                        %>

                                        <% if (!alasanEdit) { %>
                                            <button class="btn-icon" title="Edit Periode" onclick='bukaModalEdit(<%- JSON.stringify(p) %>)'>
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        <% } else { %>
                                            <span class="aksi-wrap" title="<%= alasanEdit %>">
                                                <button type="button" class="btn-icon terkunci" disabled><i class="bi bi-pencil-square"></i></button>
                                            </span>
                                        <% } %>

                                        <% if (!alasanHapus) { %>
                                            <form action="/admin/periode/delete/<%= p.id_periode %>" method="POST" onsubmit="return confirmDelete(this, 'PERHATIAN: Menghapus periode ini akan menghapus SELURUH data terkait (siswa, nilai, kriteria, bobot FUCOM, dan hasil perankingan) secara permanen. Tindakan ini tidak dapat dibatalkan. Lanjutkan?');">
                                                <button type="submit" class="btn-icon btn-icon-danger" title="Hapus"><i class="bi bi-trash-fill"></i></button>
                                            </form>
                                        <% } else { %>
                                            <span class="aksi-wrap" title="<%= alasanHapus %>">
                                                <button type="button" class="btn-icon btn-icon-danger terkunci" disabled><i class="bi bi-trash-fill"></i></button>
                                            </span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                    </div>
                </div>
                <%- include('../partials/footer') %>
            </div>
        </div>
    </div>
    <div class="modal-overlay" id="modalTambah">
        <div class="modal-box">
            <div class="modal-header">
                <h3><i class="bi bi-calendar-plus-fill"></i> Buka Periode Seleksi Baru</h3>
                <button class="modal-close" onclick="document.getElementById('modalTambah').style.display='none'">&times;</button>
            </div>
            <form action="/admin/periode/create" method="POST" onsubmit="return handleTambahSubmit(this)">
                <p style="font-size:13px; color:#e67e22; margin-bottom:15px; background:#fdf1de; padding:10px; border-radius:8px;">
                    <i class="bi bi-info-circle-fill"></i> Membuat periode baru akan otomatis menutup periode yang sedang aktif dan menonaktifkan akun siswa pada periode tersebut.
                </p>
                <label>Tahun Ajaran</label>
                <input type="hidden" name="tahun_ajaran" id="tahun_ajaran_tambah" value="<%= sekarangTahun %>">
                <div class="ta-field ta-tetap" id="ta_field_tambah" title="Tahun ajaran otomatis mengikuti tahun sekarang dan tidak dapat diubah.">
                    <span class="ta-teks" id="ta_label_tambah"><%= sekarangTahun %></span>
                    <i class="bi bi-lock-fill ta-ikon-kunci"></i>
                </div>
                <p class="ta-bantuan">Tahun ajaran otomatis mengikuti tahun sekarang dan tidak dapat diubah.</p>
                <% if (terakhirTahun) { %>
                    <p class="ta-bantuan">Periode terakhir: <strong><%= terakhirTahun %></strong>.</p>
                <% } %>
                <p id="peringatan_tahun_tambah" style="color:#e74c3c; font-size:12px; margin-top:4px; display:none;"></p>
                <label>Kuota Kelas Digital (Minimal 30)</label>
                <input type="number" name="kuota_kelas_digital" min="30" required placeholder="Minimal 30">

                <div class="rentang-info"><i class="bi bi-calendar-check"></i><span id="rentang_info_tambah"></span></div>

                <label>Tanggal Mulai</label>
                <input type="date" name="tanggal_mulai" id="tambah_tgl_mulai">
                <p class="tgl-bantuan">Minimal hari ini, dan harus di dalam tahun ajaran.</p>
                <label>Tanggal Selesai</label>
                <input type="date" name="tanggal_selesai" id="tambah_tgl_selesai">
                <p class="tgl-bantuan">Minimal 7 hari dari hari ini, dan harus di dalam tahun ajaran.</p>
                <p id="peringatan_tanggal_tambah" style="color:#e74c3c; font-size:12px; margin-top:4px; display:none;"></p>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="document.getElementById('modalTambah').style.display='none'">Batal</button>
                    <button type="submit" class="btn-primary">Buka Periode</button>
                </div>
            </form>
        </div>
    </div>
    <div class="modal-overlay" id="modalEdit">
        <div class="modal-box">
            <div class="modal-header">
                <h3><i class="bi bi-pencil-square"></i> Edit Periode Seleksi</h3>
                <button class="modal-close" onclick="document.getElementById('modalEdit').style.display='none'">&times;</button>
            </div>
            <form action="/admin/periode/update" method="POST" onsubmit="return handleEditSubmit(this)">
                <input type="hidden" name="id_periode" id="edit_id_periode">
                <label>Tahun Ajaran</label>
                <input type="hidden" name="tahun_ajaran" id="edit_tahun_ajaran">
                <div class="ta-field ta-tetap" id="ta_field_edit" title="Tahun ajaran tidak dapat diubah.">
                    <span class="ta-teks" id="ta_label_edit">-</span>
                    <i class="bi bi-lock-fill ta-ikon-kunci"></i>
                </div>
                <p class="ta-bantuan">Tahun ajaran tidak dapat diubah.</p>
                <label>Kuota Kelas Digital</label>
                <input type="number" name="kuota_kelas_digital" id="edit_kuota" min="30" required>

                <div class="rentang-info"><i class="bi bi-calendar-check"></i><span id="rentang_info_edit"></span></div>

                <label>Tanggal Mulai</label>
                <input type="date" name="tanggal_mulai" id="edit_tgl_mulai">
                <p class="tgl-bantuan">Jika diubah, minimal hari ini, dan harus di dalam tahun ajaran.</p>
                <label>Tanggal Selesai</label>
                <input type="date" name="tanggal_selesai" id="edit_tgl_selesai">
                <p class="tgl-bantuan">Jika diubah, minimal 7 hari dari hari ini, dan harus di dalam tahun ajaran.</p>
                <p id="peringatan_tanggal_edit" style="color:#e74c3c; font-size:12px; margin-top:4px; display:none;"></p>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="document.getElementById('modalEdit').style.display='none'">Batal</button>
                    <button type="submit" class="btn-primary">Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>
 <script>
    const TAHUN_SARAN = <%- JSON.stringify(saranTahun) %>;
    const TAHUN_TERAKHIR = <%- JSON.stringify(terakhirTahun) %>;
    const TAHUN_SEKARANG = <%- JSON.stringify(sekarangTahun) %>;

    const MIN_JARAK_HARI_SELESAI = 7;

    function tahunAwalDari(teks) {
        const m = String(teks || '').match(/^(\d{4})\/(\d{4})$/);
        return m ? Number(m[1]) : null;
    }

    function getTodayStr() {
        const d = new Date();
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${y}-${m}-${day}`;
    }

    function tambahHariStr(str, n) {
        const [y, m, d] = str.split('-').map(Number);
        const dt = new Date(y, m - 1, d + n);
        return `${dt.getFullYear()}-${String(dt.getMonth() + 1).padStart(2, '0')}-${String(dt.getDate()).padStart(2, '0')}`;
    }

    function formatTanggalIndo(str) {
        const [y, m, d] = str.split('-');
        const bulan = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
        return `${parseInt(d)} ${bulan[parseInt(m) - 1]} ${y}`;
    }

    function maksTgl(a, b) {
        if (!a) return b || '';
        if (!b) return a;
        return a > b ? a : b;
    }

    function rentangTahunAjaran(ta) {
        const m = String(ta || '').match(/^(\d{4})\/(\d{4})$/);
        if (!m) return null;
        return { min: m[1] + '-01-01', max: m[2] + '-12-31' };
    }

    function validasiTanggal(mulai, selesai, mulaiLama, selesaiLama, tahunAjaran) {
        const today = getTodayStr();
        const minSelesai = tambahHariStr(today, MIN_JARAK_HARI_SELESAI);
        const mulaiBerubah = (mulai || '') !== (mulaiLama || '');
        const selesaiBerubah = (selesai || '') !== (selesaiLama || '');
        const r = rentangTahunAjaran(tahunAjaran);

        if (r) {
            const teksRentang = 'tahun ajaran ' + tahunAjaran + ' (' + formatTanggalIndo(r.min) + ' sampai ' + formatTanggalIndo(r.max) + ')';
            if (mulai && (mulai < r.min || mulai > r.max)) {
                return 'Tanggal mulai harus berada di dalam ' + teksRentang + '.';
            }
            if (selesai && (selesai < r.min || selesai > r.max)) {
                return 'Tanggal selesai harus berada di dalam ' + teksRentang + '.';
            }
        }

        if (mulai && mulaiBerubah && mulai < today) {
            return 'Tanggal mulai tidak boleh sebelum hari ini (' + formatTanggalIndo(today) + ').';
        }
        if (selesai && selesaiBerubah && selesai < minSelesai) {
            return 'Tanggal selesai minimal ' + MIN_JARAK_HARI_SELESAI + ' hari dari hari ini, yaitu ' + formatTanggalIndo(minSelesai) + ' atau setelahnya.';
        }
        if (mulai && selesai && selesai < mulai) {
            return 'Tanggal selesai tidak boleh sebelum tanggal mulai.';
        }
        return null;
    }

    function tampilPeringatan(idElemen, pesan) {
        const el = document.getElementById(idElemen);
        if (!el) return;
        if (pesan) {
            el.textContent = pesan;
            el.style.display = 'block';
        } else {
            el.style.display = 'none';
        }
    }

    function terapkanBatas(mode, tahun, elMulai, elSelesai, elInfo) {
        const today = getTodayStr();
        const minSelesaiHari = tambahHariStr(today, MIN_JARAK_HARI_SELESAI);
        const r = isTahunAjaranValid(tahun) ? rentangTahunAjaran(tahun) : null;

        let minMulai = r ? r.min : '';
        let minSelesai = r ? r.min : '';
        const batasMaks = r ? r.max : '';

        if (mode === 'tambah') {
            minMulai = maksTgl(minMulai, today);
            minSelesai = maksTgl(minSelesai, minSelesaiHari);
        }

        elMulai.min = minMulai;
        elMulai.max = batasMaks;
        elSelesai.min = minSelesai;
        elSelesai.max = batasMaks;

        [elMulai, elSelesai].forEach(function (el) {
            if (!el.value) return;
            if ((el.min && el.value < el.min) || (el.max && el.value > el.max)) el.value = '';
        });

        if (mode === 'tambah' && r && !elMulai.value && minMulai <= r.max) {
            elMulai.value = minMulai;
        }

        if (elInfo) {
            elInfo.textContent = r
                ? 'Tahun ajaran ' + tahun + ': tanggal hanya boleh dari ' + formatTanggalIndo(r.min) + ' sampai ' + formatTanggalIndo(r.max) + '. Batas pemilih tanggal menyesuaikan otomatis.'
                : 'Isi tahun ajaran dengan benar dulu, batas tanggal akan menyesuaikan otomatis.';
        }
    }

    function terapkanTambah() {
        terapkanBatas('tambah',
            document.getElementById('tahun_ajaran_tambah').value,
            document.getElementById('tambah_tgl_mulai'),
            document.getElementById('tambah_tgl_selesai'),
            document.getElementById('rentang_info_tambah'));
    }

    function terapkanEdit() {
        terapkanBatas('edit',
            document.getElementById('edit_tahun_ajaran').value,
            document.getElementById('edit_tgl_mulai'),
            document.getElementById('edit_tgl_selesai'),
            document.getElementById('rentang_info_edit'));
    }

    function bukaModalTambah() {
        document.getElementById('tambah_tgl_mulai').value = '';
        document.getElementById('tambah_tgl_selesai').value = '';
        document.getElementById('tahun_ajaran_tambah').value = TAHUN_SEKARANG;
        document.getElementById('ta_label_tambah').textContent = TAHUN_SEKARANG;
        tampilPeringatan('peringatan_tahun_tambah', null);
        tampilPeringatan('peringatan_tanggal_tambah', null);
        terapkanTambah();

        document.getElementById('modalTambah').style.display = 'flex';
    }

    function bukaModalEdit(p) {
        document.getElementById('edit_id_periode').value = p.id_periode;
        document.getElementById('edit_kuota').value = p.kuota_kelas_digital;

        document.getElementById('edit_tahun_ajaran').value = p.tahun_ajaran;
        document.getElementById('ta_label_edit').textContent = p.tahun_ajaran;
        document.getElementById('edit_tgl_mulai').value = p.tgl_mulai_str || '';
        document.getElementById('edit_tgl_selesai').value = p.tgl_selesai_str || '';

        document.getElementById('edit_tgl_mulai').dataset.awal = document.getElementById('edit_tgl_mulai').value;
        document.getElementById('edit_tgl_selesai').dataset.awal = document.getElementById('edit_tgl_selesai').value;
        tampilPeringatan('peringatan_tanggal_edit', null);
        terapkanEdit();

        document.getElementById('modalEdit').style.display = 'flex';
    }

    const REGEX_TAHUN_AJARAN = /^\d{4}\/\d{4}$/;

    function isTahunAjaranValid(val) {
        if (!REGEX_TAHUN_AJARAN.test(val)) return false;
        const [y1, y2] = val.split('/').map(Number);
        return y2 === y1 + 1;
    }

    function handleTambahSubmit(form) {
        document.getElementById('tahun_ajaran_tambah').value = TAHUN_SEKARANG;
        const tahunVal = TAHUN_SEKARANG;

        if (!isTahunAjaranValid(tahunVal)) {
            tampilPeringatan('peringatan_tahun_tambah', 'Tahun ajaran otomatis tidak valid. Muat ulang halaman lalu coba lagi.');
            return false;
        }

        const awalBaru = tahunAwalDari(tahunVal);
        const awalTerakhir = tahunAwalDari(TAHUN_TERAKHIR);

        if (awalTerakhir !== null && awalBaru <= awalTerakhir) {
            tampilPeringatan(
                'peringatan_tahun_tambah',
                'Periode tahun ajaran ' + tahunVal + ' sudah dibuat. Tahun ajaran otomatis mengikuti tahun sekarang dan tidak dapat diubah.'
            );
            return false;
        }
        tampilPeringatan('peringatan_tahun_tambah', null);

        const pesanTanggal = validasiTanggal(form.tanggal_mulai.value, form.tanggal_selesai.value, '', '', tahunVal);
        if (pesanTanggal) {
            tampilPeringatan('peringatan_tanggal_tambah', pesanTanggal);
            return false;
        }
        tampilPeringatan('peringatan_tanggal_tambah', null);

        const tanggalMulai = form.tanggal_mulai.value;
        if (tanggalMulai) {
            const today = getTodayStr();
            if (tanggalMulai > today) {
                const pesan = `Perhatian: Tanggal mulai yang Anda pilih adalah ${formatTanggalIndo(tanggalMulai)}, sedangkan hari ini masih ${formatTanggalIndo(today)}.\n\nPeriode ini baru bisa mulai diisi (siswa/operator) setelah tanggal tersebut tiba. Jika ingin mengubah tanggal mulai nanti, Anda bisa mengklik aksi Edit.\n\nLanjutkan membuka periode ini?`;
                document.getElementById('confirmModal').style.zIndex = '10000';
                return confirmDelete(form, pesan);
            }
        }
        return true;
    }

    function handleEditSubmit(form) {
        const tahunVal = form.tahun_ajaran.value.trim();
        if (!isTahunAjaranValid(tahunVal)) {
            tampilPeringatan('peringatan_tanggal_edit', 'Tahun ajaran periode tidak valid. Muat ulang halaman lalu coba lagi.');
            return false;
        }

        const pesanTanggal = validasiTanggal(
            form.tanggal_mulai.value,
            form.tanggal_selesai.value,
            form.tanggal_mulai.dataset.awal || '',
            form.tanggal_selesai.dataset.awal || '',
            tahunVal
        );
        if (pesanTanggal) {
            tampilPeringatan('peringatan_tanggal_edit', pesanTanggal);
            return false;
        }
        tampilPeringatan('peringatan_tanggal_edit', null);

        return true;
    }
</script>
</body>
</html>